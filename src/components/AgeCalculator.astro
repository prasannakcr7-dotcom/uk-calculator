---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout reside-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Date of Birth</span></div>
        <input type="date" id="birth-date-input" value="1995-06-15" style="width:100%; padding:12px 14px; border:1px solid var(--line); border-radius:10px; font-size:15px; background:#fff; color:var(--ink);" />
      </div>

      <div class="field-group" style="margin-top: 18px;">
        <div class="field-label"><span>Calculate Age As Of Date (Default: Today)</span></div>
        <input type="date" id="target-age-date" style="width:100%; padding:12px 14px; border:1px solid var(--line); border-radius:10px; font-size:15px; background:#fff; color:var(--ink);" />
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Chronological Age Results</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Total Months Lived</span>
          <strong id="total-months-lived">0 Months</strong>
        </div>
        <div class="breakdown-row">
          <span>Total Weeks Lived</span>
          <strong id="total-weeks-lived">0 Weeks</strong>
        </div>
        <div class="breakdown-row">
          <span>Total Days Lived</span>
          <strong id="total-days-lived">0 Days</strong>
        </div>
        <div class="breakdown-row">
          <span>Days Until Next Birthday</span>
          <strong id="days-to-next-birthday">0 Days</strong>
        </div>
        <div class="breakdown-row net">
          <span>Exact Chronological Age</span>
          <strong id="age-ymd-str">0 Years 0 Months 0 Days</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="alltag" />
  </div>
</div>

<script>
  function calculateAge() {
    const dobStr = (document.getElementById('birth-date-input') as HTMLInputElement).value;
    const targetStr = (document.getElementById('target-age-date') as HTMLInputElement).value;

    if (!dobStr) return;

    const dob = new Date(dobStr);
    const targetDate = targetStr ? new Date(targetStr) : new Date();

    let years = targetDate.getFullYear() - dob.getFullYear();
    let months = targetDate.getMonth() - dob.getMonth();
    let days = targetDate.getDate() - dob.getDate();

    if (days < 0) {
      months -= 1;
      const prevMonthLastDay = new Date(targetDate.getFullYear(), targetDate.getMonth(), 0).getDate();
      days += prevMonthLastDay;
    }

    if (months < 0) {
      years -= 1;
      months += 12;
    }

    const diffMs = targetDate.getTime() - dob.getTime();
    const totalDays = Math.max(0, Math.floor(diffMs / (1000 * 60 * 60 * 24)));
    const totalWeeks = Math.floor(totalDays / 7);
    const totalMonths = (years * 12) + months;

    const nextBday = new Date(targetDate.getFullYear(), dob.getMonth(), dob.getDate());
    if (nextBday < targetDate) {
      nextBday.setFullYear(targetDate.getFullYear() + 1);
    }
    const daysToBday = Math.ceil((nextBday.getTime() - targetDate.getTime()) / (1000 * 60 * 60 * 24));

    const ymdEl = document.getElementById('age-ymd-str');
    const daysEl = document.getElementById('total-days-lived');
    const monthsEl = document.getElementById('total-months-lived');
    const weeksEl = document.getElementById('total-weeks-lived');
    const bdayEl = document.getElementById('days-to-next-birthday');

    if (ymdEl) ymdEl.textContent = `${years} Years, ${months} Months, ${days} Days`;
    if (daysEl) daysEl.textContent = totalDays.toLocaleString('en-GB') + ' Days';
    if (monthsEl) monthsEl.textContent = totalMonths.toLocaleString('en-GB') + ' Months';
    if (weeksEl) weeksEl.textContent = totalWeeks.toLocaleString('en-GB') + ' Weeks';
    if (bdayEl) bdayEl.textContent = daysToBday === 0 ? '🎉 Happy Birthday Today!' : daysToBday + ' Days';
  }

  const targetInput = document.getElementById('target-age-date') as HTMLInputElement;
  if (targetInput && !targetInput.value) {
    targetInput.value = new Date().toISOString().split('T')[0];
  }

  ['birth-date-input', 'target-age-date'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', calculateAge);
    document.getElementById(id)?.addEventListener('input', calculateAge);
  });
  calculateAge();
</script>
