---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
  nation?: string;
}

const { labels, nation = 'england' } = Astro.props;
---

<div class="layout calculator-layout work-category" data-labels={JSON.stringify(labels)} data-nation={nation}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Salary & Student Loan Details'}</h2>

      <!-- Annual Salary -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.salaryLabel || 'Gross Annual Salary (£)'}</span>
          <span class="hint" id="salaryVal">£35,000</span>
        </div>
        <div class="amount-field" style="margin-top: 0; margin-bottom: 0;">
          <input type="text" value="35,000" id="salaryInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="18000" max="100000" step="1000" value="35000" id="salarySlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£18,000</span><span>£100,000</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Monthly Student Loan Repayment (Plan 2)'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£57.79/mo</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.thresholdLabel || 'Plan 2 Annual Threshold:'}</span>
        <span class="val" id="subResultValue">£27,295.00/yr</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Repayment Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Plan 2 Salary Threshold</span>
          <span class="val" id="thresholdDisplay">£27,295.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Repayable Salary Over Threshold</span>
          <span class="val" id="repayableSalaryDisplay">£7,705.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Annual Student Loan Deduction (9%)</span>
          <span class="val" id="annualRepaymentDisplay">£693.45</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Monthly Student Loan Repayment</span>
          <span class="val" id="monthlyRepaymentDisplay" style="font-weight: 700; font-size: 18px;">£57.79</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar />
    <div style="margin-top:20px; padding:15px; background:var(--soft); border-radius:10px;">
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin:0;">
        • Plan 1: <strong>£26,065</strong> (9%)<br/>
        • Plan 2: <strong>£27,295</strong> (9%)<br/>
        • Plan 4 (Scotland): <strong>£31,395</strong> (9%)<br/>
        • Plan 5: <strong>£25,000</strong> (9%)<br/>
        • Postgrad: <strong>£21,000</strong> (6%)
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const salaryInput = document.getElementById('salaryInput') as HTMLInputElement;
  const salarySlider = document.getElementById('salarySlider') as HTMLInputElement;
  const salaryVal = document.getElementById('salaryVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const thresholdDisplay = document.getElementById('thresholdDisplay') as HTMLElement;
  const repayableSalaryDisplay = document.getElementById('repayableSalaryDisplay') as HTMLElement;
  const annualRepaymentDisplay = document.getElementById('annualRepaymentDisplay') as HTMLElement;
  const monthlyRepaymentDisplay = document.getElementById('monthlyRepaymentDisplay') as HTMLElement;

  salaryInput.addEventListener('input', () => {
    const val = parseInputVal(salaryInput.value);
    salarySlider.value = String(Math.min(100000, Math.max(18000, val)));
    calculate();
  });

  salarySlider.addEventListener('input', () => {
    salaryInput.value = salarySlider.value;
    calculate();
  });

  function calculate() {
    const sal = parseInputVal(salaryInput.value);
    salaryVal.textContent = formatCurrency(sal);

    const threshold = 27295;
    const excess = Math.max(0, sal - threshold);
    const annualRepay = excess * 0.09;
    const monthly = annualRepay / 12;

    mainResultDisplay.textContent = `${formatCurrency(monthly)}/mo`;
    subResultValue.textContent = formatCurrency(threshold);
    thresholdDisplay.textContent = formatCurrency(threshold);
    repayableSalaryDisplay.textContent = formatCurrency(excess);
    annualRepaymentDisplay.textContent = formatCurrency(annualRepay);
    monthlyRepaymentDisplay.textContent = formatCurrency(monthly);
  }

  calculate();
</script>
