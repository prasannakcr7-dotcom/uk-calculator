---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout work-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Business Subsistence Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Trip Duration & Travel Type</span></div>
        <select id="subsistence-trip-type" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="5" selected>5 Hour Rate (£5.00 Max Tax-Free Rate)</option>
          <option value="10">10 Hour Rate (£10.00 Max Tax-Free Rate)</option>
          <option value="15">15 Hour Rate (Overnight / Late Rate - £25.00)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Number of Qualifying Travel Days</span></div>
        <div class="amount-field">
          <input type="number" id="subsistence-days-count" value="4" min="1" max="30" step="1" />
          <span class="cur">days</span>
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">Total Allowable Tax-Free Subsistence Allowance</div>
      <div class="result-amount"><span id="mainResultDisplay">£20.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Daily Allowance Standard Rate:</span>
        <span class="val" id="subResultValue">£5.00 / day</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Subsistence Claim Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Daily Statutory HMRC Scale Rate</span>
          <span class="val" id="dailyRateDisplay">£5.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Total Business Travel Days</span>
          <span class="val" id="travelDaysDisplay">4 Days</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Allowable Tax-Free Subsistence Claim</span>
          <span class="val" id="totalSubsistenceDisplay" style="font-weight: 700; font-size: 18px;">£20.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="trabajo" />
  </div>
</div>

<script>
  function calculateSubsistence() {
    const typeEl = document.getElementById('subsistence-trip-type') as HTMLSelectElement;
    const daysEl = document.getElementById('subsistence-days-count') as HTMLInputElement;

    if (!typeEl || !daysEl) return;

    const dailyRate = parseFloat(typeEl.value) || 5;
    const days = parseInt(daysEl.value) || 1;

    const totalClaim = dailyRate * days;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const dailyRes = document.getElementById('dailyRateDisplay');
    const daysRes = document.getElementById('travelDaysDisplay');
    const totalRes = document.getElementById('totalSubsistenceDisplay');

    if (mainRes) mainRes.textContent = '£' + totalClaim.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (subVal) subVal.textContent = '£' + dailyRate.toFixed(2) + ' / day';
    if (dailyRes) dailyRes.textContent = '£' + dailyRate.toFixed(2);
    if (daysRes) daysRes.textContent = days + ' Days';
    if (totalRes) totalRes.textContent = '£' + totalClaim.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['subsistence-trip-type', 'subsistence-days-count'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateSubsistence);
    document.getElementById(id)?.addEventListener('change', calculateSubsistence);
  });
  calculateSubsistence();
</script>
