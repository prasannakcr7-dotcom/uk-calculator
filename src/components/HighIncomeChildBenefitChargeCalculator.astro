---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'HICBC Details'}</h2>

      <!-- Adjusted Net Income -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.incomeLabel || 'Highest Earner Adjusted Net Income (£)'}</span>
          <span class="hint" id="incomeVal">£70,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="70,000" id="incomeInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="50000" max="100000" step="1000" value="70000" id="incomeSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£50,000</span><span>£100,000</span></div>
      </div>

      <!-- Number of Children -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.childrenLabel || 'Number of Children Claimed'}</span>
          <span class="hint" id="childrenVal">2 Children</span>
        </div>
        <input type="range" min="1" max="6" step="1" value="2" id="childrenSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>1 Child</span><span>6 Children</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'HICBC Tax Charge Payable'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£1,125.80/yr</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.netRetainedLabel || 'Net Child Benefit Retained After Tax:'}</span>
        <span class="val" id="subResultValue">£1,125.80/yr (£93.82/mo)</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'HICBC Taper Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Gross Annual Child Benefit Received</span>
          <span class="val" id="grossBenefitDisplay">£2,251.60</span>
        </div>
        <div class="breakdown-row section">
          <span>HICBC Taper Charge Rate</span>
          <span class="val" id="taperPctDisplay">50.0% Tax Charge</span>
        </div>
        <div class="breakdown-row section">
          <span>Annual HICBC Tax Due to HMRC</span>
          <span class="val" id="taxChargeDisplay">£1,125.80</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Child Benefit Retained</span>
          <span class="val" id="netRetainedDisplay" style="font-weight: 700; font-size: 18px;">£1,125.80</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar />
    <div style="margin-top:20px; padding:15px; background:var(--soft); border-radius:10px;">
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin:0;">
        • <strong>£60,000 Threshold:</strong> Tax charge starts at £60,000 adjusted net income.<br/>
        • <strong>1% per £200:</strong> Tax charge increases by 1% for every £200 earned above £60,000.<br/>
        • <strong>£80,000 Cap:</strong> 100% tax charge applies at £80,000 income.<br/>
        • <strong>Rates:</strong> Child 1: £26.05/wk (£1,354.60/yr); Child 2+: £17.25/wk (£897.00/yr each).
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const incomeInput = document.getElementById('incomeInput') as HTMLInputElement;
  const incomeSlider = document.getElementById('incomeSlider') as HTMLInputElement;
  const incomeVal = document.getElementById('incomeVal') as HTMLElement;
  const childrenSlider = document.getElementById('childrenSlider') as HTMLInputElement;
  const childrenVal = document.getElementById('childrenVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const grossBenefitDisplay = document.getElementById('grossBenefitDisplay') as HTMLElement;
  const taperPctDisplay = document.getElementById('taperPctDisplay') as HTMLElement;
  const taxChargeDisplay = document.getElementById('taxChargeDisplay') as HTMLElement;
  const netRetainedDisplay = document.getElementById('netRetainedDisplay') as HTMLElement;

  function calculate() {
    const income = parseInputVal(incomeInput.value);
    const numChildren = parseInt(childrenSlider.value, 10);

    // 2026/27 rates: £26.05 for 1st child, £17.25 for additional
    const weeklyGross = 26.05 + Math.max(0, numChildren - 1) * 17.25;
    const annualGross = weeklyGross * 52;

    let taperPct = 0;
    if (income > 60000) {
      taperPct = Math.min(1.0, (income - 60000) / 20000); // 1% per £200 between £60k and £80k
    }

    const taxCharge = annualGross * taperPct;
    const netRetained = annualGross - taxCharge;
    const netMonthly = netRetained / 12;

    incomeVal.innerText = formatCurrency(income).slice(0, -3);
    childrenVal.innerText = `${numChildren} Child${numChildren === 1 ? '' : 'ren'}`;

    mainResultDisplay.innerText = `${formatCurrency(taxCharge)}/yr`;
    subResultValue.innerText = `${formatCurrency(netRetained)}/yr (${formatCurrency(netMonthly)}/mo)`;

    grossBenefitDisplay.innerText = formatCurrency(annualGross);
    taperPctDisplay.innerText = `${(taperPct * 100).toFixed(1)}% Tax Charge`;
    taxChargeDisplay.innerText = formatCurrency(taxCharge);
    netRetainedDisplay.innerText = formatCurrency(netRetained);
  }

  incomeInput.addEventListener('input', () => {
    const val = parseInputVal(incomeInput.value);
    incomeSlider.value = String(val);
    calculate();
  });

  incomeSlider.addEventListener('input', () => {
    incomeInput.value = parseInt(incomeSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  childrenSlider.addEventListener('input', calculate);

  calculate();
</script>
