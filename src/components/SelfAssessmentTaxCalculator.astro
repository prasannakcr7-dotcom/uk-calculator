---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Self-Assessment Income & Expense Details'}</h2>

      <!-- Total Self-Employed / Untaxed Income -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.incomeLabel || 'Total Self-Employed / Untaxed Income (£)'}</span>
          <span class="hint" id="incomeVal">£45,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="45,000" id="incomeInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="200000" step="2500" value="45000" id="incomeSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0</span><span>£200,000</span></div>
      </div>

      <!-- Total Allowable Expenses -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.expensesLabel || 'Total Allowable Business Expenses (£)'}</span>
          <span class="hint" id="expensesVal">£8,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="8,000" id="expensesInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="100000" step="1000" value="8000" id="expensesSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0</span><span>£100,000</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Total Self-Assessment Bill Due (31 January)'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£9,531.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.poaLabel || 'Includes 1st Payment on Account (50%):'}</span>
        <span class="val" id="subResultValue">£3,177.00 POA Included</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Self-Assessment Tax & NI Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Net Taxable Profit (Income - Expenses)</span>
          <span class="val" id="netProfitDisplay">£37,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Income Tax (20% Basic Rate)</span>
          <span class="val" id="incomeTaxDisplay">£4,886.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Class 4 National Insurance (6%)</span>
          <span class="val" id="class4NiDisplay">£1,465.80</span>
        </div>
        <div class="breakdown-row section">
          <span>1st Payment on Account (50% of Tax & NI)</span>
          <span class="val" id="poaDisplay">+£3,175.90</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Cash Outflow Due on 31 January</span>
          <span class="val" id="totalBillDisplay" style="font-weight: 700; font-size: 18px;">£9,527.70</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>Filing Deadline:</strong> 31 January following end of tax year.<br/>
        • <strong>Payments on Account (POA):</strong> 2 equal advance payments (31 Jan & 31 July) if tax bill exceeds £1,000.<br/>
        • <strong>Personal Allowance:</strong> £12,570 tax-free.<br/>
        • <strong>Late Filing Penalty:</strong> Automatic £100 fine for missing 31 January deadline by 1 day.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const incomeInput = document.getElementById('incomeInput') as HTMLInputElement;
  const incomeSlider = document.getElementById('incomeSlider') as HTMLInputElement;
  const incomeVal = document.getElementById('incomeVal') as HTMLElement;
  const expensesInput = document.getElementById('expensesInput') as HTMLInputElement;
  const expensesSlider = document.getElementById('expensesSlider') as HTMLInputElement;
  const expensesVal = document.getElementById('expensesVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const netProfitDisplay = document.getElementById('netProfitDisplay') as HTMLElement;
  const incomeTaxDisplay = document.getElementById('incomeTaxDisplay') as HTMLElement;
  const class4NiDisplay = document.getElementById('class4NiDisplay') as HTMLElement;
  const poaDisplay = document.getElementById('poaDisplay') as HTMLElement;
  const totalBillDisplay = document.getElementById('totalBillDisplay') as HTMLElement;

  function calculate() {
    const income = parseInputVal(incomeInput.value);
    const expenses = parseInputVal(expensesInput.value);

    const netProfit = Math.max(0, income - expenses);

    // Personal Allowance with £100k taper
    let pa = 12570;
    if (netProfit > 100000) {
      pa = Math.max(0, 12570 - (netProfit - 100000) / 2);
    }

    // Income Tax
    let incomeTax = 0;
    if (netProfit > pa) {
      const taxable = netProfit - pa;
      if (taxable <= 37700) {
        incomeTax = taxable * 0.20;
      } else if (taxable <= 112570) {
        incomeTax = (37700 * 0.20) + ((taxable - 37700) * 0.40);
      } else {
        incomeTax = (37700 * 0.20) + ((112570 - 37700) * 0.40) + ((taxable - 112570) * 0.45);
      }
    }

    // Class 4 NI (6% between £12,570 and £50,270; 2% above)
    let class4Ni = 0;
    if (netProfit > 12570) {
      const niTaxable = netProfit - 12570;
      if (niTaxable <= 37700) {
        class4Ni = niTaxable * 0.06;
      } else {
        class4Ni = (37700 * 0.06) + ((niTaxable - 37700) * 0.02);
      }
    }

    const mainTaxBill = incomeTax + class4Ni;
    // Payment on Account applies if bill > £1,000
    const poaAmount = mainTaxBill > 1000 ? mainTaxBill * 0.50 : 0;
    const totalCashDueJan31 = mainTaxBill + poaAmount;

    incomeVal.innerText = formatCurrency(income).slice(0, -3);
    expensesVal.innerText = formatCurrency(expenses).slice(0, -3);

    mainResultDisplay.innerText = formatCurrency(totalCashDueJan31);
    subResultValue.innerText = poaAmount > 0 ? `${formatCurrency(poaAmount)} 1st POA Included` : 'No POA Required';

    netProfitDisplay.innerText = formatCurrency(netProfit);
    incomeTaxDisplay.innerText = formatCurrency(incomeTax);
    class4NiDisplay.innerText = formatCurrency(class4Ni);
    poaDisplay.innerText = poaAmount > 0 ? `+${formatCurrency(poaAmount)}` : '£0.00';
    totalBillDisplay.innerText = formatCurrency(totalCashDueJan31);
  }

  incomeInput.addEventListener('input', () => {
    const val = parseInputVal(incomeInput.value);
    incomeSlider.value = String(val);
    calculate();
  });

  incomeSlider.addEventListener('input', () => {
    incomeInput.value = parseInt(incomeSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  expensesInput.addEventListener('input', () => {
    const val = parseInputVal(expensesInput.value);
    expensesSlider.value = String(val);
    calculate();
  });

  expensesSlider.addEventListener('input', () => {
    expensesInput.value = parseInt(expensesSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  calculate();
</script>
