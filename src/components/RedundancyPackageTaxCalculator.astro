---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout work-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Redundancy Severance Pay Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Total Gross Redundancy Package Value (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="redundancy-total-package" value="45000" min="5000" step="2500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>PILON (Pay in Lieu of Notice) Included in Package (£ - Taxable)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="redundancy-pilon-amount" value="5000" min="0" step="500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Marginal Income Tax Band</span></div>
        <select id="redundancy-tax-band-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="0.20" selected>Basic Rate (20% Income Tax)</option>
          <option value="0.40">Higher Rate (40% Income Tax)</option>
          <option value="0.45">Additional Rate (45% Income Tax)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">Net Redundancy Take-Home Payout</div>
      <div class="result-amount"><span id="mainResultDisplay">£42,000.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Statutory Exemption Applied:</span>
        <span class="val" id="subResultValue">£30,000.00 Tax-Free Exemption</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Redundancy Tax Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Statutory Tax-Free Exemption (Max £30,000)</span>
          <span class="val" id="taxFreeExemptionDisplay">£30,000.00 Exempt</span>
        </div>
        <div class="breakdown-row section">
          <span>Taxable Exceeded Severance + PILON</span>
          <span class="val" id="taxableExcessDisplay">£15,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Income Tax Deducted (20%)</span>
          <span class="val" id="incomeTaxDeductionDisplay">-£3,000.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Lump Sum Cash Payout</span>
          <span class="val" id="netLumpSumPayoutDisplay" style="font-weight: 700; font-size: 18px;">£42,000.00 (93.3% Retention)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="trabajo" />
  </div>
</div>

<script>
  function calculateRedundancyTax() {
    const totalEl = document.getElementById('redundancy-total-package') as HTMLInputElement;
    const pilonEl = document.getElementById('redundancy-pilon-amount') as HTMLInputElement;
    const bandEl = document.getElementById('redundancy-tax-band-select') as HTMLSelectElement;

    if (!totalEl || !pilonEl || !bandEl) return;

    const totalPackage = parseFloat(totalEl.value) || 0;
    const pilon = parseFloat(pilonEl.value) || 0;
    const taxRate = parseFloat(bandEl.value) || 0.20;

    const severanceOnly = Math.max(0, totalPackage - pilon);
    const taxFreeExemption = Math.min(30000, severanceOnly);

    const taxableSeverance = Math.max(0, severanceOnly - taxFreeExemption);
    const totalTaxable = taxableSeverance + pilon;

    const taxDue = totalTaxable * taxRate;
    const netPayout = Math.max(0, totalPackage - taxDue);
    const retentionPct = totalPackage > 0 ? (netPayout / totalPackage) * 100 : 0;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const freeRes = document.getElementById('taxFreeExemptionDisplay');
    const excessRes = document.getElementById('taxableExcessDisplay');
    const taxRes = document.getElementById('incomeTaxDeductionDisplay');
    const netRes = document.getElementById('netLumpSumPayoutDisplay');

    if (mainRes) mainRes.textContent = '£' + netPayout.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (subVal) subVal.textContent = '£' + taxFreeExemption.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Tax-Free Exemption';
    if (freeRes) freeRes.textContent = '£' + taxFreeExemption.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Exempt';
    if (excessRes) excessRes.textContent = '£' + totalTaxable.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (taxRes) taxRes.textContent = '-£' + taxDue.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (netRes) netRes.textContent = '£' + netPayout.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` (${retentionPct.toFixed(1)}% Retention)`;
  }

  ['redundancy-total-package', 'redundancy-pilon-amount', 'redundancy-tax-band-select'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateRedundancyTax);
    document.getElementById(id)?.addEventListener('change', calculateRedundancyTax);
  });
  calculateRedundancyTax();
</script>
