---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout family-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Child Age & Allowance Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Child Age (Years)</span></div>
        <div class="amount-field">
          <input type="number" id="pocketmoney-child-age" value="11" min="4" max="18" step="1" />
          <span class="cur">yrs old</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Allowance Basis</span></div>
        <select id="pocketmoney-rule-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="age_rule" selected>UK Benchmark Guideline (£0.60 - £1.00 per year of age)</option>
          <option value="flat_rate">Fixed Allowance (£5.00/wk base)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Chore Bonus Contribution (£/week)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="pocketmoney-chore-bonus" value="2.00" min="0" step="0.50" />
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--family-1), var(--family-2) 80%);">
      <div class="result-label">Recommended Weekly Pocket Money Allowance</div>
      <div class="result-amount"><span id="mainResultDisplay">£8.60 / week</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Annual Allowance Total:</span>
        <span class="val" id="subResultValue">£447.20 / year</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Pocket Money Allowance Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Base Age-Based Allowance</span>
          <span class="val" id="baseAgeAllowanceDisplay">£6.60 / week</span>
        </div>
        <div class="breakdown-row section">
          <span>Chore Completion Bonus</span>
          <span class="val" id="choreBonusDisplay">£2.00 / week</span>
        </div>
        <div class="breakdown-row section">
          <span>Monthly Equivalent Allowance</span>
          <span class="val" id="monthlyAllowanceDisplay">£37.27 / month</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Weekly Pocket Money</span>
          <span class="val" id="totalPocketMoneyDisplay" style="font-weight: 700; font-size: 18px;">£8.60 / week (£447.20/yr)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="familia" />
  </div>
</div>

<script>
  function calculatePocketMoney() {
    const ageEl = document.getElementById('pocketmoney-child-age') as HTMLInputElement;
    const ruleEl = document.getElementById('pocketmoney-rule-select') as HTMLSelectElement;
    const choreEl = document.getElementById('pocketmoney-chore-bonus') as HTMLInputElement;

    if (!ageEl || !ruleEl || !choreEl) return;

    const age = parseInt(ageEl.value) || 11;
    const rule = ruleEl.value;
    const choreBonus = parseFloat(choreEl.value) || 0;

    let baseAllowance = age * 0.60;
    if (rule === 'flat_rate') baseAllowance = 5.00;

    const totalWeekly = baseAllowance + choreBonus;
    const annualTotal = totalWeekly * 52;
    const monthlyTotal = annualTotal / 12;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const baseRes = document.getElementById('baseAgeAllowanceDisplay');
    const choreRes = document.getElementById('choreBonusDisplay');
    const monthRes = document.getElementById('monthlyAllowanceDisplay');
    const totalRes = document.getElementById('totalPocketMoneyDisplay');

    if (mainRes) mainRes.textContent = '£' + totalWeekly.toFixed(2) + ' / week';
    if (subVal) subVal.textContent = '£' + annualTotal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (baseRes) baseRes.textContent = '£' + baseAllowance.toFixed(2) + ' / week';
    if (choreRes) choreRes.textContent = '£' + choreBonus.toFixed(2) + ' / week';
    if (monthRes) monthRes.textContent = '£' + monthlyTotal.toFixed(2) + ' / month';
    if (totalRes) totalRes.textContent = '£' + totalWeekly.toFixed(2) + ` / week (£${annualTotal.toFixed(2)}/yr)`;
  }

  ['pocketmoney-child-age', 'pocketmoney-rule-select', 'pocketmoney-chore-bonus'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculatePocketMoney);
    document.getElementById(id)?.addEventListener('change', calculatePocketMoney);
  });
  calculatePocketMoney();
</script>
