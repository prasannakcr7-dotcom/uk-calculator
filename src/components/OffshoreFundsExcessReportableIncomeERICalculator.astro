---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout taxes-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Offshore Fund ERI Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Number of Offshore Fund Shares Held on Reporting Date</span></div>
        <div class="amount-field">
          <input type="number" id="eri-shares-held" value="2500" min="1" step="100" />
          <span class="cur">shares</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Excess Reportable Income Rate Per Share (£/share)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="eri-rate-per-share" value="0.45" min="0.01" step="0.05" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Investor Tax Status / Rate</span></div>
        <select id="eri-investor-tax-rate-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="0.3575" selected>Higher Rate Dividend Tax (35.75%)</option>
          <option value="0.1075">Basic Rate Dividend Tax (10.75%)</option>
          <option value="0.3935">Additional Rate Dividend Tax (39.35%)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">Deemed Offshore Excess Reportable Income (ERI)</div>
      <div class="result-amount"><span id="mainResultDisplay">£1,125.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Estimated HMRC Tax Liability:</span>
        <span class="val" id="subResultValue">£379.69 Tax Payable</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Offshore ERI Tax Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Deemed Reportable Income (ERI)</span>
          <span class="val" id="deemedEriIncomeDisplay">£1,125.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Applicable UK Dividend Tax Rate</span>
          <span class="val" id="applicableDivTaxRateDisplay">35.75%</span>
        </div>
        <div class="breakdown-row section">
          <span>CGT Base Cost Addition Adjustment</span>
          <span class="val" id="cgtBaseCostAddDisplay">+£1,125.00 to Acquisition Cost</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Self-Assessment Income Tax Due</span>
          <span class="val" id="totalEriTaxDueDisplay" style="font-weight: 700; font-size: 18px;">£379.69</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="impuestos" />
  </div>
</div>

<script>
  function calculateEriTax() {
    const sharesEl = document.getElementById('eri-shares-held') as HTMLInputElement;
    const rateEl = document.getElementById('eri-rate-per-share') as HTMLInputElement;
    const taxRateEl = document.getElementById('eri-investor-tax-rate-select') as HTMLSelectElement;

    if (!sharesEl || !rateEl || !taxRateEl) return;

    const shares = parseFloat(sharesEl.value) || 0;
    const ratePerShare = parseFloat(rateEl.value) || 0;
    const divTaxRate = parseFloat(taxRateEl.value) || 0.3575;

    const totalEriIncome = shares * ratePerShare;
    const taxDue = totalEriIncome * divTaxRate;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const incomeRes = document.getElementById('deemedEriIncomeDisplay');
    const rateRes = document.getElementById('applicableDivTaxRateDisplay');
    const cgtRes = document.getElementById('cgtBaseCostAddDisplay');
    const taxDueRes = document.getElementById('totalEriTaxDueDisplay');

    if (mainRes) mainRes.textContent = '£' + totalEriIncome.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (subVal) subVal.textContent = '£' + taxDue.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Tax Payable';
    if (incomeRes) incomeRes.textContent = '£' + totalEriIncome.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (rateRes) rateRes.textContent = (divTaxRate * 100).toFixed(2) + '%';
    if (cgtRes) cgtRes.textContent = '+£' + totalEriIncome.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' to Acquisition Cost';
    if (taxDueRes) taxDueRes.textContent = '£' + taxDue.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['eri-shares-held', 'eri-rate-per-share', 'eri-investor-tax-rate-select'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateEriTax);
    document.getElementById(id)?.addEventListener('change', calculateEriTax);
  });
  calculateEriTax();
</script>
