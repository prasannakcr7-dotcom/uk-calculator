---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout finance-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Personal Unsecured Loan Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Loan Amount Borrowed (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="personalloan-borrow-amount" value="10000" min="1000" step="500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Representative Annual Percentage Rate (% APR)</span></div>
        <div class="amount-field">
          <input type="number" id="personalloan-apr-rate" value="6.5" min="1.0" max="35.0" step="0.5" />
          <span class="cur">%</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Loan Term (Years)</span></div>
        <div class="amount-field">
          <input type="number" id="personalloan-term-years" value="3" min="1" max="10" step="1" />
          <span class="cur">yrs</span>
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--finance-1), var(--finance-2) 80%);">
      <div class="result-label">Monthly Personal Loan Repayment</div>
      <div class="result-amount"><span id="mainResultDisplay">£305.52 / month</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Total Interest Charge Over Term:</span>
        <span class="val" id="subResultValue">£998.72 Total Interest</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Personal Loan Summary</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Principal Amount Borrowed</span>
          <span class="val" id="principalAmountDisplay">£10,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Total Interest Charge</span>
          <span class="val" id="totalInterestDisplay">£998.72</span>
        </div>
        <div class="breakdown-row section">
          <span>Monthly Repayment</span>
          <span class="val" id="monthlyRepaymentDisplay">£305.52 / month</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Repayable (Principal + Interest)</span>
          <span class="val" id="totalRepayableDisplay" style="font-weight: 700; font-size: 18px;">£10,998.72</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="finanzas" />
  </div>
</div>

<script>
  function calculatePersonalLoan() {
    const loanEl = document.getElementById('personalloan-borrow-amount') as HTMLInputElement;
    const aprEl = document.getElementById('personalloan-apr-rate') as HTMLInputElement;
    const termEl = document.getElementById('personalloan-term-years') as HTMLInputElement;

    if (!loanEl || !aprEl || !termEl) return;

    const loan = parseFloat(loanEl.value) || 0;
    const apr = (parseFloat(aprEl.value) || 0) / 100;
    const years = parseInt(termEl.value) || 3;

    const r = apr / 12;
    const n = years * 12;

    const monthly = r > 0 ? loan * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1) : loan / n;
    const totalRepayable = monthly * n;
    const totalInterest = Math.max(0, totalRepayable - loan);

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const princRes = document.getElementById('principalAmountDisplay');
    const intRes = document.getElementById('totalInterestDisplay');
    const monthRes = document.getElementById('monthlyRepaymentDisplay');
    const totalRes = document.getElementById('totalRepayableDisplay');

    if (mainRes) mainRes.textContent = '£' + monthly.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (subVal) subVal.textContent = '£' + totalInterest.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Total Interest';
    if (princRes) princRes.textContent = '£' + loan.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (intRes) intRes.textContent = '£' + totalInterest.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (monthRes) monthRes.textContent = '£' + monthly.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (totalRes) totalRes.textContent = '£' + totalRepayable.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['personalloan-borrow-amount', 'personalloan-apr-rate', 'personalloan-term-years'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculatePersonalLoan);
    document.getElementById(id)?.addEventListener('change', calculatePersonalLoan);
  });
  calculatePersonalLoan();
</script>
