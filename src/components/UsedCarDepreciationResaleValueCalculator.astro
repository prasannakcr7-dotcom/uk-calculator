---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout mobility-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Vehicle Purchase & Depreciation Details'}</h2>

      <!-- Vehicle Initial Purchase Price (£) -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.purchasePriceLabel || 'Vehicle Initial Purchase Price (£)'}</span>
          <span class="hint" id="purchasePriceVal">£25,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="25,000" id="purchasePriceInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="3000" max="100000" step="1000" value="25000" id="purchasePriceSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£3,000</span><span>£100,000</span></div>
      </div>

      <!-- Ownership Period (Years) -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.ownershipYearsLabel || 'Planned Ownership Period (Years)'}</span>
          <span class="hint" id="ownershipYearsVal">3 Years</span>
        </div>
        <input type="range" min="1" max="10" step="1" value="3" id="ownershipYearsSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>1 Year</span><span>10 Years</span></div>
      </div>

      <!-- Annual Mileage (Miles) -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.annualMileageLabel || 'Annual Mileage Driven (Miles)'}</span>
          <span class="hint" id="annualMileageVal">10,000 Miles / year</span>
        </div>
        <div class="amount-field">
          <input type="text" value="10,000" id="annualMileageInput" inputmode="decimal" />
          <span class="cur">mi</span>
        </div>
        <input type="range" min="3000" max="30000" step="1000" value="10000" id="annualMileageSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>3,000 mi</span><span>30,000 mi</span></div>
      </div>

      <!-- Vehicle Fuel / Tech Type -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.fuelTypeLabel || 'Vehicle Fuel & Depreciation Class'}</span>
          <span class="hint" id="fuelTypeVal">Petrol / Hybrid (Standard 15%/yr curve)</span>
        </div>
        <select id="fuelTypeSelect" style="width:100%; padding:10px; border-radius:8px; border:1px solid var(--line); font-size:15px; margin-top:8px;">
          <option value="PETROL_HYBRID" selected>Petrol / Hybrid Vehicle (15% annual compounding curve)</option>
          <option value="DIESEL">Diesel Vehicle (18% annual depreciation)</option>
          <option value="ELECTRIC_EV">Electric Vehicle EV (20% annual depreciation)</option>
          <option value="PREMIUM_LUXURY">Luxury / Executive Brand (17% annual depreciation)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--mobility-1), var(--mobility-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Estimated Vehicle Resale Value After Ownership'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£14,900.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.totalDepreciationLabel || 'Total Value Depreciation Lost & Cost per Mile:'}</span>
        <span class="val" id="subResultValue">£10,100.00 Total Depreciation (33.7p / Mile Lost)</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Car Depreciation Financial Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Initial Vehicle Purchase Price</span>
          <span class="val" id="purchaseDisplay">£25,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Total Accumulated Mileage (30,000 Miles)</span>
          <span class="val" id="totalMileageDisplay">30,000 Miles</span>
        </div>
        <div class="breakdown-row section">
          <span>Estimated Resale Value (Year 3)</span>
          <span class="val" id="resaleDisplay">£14,900.00 (59.6% Retained)</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Value Lost to Depreciation</span>
          <span class="val" id="totalLossDisplay" style="font-weight: 700; font-size: 18px;">£10,100.00 (£280.56 / month)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>Year 1 Depreciation Drop:</strong> Brand new cars lose 15% to 35% of value in Year 1.<br/>
        • <strong>Year 3 Value Retention:</strong> Average UK used car retains ~50% to 60% of original price at Year 3.<br/>
        • <strong>High Mileage Penalty:</strong> Exceeding 10,000 miles/yr reduces resale value by ~5p to 10p per extra mile.<br/>
        • <strong>CAP HPI Benchmarks:</strong> Industry standard CAP HPI trade and retail valuation curves.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const purchasePriceInput = document.getElementById('purchasePriceInput') as HTMLInputElement;
  const purchasePriceSlider = document.getElementById('purchasePriceSlider') as HTMLInputElement;
  const purchasePriceVal = document.getElementById('purchasePriceVal') as HTMLElement;

  const ownershipYearsSlider = document.getElementById('ownershipYearsSlider') as HTMLInputElement;
  const ownershipYearsVal = document.getElementById('ownershipYearsVal') as HTMLElement;

  const annualMileageInput = document.getElementById('annualMileageInput') as HTMLInputElement;
  const annualMileageSlider = document.getElementById('annualMileageSlider') as HTMLInputElement;
  const annualMileageVal = document.getElementById('annualMileageVal') as HTMLElement;

  const fuelTypeSelect = document.getElementById('fuelTypeSelect') as HTMLSelectElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const purchaseDisplay = document.getElementById('purchaseDisplay') as HTMLElement;
  const totalMileageDisplay = document.getElementById('totalMileageDisplay') as HTMLElement;
  const resaleDisplay = document.getElementById('resaleDisplay') as HTMLElement;
  const totalLossDisplay = document.getElementById('totalLossDisplay') as HTMLElement;

  function calculate() {
    const price = parseInputVal(purchasePriceInput.value);
    const years = parseInt(ownershipYearsSlider.value, 10);
    const annualMileage = parseInputVal(annualMileageInput.value);
    const fuelClass = fuelTypeSelect.value;

    let baseAnnualDepreciation = 0.15; // Petrol/Hybrid
    if (fuelClass === 'DIESEL') baseAnnualDepreciation = 0.18;
    if (fuelClass === 'ELECTRIC_EV') baseAnnualDepreciation = 0.20;
    if (fuelClass === 'PREMIUM_LUXURY') baseAnnualDepreciation = 0.17;

    // Compounding annual depreciation calculation
    let currentResale = price;
    for (let i = 1; i <= years; i++) {
      let annualRate = baseAnnualDepreciation;
      if (i === 1) annualRate = baseAnnualDepreciation * 1.30; // Year 1 extra drop
      currentResale = currentResale * (1 - annualRate);
    }

    // Mileage adjustment penalty (benchmark 10,000 miles/yr)
    const totalMileage = annualMileage * years;
    const excessMileage = totalMileage - (10000 * years);
    const mileageAdjustment = excessMileage * 0.08; // 8p penalty per excess mile

    const finalResale = Math.max(price * 0.10, currentResale - mileageAdjustment);
    const totalDepreciationLoss = price - finalResale;
    const retainedPercentage = price > 0 ? (finalResale / price) * 100 : 0;

    const monthlyDepreciation = totalDepreciationLoss / (years * 12);
    const costPerMilePence = totalMileage > 0 ? (totalDepreciationLoss / totalMileage) * 100 : 0;

    purchasePriceVal.innerText = formatCurrency(price).slice(0, -3);
    ownershipYearsVal.innerText = `${years} Year${years === 1 ? '' : 's'}`;
    annualMileageVal.innerText = `${annualMileage.toLocaleString('en-GB')} Miles / year`;

    mainResultDisplay.innerText = formatCurrency(finalResale);
    subResultValue.innerText = `${formatCurrency(totalDepreciationLoss)} Total Depreciation (${costPerMilePence.toFixed(1)}p / Mile Lost)`;

    purchaseDisplay.innerText = formatCurrency(price);
    totalMileageDisplay.innerText = `${totalMileage.toLocaleString('en-GB')} Miles`;
    resaleDisplay.innerText = `${formatCurrency(finalResale)} (${retainedPercentage.toFixed(1)}% Retained)`;
    totalLossDisplay.innerText = `${formatCurrency(totalDepreciationLoss)} (${formatCurrency(monthlyDepreciation)} / month)`;
  }

  purchasePriceInput.addEventListener('input', () => {
    const val = parseInputVal(purchasePriceInput.value);
    purchasePriceSlider.value = String(val);
    calculate();
  });

  purchasePriceSlider.addEventListener('input', () => {
    purchasePriceInput.value = parseInt(purchasePriceSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  ownershipYearsSlider.addEventListener('input', calculate);

  annualMileageInput.addEventListener('input', () => {
    const val = parseInputVal(annualMileageInput.value);
    annualMileageSlider.value = String(val);
    calculate();
  });

  annualMileageSlider.addEventListener('input', () => {
    annualMileageInput.value = parseInt(annualMileageSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  fuelTypeSelect.addEventListener('change', calculate);

  calculate();
</script>
