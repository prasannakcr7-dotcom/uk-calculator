---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout mobility-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Private Aircraft Charter Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Aircraft Category</span></div>
        <select id="charter-aircraft-type-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="light_jet" selected>Light Jet (4-6 Passengers - £2,200/hr)</option>
          <option value="helicopter">Twin-Engine Helicopter (4-6 Passengers - £1,800/hr)</option>
          <option value="midsize_jet">Midsize Executive Jet (8-10 Passengers - £4,500/hr)</option>
          <option value="heavy_jet">Heavy Long-Range Jet (12-16 Passengers - £7,500/hr)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Flight Duration (Flight Hours)</span></div>
        <div class="amount-field">
          <input type="number" id="charter-flight-hours" value="2.5" min="0.5" max="15" step="0.5" />
          <span class="cur">hours</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Airport Landing Fees & Handling (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="charter-landing-fees" value="850" min="200" step="50" />
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--mobility-1), var(--mobility-2) 80%);">
      <div class="result-label">Total Estimated Private Charter Cost</div>
      <div class="result-amount"><span id="mainResultDisplay">£6,350.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Hourly Charter Rate:</span>
        <span class="val" id="subResultValue">£2,200.00 / hour</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Private Aviation Charter Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Flight Hour Hourly Charge (2.5 hrs @ £2,200)</span>
          <span class="val" id="flightHoursCostDisplay">£5,500.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Airport Landing, Handling & Parking Fees</span>
          <span class="val" id="landingFeesDisplay">£850.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Passenger Air Passenger Duty (APD) & Fuel Surcharge</span>
          <span class="val" id="apdFuelSurchargeDisplay">Included</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Private Charter Outlay</span>
          <span class="val" id="totalCharterCostDisplay" style="font-weight: 700; font-size: 18px;">£6,350.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="movilidad" />
  </div>
</div>

<script>
  function calculateCharterCost() {
    const aircraftEl = document.getElementById('charter-aircraft-type-select') as HTMLSelectElement;
    const hoursEl = document.getElementById('charter-flight-hours') as HTMLInputElement;
    const landingEl = document.getElementById('charter-landing-fees') as HTMLInputElement;

    if (!aircraftEl || !hoursEl || !landingEl) return;

    const aircraft = aircraftEl.value;
    const flightHours = parseFloat(hoursEl.value) || 0;
    const landingFees = parseFloat(landingEl.value) || 0;

    let hourlyRate = 2200; // Light jet
    if (aircraft === 'helicopter') hourlyRate = 1800;
    else if (aircraft === 'midsize_jet') hourlyRate = 4500;
    else if (aircraft === 'heavy_jet') hourlyRate = 7500;

    const flightCost = flightHours * hourlyRate;
    const totalCost = flightCost + landingFees;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const flightRes = document.getElementById('flightHoursCostDisplay');
    const landingRes = document.getElementById('landingFeesDisplay');
    const totalRes = document.getElementById('totalCharterCostDisplay');

    if (mainRes) mainRes.textContent = '£' + totalCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (subVal) subVal.textContent = '£' + hourlyRate.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / hour';
    if (flightRes) flightRes.textContent = '£' + flightCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (landingRes) landingRes.textContent = '£' + landingFees.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (totalRes) totalRes.textContent = '£' + totalCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['charter-aircraft-type-select', 'charter-flight-hours', 'charter-landing-fees'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateCharterCost);
    document.getElementById(id)?.addEventListener('change', calculateCharterCost);
  });
  calculateCharterCost();
</script>
