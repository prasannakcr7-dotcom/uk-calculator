---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout finance-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>LISA Unauthorised Withdrawal Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Total Lifetime ISA Account Balance (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="lisa-withdrawal-balance" value="10000" min="500" step="500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Withdrawal Purpose</span></div>
        <select id="lisa-withdrawal-reason" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="unauthorised" selected>Unauthorised Non-Qualifying Withdrawal (25% Government Charge Applies)</option>
          <option value="qualifying">Qualifying First Home / Age 60+ / Terminal Illness (0% Penalty - £0 Charge)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--finance-1), var(--finance-2) 80%);">
      <div class="result-label">Government Withdrawal Charge Penalty</div>
      <div class="result-amount"><span id="mainResultDisplay">£2,500.00 Penalty</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Net Cash Received After Penalty:</span>
        <span class="val" id="subResultValue">£7,500.00</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Withdrawal & Penalty Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Gross Account Balance Withdrawn</span>
          <span class="val" id="grossBalanceWithdrawnDisplay">£10,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>HMRC 25% Statutory Withdrawal Charge</span>
          <span class="val" id="hmrcPenaltyAmountDisplay">-£2,500.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Net Loss of Original Own Capital</span>
          <span class="val" id="capitalLossDisplay">£500.00 (6.25% Net Loss of Own Money)</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Cash Deposited to Bank Account</span>
          <span class="val" id="netCashReceivedDisplay" style="font-weight: 700; font-size: 18px;">£7,500.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="finanzas" />
  </div>
</div>

<script>
  function calculateLisaPenalty() {
    const balEl = document.getElementById('lisa-withdrawal-balance') as HTMLInputElement;
    const reasonEl = document.getElementById('lisa-withdrawal-reason') as HTMLSelectElement;

    if (!balEl || !reasonEl) return;

    const balance = parseFloat(balEl.value) || 0;
    const isUnauthorised = reasonEl.value === 'unauthorised';

    const penaltyRate = isUnauthorised ? 0.25 : 0;
    const penalty = balance * penaltyRate;
    const netReceived = balance - penalty;

    // Capital loss calculation: If 25% bonus was £2,000 on £8,000 own deposit (£10,000 total),
    // 25% penalty is £2,500, leaving £7,500 -> £500 net loss of original £8,000 capital (6.25%).
    const estimatedOwnCapital = balance / 1.25;
    const netCapitalLoss = isUnauthorised ? Math.max(0, estimatedOwnCapital - netReceived) : 0;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const grossRes = document.getElementById('grossBalanceWithdrawnDisplay');
    const penRes = document.getElementById('hmrcPenaltyAmountDisplay');
    const lossRes = document.getElementById('capitalLossDisplay');
    const netRes = document.getElementById('netCashReceivedDisplay');

    if (mainRes) mainRes.textContent = isUnauthorised ? '£' + penalty.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Penalty' : '£0.00 (No Penalty)';
    if (subVal) subVal.textContent = '£' + netReceived.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (grossRes) grossRes.textContent = '£' + balance.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (penRes) penRes.textContent = isUnauthorised ? '-£' + penalty.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '£0.00';
    if (lossRes) lossRes.textContent = isUnauthorised ? '£' + netCapitalLoss.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (6.25% Net Loss)' : '£0.00';
    if (netRes) netRes.textContent = '£' + netReceived.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['lisa-withdrawal-balance', 'lisa-withdrawal-reason'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateLisaPenalty);
    document.getElementById(id)?.addEventListener('change', calculateLisaPenalty);
  });
  calculateLisaPenalty();
</script>
