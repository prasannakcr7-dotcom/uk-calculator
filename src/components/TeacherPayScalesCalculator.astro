---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
  nation?: string;
}

const { labels, nation = 'england' } = Astro.props;
---

<div class="layout calculator-layout work-category" data-labels={JSON.stringify(labels)} data-nation={nation}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Teacher Pay Scale Details'}</h2>

      <!-- Teacher Salary -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.teacherSalaryLabel || 'Teacher Scale Annual Salary (£)'}</span>
          <span class="hint" id="teacherSalaryVal">£36,000</span>
        </div>
        <div class="amount-field" style="margin-top: 0; margin-bottom: 0;">
          <input type="text" value="36,000" id="teacherSalaryInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="30000" max="55000" step="500" value="36000" id="teacherSalarySlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£30,000 (M1)</span><span>£55,000 (U3)</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Estimated Monthly Net Take-Home'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£2,280.00/mo</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.grossLabel || 'Gross Annual Salary:'}</span>
        <span class="val" id="subResultValue">£36,000.00/yr</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Teacher Pay Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Gross Annual Teacher Salary</span>
          <span class="val" id="grossAnnualDisplay">£36,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Gross Monthly Teacher Salary</span>
          <span class="val" id="grossMonthlyDisplay">£3,000.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Estimated Monthly Net Take-Home Pay</span>
          <span class="val" id="estimatedNetDisplay" style="font-weight: 700; font-size: 18px;">£2,280.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • Main Pay Range: <strong>M1 to M6</strong><br/>
        • Upper Pay Range: <strong>U1 to U3</strong><br/>
        • Teachers' Pension Scheme: Tiered contributions <strong>7.4%–11.7%</strong>.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const teacherSalaryInput = document.getElementById('teacherSalaryInput') as HTMLInputElement;
  const teacherSalarySlider = document.getElementById('teacherSalarySlider') as HTMLInputElement;
  const teacherSalaryVal = document.getElementById('teacherSalaryVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const grossAnnualDisplay = document.getElementById('grossAnnualDisplay') as HTMLElement;
  const grossMonthlyDisplay = document.getElementById('grossMonthlyDisplay') as HTMLElement;
  const estimatedNetDisplay = document.getElementById('estimatedNetDisplay') as HTMLElement;

  teacherSalaryInput.addEventListener('input', () => {
    const val = parseInputVal(teacherSalaryInput.value);
    teacherSalarySlider.value = String(Math.min(55000, Math.max(30000, val)));
    calculate();
  });

  teacherSalarySlider.addEventListener('input', () => {
    teacherSalaryInput.value = teacherSalarySlider.value;
    calculate();
  });

  function calculate() {
    const sal = parseInputVal(teacherSalaryInput.value);
    teacherSalaryVal.textContent = formatCurrency(sal);

    const grossMo = sal / 12;
    const netAnnual = sal * 0.76;
    const netMo = netAnnual / 12;

    mainResultDisplay.textContent = `${formatCurrency(netMo)}/mo`;
    subResultValue.textContent = `${formatCurrency(sal)}/yr`;
    grossAnnualDisplay.textContent = formatCurrency(sal);
    grossMonthlyDisplay.textContent = formatCurrency(grossMo);
    estimatedNetDisplay.textContent = formatCurrency(netMo);
  }

  calculate();
</script>
