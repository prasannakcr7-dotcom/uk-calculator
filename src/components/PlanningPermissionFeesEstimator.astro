---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Planning Permission Application Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Planning Application Category</span></div>
        <select id="planning-category-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="householder" selected>Householder Application (Extension, Outbuilding, Loft - £258)</option>
          <option value="full_new_house">Full New Single Dwelling Unit (£578 / dwelling)</option>
          <option value="outline">Outline Planning Permission (£578 per 0.1 hectare)</option>
          <option value="lawful_development">Lawful Development Certificate (£129)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>UK Nation Jurisdiction</span></div>
        <select id="planning-nation-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="england" selected>England Local Planning Authority</option>
          <option value="wales">Wales Planning Portal</option>
          <option value="scotland">Scotland ePlanning Fee Scale</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--housing-1), var(--housing-2) 80%);">
      <div class="result-label">Statutory Council Planning Application Fee</div>
      <div class="result-amount"><span id="mainResultDisplay">£258.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Processing Timeline Standard:</span>
        <span class="val" id="subResultValue">8 Weeks Target Decision</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Statutory Planning Fee Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Statutory Local Planning Authority Fee</span>
          <span class="val" id="statutoryPlanningFeeDisplay">£258.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Planning Portal Online Service Processing Charge</span>
          <span class="val" id="planningPortalFeeDisplay">£70.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Government Submission Cost</span>
          <span class="val" id="totalPlanningSubmissionCostDisplay" style="font-weight: 700; font-size: 18px;">£328.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="vivienda" />
  </div>
</div>

<script>
  function calculatePlanningFee() {
    const catEl = document.getElementById('planning-category-select') as HTMLSelectElement;
    const nationEl = document.getElementById('planning-nation-select') as HTMLSelectElement;

    if (!catEl || !nationEl) return;

    const category = catEl.value;
    const nation = nationEl.value;

    let baseFee = 258;
    if (category === 'full_new_house' || category === 'outline') baseFee = 578;
    else if (category === 'lawful_development') baseFee = 129;

    if (nation === 'scotland') {
      if (category === 'householder') baseFee = 300;
      else if (category === 'full_new_house') baseFee = 600;
    } else if (nation === 'wales') {
      if (category === 'householder') baseFee = 230;
      else if (category === 'full_new_house') baseFee = 460;
    }

    const portalFee = 70.00;
    const total = baseFee + portalFee;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const statRes = document.getElementById('statutoryPlanningFeeDisplay');
    const portRes = document.getElementById('planningPortalFeeDisplay');
    const totalRes = document.getElementById('totalPlanningSubmissionCostDisplay');

    if (mainRes) mainRes.textContent = '£' + baseFee.toFixed(2);
    if (subVal) subVal.textContent = '8 Weeks Target Decision';
    if (statRes) statRes.textContent = '£' + baseFee.toFixed(2);
    if (portRes) portRes.textContent = '£' + portalFee.toFixed(2);
    if (totalRes) totalRes.textContent = '£' + total.toFixed(2);
  }

  ['planning-category-select', 'planning-nation-select'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculatePlanningFee);
    document.getElementById(id)?.addEventListener('change', calculatePlanningFee);
  });
  calculatePlanningFee();
</script>
