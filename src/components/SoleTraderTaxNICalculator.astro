---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Sole Trader Self-Employed Details'}</h2>

      <!-- Annual Self-Employed Income -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.revenueLabel || 'Gross Annual Business Revenue (£)'}</span>
          <span class="hint" id="revenueVal">£50,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="50,000" id="revenueInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="200000" step="2500" value="50000" id="revenueSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0</span><span>£200,000</span></div>
      </div>

      <!-- Allowable Expenses -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.expensesLabel || 'Allowable Business Expenses (£)'}</span>
          <span class="hint" id="expensesVal">£10,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="10,000" id="expensesInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="100000" step="1000" value="10000" id="expensesSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0</span><span>£100,000</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Estimated Net Annual Take-Home Profit'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£32,327.40/yr</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.totalTaxNiLabel || 'Total Income Tax & Class 4 NI Due:'}</span>
        <span class="val" id="subResultValue">£7,672.60 Total Tax</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Sole Trader Tax Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Net Trading Profit (Revenue - Expenses)</span>
          <span class="val" id="netProfitDisplay">£40,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Income Tax (20% Basic Rate)</span>
          <span class="val" id="incomeTaxDisplay">-£5,486.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Class 4 National Insurance (6%)</span>
          <span class="val" id="class4NiDisplay">-£1,645.80</span>
        </div>
        <div class="breakdown-row section">
          <span>Class 2 National Insurance (Abolished)</span>
          <span class="val">£0.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Take-Home Profit After Tax</span>
          <span class="val" id="netTakeHomeDisplay" style="font-weight: 700; font-size: 18px;">£32,868.20</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>Trading Allowance:</strong> £1,000 tax-free trading allowance if expenses are low.<br/>
        • <strong>Personal Allowance:</strong> £12,570 (0% Income Tax).<br/>
        • <strong>Income Tax:</strong> 20% on £12,571–£50,270; 40% on £50,271–£125,140.<br/>
        • <strong>Class 4 NI:</strong> 6% between £12,570 and £50,270; 2% above £50,270.<br/>
        • <strong>Class 2 NI:</strong> Class 2 compulsory payments abolished.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const revenueInput = document.getElementById('revenueInput') as HTMLInputElement;
  const revenueSlider = document.getElementById('revenueSlider') as HTMLInputElement;
  const revenueVal = document.getElementById('revenueVal') as HTMLElement;
  const expensesInput = document.getElementById('expensesInput') as HTMLInputElement;
  const expensesSlider = document.getElementById('expensesSlider') as HTMLInputElement;
  const expensesVal = document.getElementById('expensesVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const netProfitDisplay = document.getElementById('netProfitDisplay') as HTMLElement;
  const incomeTaxDisplay = document.getElementById('incomeTaxDisplay') as HTMLElement;
  const class4NiDisplay = document.getElementById('class4NiDisplay') as HTMLElement;
  const netTakeHomeDisplay = document.getElementById('netTakeHomeDisplay') as HTMLElement;

  function calculate() {
    const revenue = parseInputVal(revenueInput.value);
    const expenses = parseInputVal(expensesInput.value);

    // Use actual expenses or £1k trading allowance if beneficial
    const effectiveExpenses = Math.max(expenses, expenses === 0 ? 1000 : expenses);
    const netProfit = Math.max(0, revenue - expenses);

    // Personal Allowance with £100k taper
    let pa = 12570;
    if (netProfit > 100000) {
      pa = Math.max(0, 12570 - (netProfit - 100000) / 2);
    }

    // Income Tax Calculation
    let incomeTax = 0;
    if (netProfit > pa) {
      const taxable = netProfit - pa;
      if (taxable <= 37700) {
        incomeTax = taxable * 0.20;
      } else if (taxable <= 112570) {
        incomeTax = (37700 * 0.20) + ((taxable - 37700) * 0.40);
      } else {
        incomeTax = (37700 * 0.20) + ((112570 - 37700) * 0.40) + ((taxable - 112570) * 0.45);
      }
    }

    // Class 4 National Insurance (6% between £12,570 and £50,270; 2% above £50,270)
    let class4Ni = 0;
    if (netProfit > 12570) {
      const niTaxable = netProfit - 12570;
      if (niTaxable <= 37700) {
        class4Ni = niTaxable * 0.06;
      } else {
        class4Ni = (37700 * 0.06) + ((niTaxable - 37700) * 0.02);
      }
    }

    const totalTaxNi = incomeTax + class4Ni;
    const netTakeHome = netProfit - totalTaxNi;

    revenueVal.innerText = formatCurrency(revenue).slice(0, -3);
    expensesVal.innerText = formatCurrency(expenses).slice(0, -3);

    mainResultDisplay.innerText = `${formatCurrency(netTakeHome)}/yr`;
    subResultValue.innerText = `${formatCurrency(totalTaxNi)} Total Tax`;

    netProfitDisplay.innerText = formatCurrency(netProfit);
    incomeTaxDisplay.innerText = incomeTax > 0 ? `-${formatCurrency(incomeTax)}` : '£0.00';
    class4NiDisplay.innerText = class4Ni > 0 ? `-${formatCurrency(class4Ni)}` : '£0.00';
    netTakeHomeDisplay.innerText = formatCurrency(netTakeHome);
  }

  revenueInput.addEventListener('input', () => {
    const val = parseInputVal(revenueInput.value);
    revenueSlider.value = String(val);
    calculate();
  });

  revenueSlider.addEventListener('input', () => {
    revenueInput.value = parseInt(revenueSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  expensesInput.addEventListener('input', () => {
    const val = parseInputVal(expensesInput.value);
    expensesSlider.value = String(val);
    calculate();
  });

  expensesSlider.addEventListener('input', () => {
    expensesInput.value = parseInt(expensesSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  calculate();
</script>
