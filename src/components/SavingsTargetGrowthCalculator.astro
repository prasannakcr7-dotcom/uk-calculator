---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---
<div class="layout calculator-layout work-category">
  <div class="main-col">
    <div class="card">
    

    <div class="field-group">
      <div class="field-label"><span>Target Financial Goal (£)</span></div>
      <div class="amount-field"><input type="number" id="target-amount" value="25000" min="500" step="500" /></div>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Current Starting Balance (£)</span></div>
      <div class="amount-field"><input type="number" id="starting-balance" value="2500" min="0" step="100" /></div>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Time Frame to Achieve Goal (Years)</span></div>
      <div class="amount-field"><input type="number" id="target-years" value="5" min="1" max="40" step="1" /></div>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Expected Savings Interest Rate (AER %)</span></div>
      <div class="amount-field"><input type="number" id="savings-interest-rate" value="4.5" min="0" max="20" step="0.1" /></div>
    </div>

    

    <div class="card breakdown-card" id="results-card" style="display: none;">
      <h3>Savings Target Plan</h3>
      <div class="breakdown-row net">
        <span>Required Monthly Deposit:</span>
        <strong id="required-monthly">£0.00</strong>
      </div>
      <div class="breakdown-row">
        <span>Total Extra Money You Must Save:</span>
        <strong id="total-saved-user">£0.00</strong>
      </div>
      <div class="breakdown-row">
        <span>Interest Earned Towards Goal:</span>
        <strong id="interest-earned-target">£0.00</strong>
      </div>
      <div class="breakdown-row">
        <span>Starting Balance Contribution:</span>
        <strong id="starting-contrib">£0.00</strong>
      
  </div>
</div>

<script>
  function calculateSavingsTarget() {
    const target = parseFloat((document.getElementById('target-amount') as HTMLInputElement).value) || 0;
    const start = parseFloat((document.getElementById('starting-balance') as HTMLInputElement).value) || 0;
    const years = parseInt((document.getElementById('target-years') as HTMLInputElement).value) || 1;
    const aer = (parseFloat((document.getElementById('savings-interest-rate') as HTMLInputElement).value) || 0) / 100;

    const months = years * 12;
    const monthlyRate = aer / 12;

    // Future value of starting balance after N months
    const startFv = start * Math.pow(1 + monthlyRate, months);
    const remainingTarget = target - startFv;

    let monthlyRequired = 0;
    if (remainingTarget > 0) {
      if (monthlyRate > 0) {
        monthlyRequired = remainingTarget / (((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate));
      } else {
        monthlyRequired = remainingTarget / months;
      }
    } else {
      monthlyRequired = 0;
    }

    const totalSavedByUser = Math.max(0, monthlyRequired * months);
    const totalOutofPocket = start + totalSavedByUser;
    const totalInterestEarned = target - totalOutofPocket;

    (document.getElementById('required-monthly') as HTMLElement).textContent = '£' + monthlyRequired.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    (document.getElementById('total-saved-user') as HTMLElement).textContent = '£' + totalSavedByUser.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    (document.getElementById('interest-earned-target') as HTMLElement).textContent = '£' + Math.max(0, totalInterestEarned).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    (document.getElementById('starting-contrib') as HTMLElement).textContent = '£' + start.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    (document.getElementById('results-card') as HTMLElement).style.display = 'block';
  }

  document.getElementById('calc-btn')?.addEventListener('click', calculateSavingsTarget);
  calculateSavingsTarget();
</script>


    
    <slot />
  </div>
  <div class="side-col">
    <Sidebar />
  </div>
</div>
