---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---
<div class="layout calculator-layout work-category">
  <div class="main-col">
    <div class="card">
    <h2 class="calc-title">Global Time Zone Converter & Meeting Planner (2026/27)</h2>
    <p class="calc-desc">Convert time between London (GMT/BST), New York (EST/EDT), Tokyo (JST), Sydney (AEST), Dubai (GST), and global financial centers.</p>

    <div class="field-group">
      <div class="field-label"><span>Source Time Zone / City</span></div>
      <select id="base-timezone">
        <option value="0" selected>London / UK (GMT / BST - UTC+0/+1)</option>
        <option value="-5">New York / Eastern Time (EST / EDT - UTC-5/-4)</option>
        <option value="-8">Los Angeles / Pacific Time (PST / PDT - UTC-8/-7)</option>
        <option value="4">Dubai / Gulf Standard Time (GST - UTC+4)</option>
        <option value="8">Singapore / Hong Kong (SGT / HKT - UTC+8)</option>
        <option value="9">Tokyo / Japan Standard Time (JST - UTC+9)</option>
        <option value="10">Sydney / Australia Eastern (AEST / AEDT - UTC+10/+11)</option>
      </select>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Source Local Time (HH:MM e.g. 14:00)</span></div>
      <input type="time" id="source-time-input" value="14:00" />
    </div>

    <div class="field-group">
      <div class="field-label"><span>Target Time Zone / City</span></div>
      <select id="target-timezone">
        <option value="-5" selected>New York / Eastern Time (EST / EDT - UTC-5/-4)</option>
        <option value="0">London / UK (GMT / BST - UTC+0/+1)</option>
        <option value="-8">Los Angeles / Pacific Time (PST / PDT - UTC-8/-7)</option>
        <option value="4">Dubai / Gulf Standard Time (GST - UTC+4)</option>
        <option value="8">Singapore / Hong Kong (SGT / HKT - UTC+8)</option>
        <option value="9">Tokyo / Japan Standard Time (JST - UTC+9)</option>
        <option value="10">Sydney / Australia Eastern (AEST / AEDT - UTC+10/+11)</option>
      </select>
    </div>

    

    <div class="card breakdown-card" id="results-card" style="display: none;">
      <h3>Converted Time Zone Results</h3>
      <div class="breakdown-row net">
        <span>Target Local Time:</span>
        <strong id="target-converted-time">Loading...</strong>
      </div>
      <div class="breakdown-row net">
        <span>Time Offset Difference:</span>
        <strong id="tz-offset-str">0 Hours</strong>
      </div>
      <div class="breakdown-row">
        <span>Source Input Time:</span>
        <strong id="source-time-display">14:00</strong>
      </div>
      <div class="breakdown-row">
        <span>Business Hours Overlap Status:</span>
        <strong id="business-overlap-status">Suitable for Business Call</strong>
      
  </div>
</div>

<script>
  function calculateTimeZone() {
    const baseOffset = parseFloat((document.getElementById('base-timezone') as HTMLSelectElement).value) || 0;
    const timeStr = (document.getElementById('source-time-input') as HTMLInputElement).value || '14:00';
    const targetOffset = parseFloat((document.getElementById('target-timezone') as HTMLSelectElement).value) || 0;

    const diffHours = targetOffset - baseOffset;
    const [srcH, srcM] = timeStr.split(':').map(Number);

    const totalMinutes = (srcH * 60) + (srcM || 0) + (diffHours * 60);

    let dayShift = Math.floor(totalMinutes / (24 * 60));
    let normMinutes = totalMinutes % (24 * 60);
    if (normMinutes < 0) {
      normMinutes += (24 * 60);
      dayShift -= 1;
    }

    const targetH = Math.floor(normMinutes / 60);
    const targetM = Math.floor(normMinutes % 60);

    const formattedTargetTime = targetH.toString().padStart(2, '0') + ':' + targetM.toString().padStart(2, '0');

    let dayShiftText = '';
    if (dayShift === 1) dayShiftText = ' (Next Day +1)';
    if (dayShift > 1) dayShiftText = ' (+' + dayShift + ' Days)';
    if (dayShift === -1) dayShiftText = ' (Previous Day -1)';

    const diffStr = diffHours >= 0 ? '+' + diffHours + ' Hours Ahead' : diffHours + ' Hours Behind';

    // Business overlap check (9:00 to 17:00 target local time)
    const isBusinessHours = targetH >= 9 && targetH < 17;
    const overlapStr = isBusinessHours 
      ? '✅ Within Normal Business Hours (9:00 - 17:00)' 
      : '⚠️ Outside Standard Business Hours';

    (document.getElementById('target-converted-time') as HTMLElement).textContent = formattedTargetTime + dayShiftText;
    (document.getElementById('tz-offset-str') as HTMLElement).textContent = diffStr;
    (document.getElementById('source-time-display') as HTMLElement).textContent = timeStr + ' Local';
    (document.getElementById('business-overlap-status') as HTMLElement).textContent = overlapStr;

    (document.getElementById('results-card') as HTMLElement).style.display = 'block';
  }

  document.getElementById('calc-btn')?.addEventListener('click', calculateTimeZone);
  calculateTimeZone();
</script>


    
    <slot />
  </div>
  <div class="side-col">
    <Sidebar />
  </div>
</div>
