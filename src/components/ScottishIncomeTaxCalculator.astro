---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout taxes-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Scottish Income Tax Details (S-Prefix Code)</h2>
      <div class="field-group">
        <div class="field-label"><span>Annual Gross Salary (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="scot-gross-salary" value="48000" min="5000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Scottish Tax Code (Default: S1257L)</span></div>
        <input type="text" id="scot-tax-code-input" value="S1257L" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);" />
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">Total Annual Scottish Income Tax Due</div>
      <div class="result-amount"><span id="mainResultDisplay">£7,654.80 / year</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Difference vs Rest of UK (rUK):</span>
        <span class="val" id="subResultValue">+£566.80 Tax in Scotland</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Scottish Tax Band Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Starter Rate (19% on £12,570 - £16,537)</span>
          <span class="val" id="starterRateTaxDisplay">£753.73</span>
        </div>
        <div class="breakdown-row section">
          <span>Basic Rate (20% on £16,537 - £29,526)</span>
          <span class="val" id="basicRateTaxDisplay">£2,597.80</span>
        </div>
        <div class="breakdown-row section">
          <span>Intermediate Rate (21% on £29,526 - £43,662)</span>
          <span class="val" id="intermediateRateTaxDisplay">£2,968.56</span>
        </div>
        <div class="breakdown-row section">
          <span>Higher Rate (42% on £43,662 - £48,000)</span>
          <span class="val" id="higherRateTaxDisplay">£1,821.96</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Scottish Income Tax Liability</span>
          <span class="val" id="totalScottishTaxDisplay" style="font-weight: 700; font-size: 18px;">£7,654.80 / year (£637.90/mo)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="impuestos" />
  </div>
</div>

<script>
  function calculateScottishIncomeTax() {
    const salaryEl = document.getElementById('scot-gross-salary') as HTMLInputElement;
    if (!salaryEl) return;

    const gross = parseFloat(salaryEl.value) || 0;
    const pa = 12570;
    const taxable = Math.max(0, gross - pa);

    // 2026/27 Scottish Tax Bands:
    // Starter: 19% (£12,571 - £16,537) -> £3,967 band
    // Basic: 20% (£16,538 - £29,526) -> £12,989 band
    // Intermediate: 21% (£29,527 - £43,662) -> £14,136 band
    // Higher: 42% (£43,663 - £75,000)
    // Advanced: 45% (£75,001 - £125,140)
    // Top: 48% (over £125,140)
    let starterTax = 0, basicTax = 0, interTax = 0, higherTax = 0, advTax = 0, topTax = 0;

    let rem = taxable;

    if (rem > 0) {
      const b1 = Math.min(rem, 3967);
      starterTax = b1 * 0.19;
      rem -= b1;
    }
    if (rem > 0) {
      const b2 = Math.min(rem, 12989);
      basicTax = b2 * 0.20;
      rem -= b2;
    }
    if (rem > 0) {
      const b3 = Math.min(rem, 14136);
      interTax = b3 * 0.21;
      rem -= b3;
    }
    if (rem > 0) {
      const b4 = Math.min(rem, 31338);
      higherTax = b4 * 0.42;
      rem -= b4;
    }
    if (rem > 0) {
      const b5 = Math.min(rem, 50140);
      advTax = b5 * 0.45;
      rem -= b5;
    }
    if (rem > 0) {
      topTax = rem * 0.48;
    }

    const totalScottishTax = starterTax + basicTax + interTax + higherTax + advTax + topTax;
    const monthlyTax = totalScottishTax / 12;

    // Compare vs rUK
    let rukTax = 0;
    if (taxable > 37700) rukTax = (37700 * 0.20) + ((taxable - 37700) * 0.40);
    else rukTax = taxable * 0.20;

    const diff = totalScottishTax - rukTax;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const sRes = document.getElementById('starterRateTaxDisplay');
    const bRes = document.getElementById('basicRateTaxDisplay');
    const iRes = document.getElementById('intermediateRateTaxDisplay');
    const hRes = document.getElementById('higherRateTaxDisplay');
    const totalRes = document.getElementById('totalScottishTaxDisplay');

    if (mainRes) mainRes.textContent = '£' + totalScottishTax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (subVal) subVal.textContent = diff >= 0 ? '+£' + diff.toFixed(2) + ' Tax in Scotland' : '-£' + Math.abs(diff).toFixed(2) + ' Tax in Scotland';
    if (sRes) sRes.textContent = '£' + starterTax.toFixed(2);
    if (bRes) bRes.textContent = '£' + basicTax.toFixed(2);
    if (iRes) iRes.textContent = '£' + interTax.toFixed(2);
    if (hRes) hRes.textContent = '£' + higherTax.toFixed(2);
    if (totalRes) totalRes.textContent = '£' + totalScottishTax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` / year (£${monthlyTax.toFixed(2)}/mo)`;
  }

  const inputEl = document.getElementById('scot-gross-salary');
  inputEl?.addEventListener('input', calculateScottishIncomeTax);
  inputEl?.addEventListener('change', calculateScottishIncomeTax);
  calculateScottishIncomeTax();
</script>
