---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Commercial Demise Floor Area (sq ft)</span></div>
        <div class="amount-field">
          <input type="number" id="demise-sqft-area" value="2500" min="100" step="100" />
          <span class="cur">sq ft</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Total Building / Estate Floor Area (sq ft)</span></div>
        <div class="amount-field">
          <input type="number" id="total-estate-sqft-area" value="50000" min="1000" step="1000" />
          <span class="cur">sq ft</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Total Annual Building Service Charge Budget (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="annual-service-charge-budget" value="180000" min="5000" step="5000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Annual Rent per Sq Ft (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="rent-per-sqft" value="35" min="5" step="1" />
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Commercial Rent & Service Charge Allocation</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Proportional Service Charge Apportionment</span>
          <strong id="apportionment-pct-val">5.00%</strong>
        </div>
        <div class="breakdown-row">
          <span>Service Charge Rate per Sq Ft</span>
          <strong id="service-charge-per-sqft">£3.60 / sq ft</strong>
        </div>
        <div class="breakdown-row">
          <span>Annual Rent Outlay</span>
          <strong id="annual-base-rent">£87,500.00</strong>
        </div>
        <div class="breakdown-row">
          <span>Annual Service Charge Outlay</span>
          <strong id="tenant-annual-service-charge">£9,000.00</strong>
        </div>
        <div class="breakdown-row net">
          <span>Total Combined Annual Property Cost</span>
          <strong id="total-combined-property-cost">£96,500.00 / year</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="vivienda" />
  </div>
</div>

<script>
  function calculateCommercialServiceCharge() {
    const demiseSqftEl = document.getElementById('demise-sqft-area') as HTMLInputElement;
    const estateSqftEl = document.getElementById('total-estate-sqft-area') as HTMLInputElement;
    const budgetEl = document.getElementById('annual-service-charge-budget') as HTMLInputElement;
    const rentSqftEl = document.getElementById('rent-per-sqft') as HTMLInputElement;

    if (!demiseSqftEl || !estateSqftEl || !budgetEl || !rentSqftEl) return;

    const demiseSqft = parseFloat(demiseSqftEl.value) || 0;
    const estateSqft = parseFloat(estateSqftEl.value) || 1;
    const budget = parseFloat(budgetEl.value) || 0;
    const rentSqft = parseFloat(rentSqftEl.value) || 0;

    const pct = estateSqft > 0 ? (demiseSqft / estateSqft) * 100 : 0;
    const tenantServiceCharge = budget * (pct / 100);
    const serviceChargePerSqft = demiseSqft > 0 ? tenantServiceCharge / demiseSqft : 0;
    const baseRent = demiseSqft * rentSqft;
    const combinedTotal = baseRent + tenantServiceCharge;

    const pctEl = document.getElementById('apportionment-pct-val');
    const scPerSqftEl = document.getElementById('service-charge-per-sqft');
    const baseRentEl = document.getElementById('annual-base-rent');
    const tenantScEl = document.getElementById('tenant-annual-service-charge');
    const totalEl = document.getElementById('total-combined-property-cost');

    if (pctEl) pctEl.textContent = pct.toFixed(2) + '%';
    if (scPerSqftEl) scPerSqftEl.textContent = '£' + serviceChargePerSqft.toFixed(2) + ' / sq ft';
    if (baseRentEl) baseRentEl.textContent = '£' + baseRent.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (tenantScEl) tenantScEl.textContent = '£' + tenantServiceCharge.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (totalEl) totalEl.textContent = '£' + combinedTotal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
  }

  ['demise-sqft-area', 'total-estate-sqft-area', 'annual-service-charge-budget', 'rent-per-sqft'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateCommercialServiceCharge);
    document.getElementById(id)?.addEventListener('change', calculateCommercialServiceCharge);
  });
  calculateCommercialServiceCharge();
</script>
