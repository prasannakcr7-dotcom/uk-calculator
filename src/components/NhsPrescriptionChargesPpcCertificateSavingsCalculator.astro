---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout health-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Prescription Frequency & PPC Details</h2>
      <div class="field-group">
        <div class="field-label"><span>UK Nation / Jurisdiction</span></div>
        <select id="ppc-nation-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="england" selected>England (£9.90 Per Prescription Item)</option>
          <option value="free_nations">Scotland, Wales & Northern Ireland (100% Free Prescriptions - £0 Fee)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Number of Prescription Items Needed Per Month</span></div>
        <div class="amount-field">
          <input type="number" id="ppc-items-per-month" value="3" min="1" max="15" step="1" />
          <span class="cur">items/mo</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>PPC Certificate Type</span></div>
        <select id="ppc-certificate-type-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="12_month" selected>12-Month PPC Certificate (£114.50 / year or £11.45/mo Direct Debit)</option>
          <option value="3_month">3-Month PPC Certificate (£32.05)</option>
          <option value="hrt_ppc">HRT-Only PPC Certificate (£19.80 / year)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--health-1), var(--health-2) 80%);">
      <div class="result-label">Net PPC Certificate Annual Savings</div>
      <div class="result-amount"><span id="mainResultDisplay">£241.90 Saved / year</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Individual Item Charges Total:</span>
        <span class="val" id="subResultValue">£356.40 / year (36 Items)</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Prescription PPC Cost Comparison</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Standard Pay-Per-Item Cost (£9.90 x 36 items)</span>
          <span class="val" id="payPerItemTotalDisplay">£356.40 / year</span>
        </div>
        <div class="breakdown-row section">
          <span>12-Month PPC Certificate Fixed Cost</span>
          <span class="val" id="ppcCertificateCostDisplay">£114.50 / year</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Financial Savings from PPC Certificate</span>
          <span class="val" id="netPpcSavingsDisplay" style="font-weight: 700; font-size: 18px;">£241.90 / year</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="salud" />
  </div>
</div>

<script>
  function calculatePpcSavings() {
    const nationEl = document.getElementById('ppc-nation-select') as HTMLSelectElement;
    const itemsEl = document.getElementById('ppc-items-per-month') as HTMLInputElement;
    const certEl = document.getElementById('ppc-certificate-type-select') as HTMLSelectElement;

    if (!nationEl || !itemsEl || !certEl) return;

    const isEngland = nationEl.value === 'england';
    const itemsPerMonth = parseInt(itemsEl.value) || 1;
    const certType = certEl.value;

    const singleItemFee = isEngland ? 9.90 : 0;
    const annualItems = itemsPerMonth * 12;
    const payPerItemTotal = annualItems * singleItemFee;

    let certCost = 114.50; // 12-month PPC 2026/27
    if (certType === '3_month') certCost = 32.05 * 4; // Normalized annual equivalent
    else if (certType === 'hrt_ppc') certCost = 19.80;

    const netSavings = isEngland ? Math.max(0, payPerItemTotal - certCost) : 0;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const payPerItemRes = document.getElementById('payPerItemTotalDisplay');
    const certCostRes = document.getElementById('ppcCertificateCostDisplay');
    const netRes = document.getElementById('netPpcSavingsDisplay');

    if (mainRes) mainRes.textContent = isEngland ? '£' + netSavings.toFixed(2) + ' Saved / year' : '100% Free Prescriptions';
    if (subVal) subVal.textContent = isEngland ? '£' + payPerItemTotal.toFixed(2) + ` / year (${annualItems} items)` : '£0.00 Charge in Scotland/Wales/NI';
    if (payPerItemRes) payPerItemRes.textContent = '£' + payPerItemTotal.toFixed(2) + ' / year';
    if (certCostRes) certCostRes.textContent = '£' + certCost.toFixed(2) + ' / year';
    if (netRes) netRes.textContent = isEngland ? '£' + netSavings.toFixed(2) + ' Saved / year' : '£0.00 (Prescriptions are Free)';
  }

  ['ppc-nation-select', 'ppc-items-per-month', 'ppc-certificate-type-select'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculatePpcSavings);
    document.getElementById(id)?.addEventListener('change', calculatePpcSavings);
  });
  calculatePpcSavings();
</script>
