---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---
<div class="layout calculator-layout work-category">
  <div class="main-col">
    <div class="card">
    

    <div class="field-group">
      <div class="field-label"><span>Food & Drink Bill Subtotal (£)</span></div>
      <div class="amount-field"><input type="number" id="food-bill-subtotal" value="120" min="1" step="5" /></div>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Tip / Discretionary Service Charge (%)</span></div>
      <select id="tip-percentage">
        <option value="10">10% Standard UK Tip</option>
        <option value="12.5" selected>12.5% Standard London / City Service Charge</option>
        <option value="15">15% Exceptional Service Tip</option>
        <option value="0">0% Custom / No Tip</option>
      </select>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Number of Diners / People Splitting</span></div>
      <div class="amount-field"><input type="number" id="number-of-diners" value="4" min="1" max="50" step="1" /></div>
    </div>

    

    <div class="card breakdown-card" id="results-card" style="display: none;">
      <h3>Bill & Tip Calculation Breakdown</h3>
      <div class="breakdown-row net">
        <span>Grand Total Bill Amount:</span>
        <strong id="grand-total-bill">£0.00</strong>
      </div>
      <div class="breakdown-row net">
        <span>Amount Owed Per Person:</span>
        <strong id="per-person-cost">£0.00 / person</strong>
      </div>
      <div class="breakdown-row">
        <span>Total Tip / Service Charge Amount:</span>
        <strong id="total-tip-val">£0.00</strong>
      </div>
      <div class="breakdown-row">
        <span>Tip Share Paid Per Person:</span>
        <strong id="per-person-tip">£0.00 / person</strong>
      </div>
      <div class="breakdown-row">
        <span>Employment (Allocation of Tips) Act Rights:</span>
        <strong id="tips-act-rights">100% Retained by Staff</strong>
      
  </div>
</div>

<script>
  function calculateTipping() {
    const subtotal = parseFloat((document.getElementById('food-bill-subtotal') as HTMLInputElement).value) || 0;
    const tipPct = parseFloat((document.getElementById('tip-percentage') as HTMLSelectElement).value) || 0;
    const diners = parseInt((document.getElementById('number-of-diners') as HTMLInputElement).value) || 1;

    const tipVal = subtotal * (tipPct / 100);
    const grandTotal = subtotal + tipVal;

    const perPersonTotal = grandTotal / diners;
    const perPersonTip = tipVal / diners;

    (document.getElementById('grand-total-bill') as HTMLElement).textContent = '£' + grandTotal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    (document.getElementById('per-person-cost') as HTMLElement).textContent = '£' + perPersonTotal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / person';
    (document.getElementById('total-tip-val') as HTMLElement).textContent = '£' + tipVal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    (document.getElementById('per-person-tip') as HTMLElement).textContent = '£' + perPersonTip.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / person';
    (document.getElementById('tips-act-rights') as HTMLElement).textContent = '100% Statutory Allocation to Hospitality Workers';

    (document.getElementById('results-card') as HTMLElement).style.display = 'block';
  }

  document.getElementById('calc-btn')?.addEventListener('click', calculateTipping);
  calculateTipping();
</script>


    
    <slot />
  </div>
  <div class="side-col">
    <Sidebar />
  </div>
</div>
