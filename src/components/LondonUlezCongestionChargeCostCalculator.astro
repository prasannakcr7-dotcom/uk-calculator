---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout mobility-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>TfL London Driving Zone Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Vehicle ULEZ Compliance Status</span></div>
        <select id="ulez-compliance-status" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="non_compliant" selected>Non-Compliant Vehicle (Euro 3 Petrol / Euro 5 Diesel - £12.50/day)</option>
          <option value="compliant">Compliant Vehicle (Euro 4 Petrol / Euro 6 Diesel / EV - £0/day)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Driving into Central London Congestion Charge Zone (7am-6pm Mon-Fri / 12pm-6pm Sat-Sun)?</span></div>
        <select id="congestion-charge-status" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="yes" selected>Yes - Drive in Congestion Zone (£15.00/day Charge)</option>
          <option value="no">No - Outer London ULEZ Driving Only</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Number of Driving Days Per Week</span></div>
        <div class="amount-field">
          <input type="number" id="tfl-driving-days-per-week" value="5" min="1" max="7" step="1" />
          <span class="cur">days/wk</span>
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--mobility-1), var(--mobility-2) 80%);">
      <div class="result-label">Total Daily TfL Driving Charges</div>
      <div class="result-amount"><span id="mainResultDisplay">£27.50 / day</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Estimated Annual TfL Driving Outlay:</span>
        <span class="val" id="subResultValue">£7,150.00 / year</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 London Road Charge Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Daily ULEZ Charge (£12.50)</span>
          <span class="val" id="ulezDailyDisplay">£12.50 / day</span>
        </div>
        <div class="breakdown-row section">
          <span>Daily Congestion Charge (£15.00)</span>
          <span class="val" id="ccDailyDisplay">£15.00 / day</span>
        </div>
        <div class="breakdown-row section">
          <span>Weekly Combined TfL Charge</span>
          <span class="val" id="weeklyTflDisplay">£137.50 / week</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Estimated Annual TfL Cost (52 wks)</span>
          <span class="val" id="annualTflDisplay" style="font-weight: 700; font-size: 18px;">£7,150.00 / year</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="movilidad" />
  </div>
</div>

<script>
  function calculateLondonCharges() {
    const ulezEl = document.getElementById('ulez-compliance-status') as HTMLSelectElement;
    const ccEl = document.getElementById('congestion-charge-status') as HTMLSelectElement;
    const daysEl = document.getElementById('tfl-driving-days-per-week') as HTMLInputElement;

    if (!ulezEl || !ccEl || !daysEl) return;

    const isNonCompliant = ulezEl.value === 'non_compliant';
    const hasCc = ccEl.value === 'yes';
    const days = parseInt(daysEl.value) || 5;

    const ulezFee = isNonCompliant ? 12.50 : 0;
    const ccFee = hasCc ? 15.00 : 0;
    const dailyTotal = ulezFee + ccFee;

    const weeklyTotal = dailyTotal * days;
    const annualTotal = weeklyTotal * 52;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const ulezRes = document.getElementById('ulezDailyDisplay');
    const ccRes = document.getElementById('ccDailyDisplay');
    const weekRes = document.getElementById('weeklyTflDisplay');
    const annualRes = document.getElementById('annualTflDisplay');

    if (mainRes) mainRes.textContent = '£' + dailyTotal.toFixed(2) + ' / day';
    if (subVal) subVal.textContent = '£' + annualTotal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (ulezRes) ulezRes.textContent = '£' + ulezFee.toFixed(2) + ' / day';
    if (ccRes) ccRes.textContent = '£' + ccFee.toFixed(2) + ' / day';
    if (weekRes) weekRes.textContent = '£' + weeklyTotal.toFixed(2) + ' / week';
    if (annualRes) annualRes.textContent = '£' + annualTotal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
  }

  ['ulez-compliance-status', 'congestion-charge-status', 'tfl-driving-days-per-week'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateLondonCharges);
    document.getElementById(id)?.addEventListener('change', calculateLondonCharges);
  });
  calculateLondonCharges();
</script>
