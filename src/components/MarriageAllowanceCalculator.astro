---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout taxes-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Marriage Tax Allowance Eligibility Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Lower Earning Partner's Annual Income (£ - Must be under £12,570)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="marriage-lower-income" value="9500" min="0" max="12570" step="500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Higher Earning Partner's Annual Income (£ - Basic Rate Taxpayer)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="marriage-higher-income" value="32000" min="12571" max="50270" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Backdate Claim for Previous Tax Years?</span></div>
        <select id="marriage-backdate-years" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="1" selected>Current Tax Year Only (1 Year - £252 Tax Saved)</option>
          <option value="4">Max Backdate Claim (4 Tax Years - £1,260 Total Lump Sum)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">Annual Marriage Tax Benefit Reduction</div>
      <div class="result-amount"><span id="mainResultDisplay">£252.00 / year</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Transferred Personal Allowance Amount:</span>
        <span class="val" id="subResultValue">£1,260.00 Transferred</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Marriage Allowance Tax Benefit Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Unused Personal Allowance Transferred (10%)</span>
          <span class="val" id="transferredAllowanceDisplay">£1,260.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Basic Rate Tax Relief Rate</span>
          <span class="val" id="basicRateReliefDisplay">20% Income Tax Saving</span>
        </div>
        <div class="breakdown-row section">
          <span>Annual Household Income Tax Saving</span>
          <span class="val" id="annualTaxSavingDisplay">£252.00 / year</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Cumulative HMRC Refund Payable</span>
          <span class="val" id="totalRefundPayableDisplay" style="font-weight: 700; font-size: 18px;">£252.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="impuestos" />
  </div>
</div>

<script>
  function calculateMarriageAllowance() {
    const lowerEl = document.getElementById('marriage-lower-income') as HTMLInputElement;
    const higherEl = document.getElementById('marriage-higher-income') as HTMLInputElement;
    const backdateEl = document.getElementById('marriage-backdate-years') as HTMLSelectElement;

    if (!lowerEl || !higherEl || !backdateEl) return;

    const lowerIncome = parseFloat(lowerEl.value) || 0;
    const higherIncome = parseFloat(higherEl.value) || 0;
    const backdateYears = parseInt(backdateEl.value) || 1;

    // Marriage allowance: Lower earner transfers 10% of PA (£1,260) to higher earner (basic rate taxpayer)
    const transferredPA = 1260;
    const annualSaving = transferredPA * 0.20; // £252
    const totalRefund = annualSaving * backdateYears;

    const isEligible = lowerIncome <= 12570 && higherIncome > 12570 && higherIncome <= 50270;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const transRes = document.getElementById('transferredAllowanceDisplay');
    const reliefRes = document.getElementById('basicRateReliefDisplay');
    const annualRes = document.getElementById('annualTaxSavingDisplay');
    const totalRes = document.getElementById('totalRefundPayableDisplay');

    if (mainRes) mainRes.textContent = isEligible ? '£' + annualSaving.toFixed(2) + ' / year' : '£0.00 (Ineligible)';
    if (subVal) subVal.textContent = isEligible ? '£1,260.00 Transferred' : 'Criteria Not Met';
    if (transRes) transRes.textContent = isEligible ? '£1,260.00' : '£0.00';
    if (reliefRes) reliefRes.textContent = '20% Income Tax Saving';
    if (annualRes) annualRes.textContent = isEligible ? '£' + annualSaving.toFixed(2) + ' / year' : '£0.00';
    if (totalRes) totalRes.textContent = isEligible ? '£' + totalRefund.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '£0.00';
  }

  ['marriage-lower-income', 'marriage-higher-income', 'marriage-backdate-years'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateMarriageAllowance);
    document.getElementById(id)?.addEventListener('change', calculateMarriageAllowance);
  });
  calculateMarriageAllowance();
</script>
