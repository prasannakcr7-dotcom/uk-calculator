---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout work-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>National Minimum Wage (NMW / NLW) Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Employee Age Bracket</span></div>
        <select id="nmw-age-bracket-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="nlw_21_plus" selected>21 and Over - National Living Wage (£11.44 / hour)</option>
          <option value="rate_18_20">18 to 20 Years Old (£8.60 / hour)</option>
          <option value="under_18">Under 18 / School Leaver (£6.40 / hour)</option>
          <option value="apprentice">Apprentice (£6.40 / hour)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Weekly Contracted Hours Worked</span></div>
        <div class="amount-field">
          <input type="number" id="nmw-weekly-hours" value="37.5" min="1" max="80" step="0.5" />
          <span class="cur">hrs/wk</span>
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">Statutory Minimum Hourly Rate</div>
      <div class="result-amount"><span id="mainResultDisplay">£11.44 / hour</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Minimum Weekly Earnings (37.5 hrs):</span>
        <span class="val" id="subResultValue">£429.00 / week</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Statutory Minimum Pay Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Statutory Hourly Rate</span>
          <span class="val" id="statutoryHourlyRateDisplay">£11.44 / hour</span>
        </div>
        <div class="breakdown-row section">
          <span>Minimum Weekly Pay</span>
          <span class="val" id="minimumWeeklyPayDisplay">£429.00 / week</span>
        </div>
        <div class="breakdown-row section">
          <span>Minimum Monthly Pay</span>
          <span class="val" id="minimumMonthlyPayDisplay">£1,859.00 / month</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Minimum Annual Salary (52 Weeks)</span>
          <span class="val" id="minimumAnnualSalaryDisplay" style="font-weight: 700; font-size: 18px;">£22,308.00 / year</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="trabajo" />
  </div>
</div>

<script>
  function calculateNmw() {
    const ageEl = document.getElementById('nmw-age-bracket-select') as HTMLSelectElement;
    const hoursEl = document.getElementById('nmw-weekly-hours') as HTMLInputElement;

    if (!ageEl || !hoursEl) return;

    const age = ageEl.value;
    const hours = parseFloat(hoursEl.value) || 37.5;

    // 2026/27 NMW Rates:
    // NLW (21+): £11.44
    // 18-20: £8.60
    // Under 18 / Apprentice: £6.40
    let hourlyRate = 11.44;
    if (age === 'rate_18_20') hourlyRate = 8.60;
    if (age === 'under_18' || age === 'apprentice') hourlyRate = 6.40;

    const weekly = hourlyRate * hours;
    const annual = weekly * 52;
    const monthly = annual / 12;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const hourlyRes = document.getElementById('statutoryHourlyRateDisplay');
    const weekRes = document.getElementById('minimumWeeklyPayDisplay');
    const monthRes = document.getElementById('minimumMonthlyPayDisplay');
    const annualRes = document.getElementById('minimumAnnualSalaryDisplay');

    if (mainRes) mainRes.textContent = '£' + hourlyRate.toFixed(2) + ' / hour';
    if (subVal) subVal.textContent = '£' + weekly.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / week';
    if (hourlyRes) hourlyRes.textContent = '£' + hourlyRate.toFixed(2) + ' / hour';
    if (weekRes) weekRes.textContent = '£' + weekly.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / week';
    if (monthRes) monthRes.textContent = '£' + monthly.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (annualRes) annualRes.textContent = '£' + annual.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
  }

  ['nmw-age-bracket-select', 'nmw-weekly-hours'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateNmw);
    document.getElementById(id)?.addEventListener('change', calculateNmw);
  });
  calculateNmw();
</script>
