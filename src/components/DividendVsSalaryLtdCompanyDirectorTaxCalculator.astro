---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Director Extraction Strategy Details'}</h2>

      <!-- Total Available Company Profit -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.profitLabel || 'Available Gross Company Profit (£)'}</span>
          <span class="hint" id="profitVal">£70,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="70,000" id="profitInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="15000" max="200000" step="2500" value="70000" id="profitSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£15,000</span><span>£200,000</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Optimal Take-Home (Salary + Dividend Mix)'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£52,437.20/yr</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.optimalSalaryLabel || 'Optimal Salary Drawn:'}</span>
        <span class="val" id="subResultValue">£12,570.00 Salary (0% Tax & 0% NI)</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Director Tax Extraction Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Optimal Director Salary Drawn</span>
          <span class="val">£12,570.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Post-Salary Taxable Company Profit</span>
          <span class="val" id="postSalaryProfitDisplay">£57,430.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Corporation Tax Paid (19% / 25%)</span>
          <span class="val" id="corpTaxDisplay">-£10,958.95</span>
        </div>
        <div class="breakdown-row section">
          <span>Dividend Tax Paid by Director</span>
          <span class="val" id="divTaxDisplay">-£6,603.85</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Take-Home Cash Retained</span>
          <span class="val" id="netTakeHomeDisplay" style="font-weight: 700; font-size: 18px;">£52,437.20</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>Optimal Salary:</strong> £12,570/yr (Primary NI threshold).<br/>
        • <strong>0% Employee & Employer NI:</strong> Salary under £12,570 incurs zero National Insurance.<br/>
        • <strong>Dividend Allowance:</strong> £500 tax-free.<br/>
        • <strong>Dividend Tax Rates:</strong> 8.75% basic rate; 33.75% higher rate.<br/>
        • <strong>Corporation Tax Deduction:</strong> Salaries reduce Corp Tax; dividends do NOT.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const profitInput = document.getElementById('profitInput') as HTMLInputElement;
  const profitSlider = document.getElementById('profitSlider') as HTMLInputElement;
  const profitVal = document.getElementById('profitVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const postSalaryProfitDisplay = document.getElementById('postSalaryProfitDisplay') as HTMLElement;
  const corpTaxDisplay = document.getElementById('corpTaxDisplay') as HTMLElement;
  const divTaxDisplay = document.getElementById('divTaxDisplay') as HTMLElement;
  const netTakeHomeDisplay = document.getElementById('netTakeHomeDisplay') as HTMLElement;

  function calculate() {
    const profit = parseInputVal(profitInput.value);

    // Optimal Salary Strategy (£12,570)
    const salary = Math.min(profit, 12570);
    const corpTaxableProfit = Math.max(0, profit - salary);

    let corpTax = 0;
    if (corpTaxableProfit <= 50000) {
      corpTax = corpTaxableProfit * 0.19;
    } else if (corpTaxableProfit >= 250000) {
      corpTax = corpTaxableProfit * 0.25;
    } else {
      corpTax = (corpTaxableProfit * 0.25) - ((3 / 200) * (250000 - corpTaxableProfit));
    }

    const postTaxCorpProfit = Math.max(0, corpTaxableProfit - corpTax);

    // Dividend Tax Calculation
    let divTax = 0;
    const taxableDividends = Math.max(0, postTaxCorpProfit - 500); // £500 Dividend Allowance
    if (taxableDividends > 0) {
      const basicBandRemaining = Math.max(0, 37700 - Math.max(0, salary - 12570));
      if (taxableDividends <= basicBandRemaining) {
        divTax = taxableDividends * 0.0875;
      } else {
        const basicPart = basicBandRemaining * 0.0875;
        const higherPart = (taxableDividends - basicBandRemaining) * 0.3375;
        divTax = basicPart + higherPart;
      }
    }

    const totalTakeHome = salary + postTaxCorpProfit - divTax;

    profitVal.innerText = formatCurrency(profit).slice(0, -3);

    mainResultDisplay.innerText = `${formatCurrency(totalTakeHome)}/yr`;
    subResultValue.innerText = `${formatCurrency(salary)} Salary (0% Tax & 0% NI)`;

    postSalaryProfitDisplay.innerText = formatCurrency(corpTaxableProfit);
    corpTaxDisplay.innerText = corpTax > 0 ? `-${formatCurrency(corpTax)}` : '£0.00';
    divTaxDisplay.innerText = divTax > 0 ? `-${formatCurrency(divTax)}` : '£0.00';
    netTakeHomeDisplay.innerText = formatCurrency(totalTakeHome);
  }

  profitInput.addEventListener('input', () => {
    const val = parseInputVal(profitInput.value);
    profitSlider.value = String(val);
    calculate();
  });

  profitSlider.addEventListener('input', () => {
    profitInput.value = parseInt(profitSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  calculate();
</script>
