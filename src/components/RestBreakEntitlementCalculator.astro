---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout work-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Working Time & Rest Break Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Daily Shift Duration Worked (Hours)</span></div>
        <div class="amount-field">
          <input type="number" id="restbreak-shift-hours" value="8.0" min="1" max="24" step="0.5" />
          <span class="cur">hours</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Worker Age Group Category</span></div>
        <select id="restbreak-worker-age-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="adult" selected>Adult Worker (18 and Over - 20 min break per 6+ hrs)</option>
          <option value="young_worker">Young Worker (16-17 Years Old - 30 min break per 4.5+ hrs)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">Statutory Minimum Rest Break Entitlement</div>
      <div class="result-amount"><span id="mainResultDisplay">20 Minutes Rest Break</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Daily & Weekly Rest Entitlements:</span>
        <span class="val" id="subResultValue">11 Hours Daily Rest / 24 Hours Weekly Rest</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Statutory Rest Break Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>In-Work Rest Break Entitlement</span>
          <span class="val" id="inWorkBreakDisplay">20 Minutes (Unpaid unless contracted)</span>
        </div>
        <div class="breakdown-row section">
          <span>Daily Rest Period (Between Shifts)</span>
          <span class="val" id="dailyRestPeriodDisplay">11 Consecutive Hours</span>
        </div>
        <div class="breakdown-row section">
          <span>Weekly Rest Period</span>
          <span class="val" id="weeklyRestPeriodDisplay">24 Uninterrupted Hours Per 7 Days</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Working Time Regulations (WTR 1998) Status</span>
          <span class="val" id="wtrStatusDisplay" style="font-weight: 700; font-size: 18px;">Statutory Rest Break Entitled</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="trabajo" />
  </div>
</div>

<script>
  function calculateRestBreaks() {
    const hoursEl = document.getElementById('restbreak-shift-hours') as HTMLInputElement;
    const ageEl = document.getElementById('restbreak-worker-age-select') as HTMLSelectElement;

    if (!hoursEl || !ageEl) return;

    const shiftHours = parseFloat(hoursEl.value) || 0;
    const isAdult = ageEl.value === 'adult';

    let breakMinutes = 0;
    let isEntitled = false;

    if (isAdult) {
      if (shiftHours > 6.0) {
        breakMinutes = 20;
        isEntitled = true;
      }
    } else {
      if (shiftHours > 4.5) {
        breakMinutes = 30;
        isEntitled = true;
      }
    }

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const breakRes = document.getElementById('inWorkBreakDisplay');
    const dailyRes = document.getElementById('dailyRestPeriodDisplay');
    const weeklyRes = document.getElementById('weeklyRestPeriodDisplay');
    const statusRes = document.getElementById('wtrStatusDisplay');

    if (mainRes) mainRes.textContent = isEntitled ? `${breakMinutes} Minutes Rest Break` : 'No Statutory Break Required (< Threshold)';
    if (subVal) subVal.textContent = isAdult ? '11 Hours Daily Rest / 24 Hours Weekly Rest' : '12 Hours Daily Rest / 48 Hours Weekly Rest';
    if (breakRes) breakRes.textContent = isEntitled ? `${breakMinutes} Minutes Continuous Uninterrupted Break` : '0 Minutes (< 6 hrs shift)';
    if (dailyRes) dailyRes.textContent = isAdult ? '11 Consecutive Hours' : '12 Consecutive Hours';
    if (weeklyRes) weeklyRes.textContent = isAdult ? '24 Uninterrupted Hours Per 7 Days' : '48 Uninterrupted Hours Per 7 Days';
    if (statusRes) statusRes.textContent = isEntitled ? 'Statutory Rest Break Entitled' : 'Below Statutory Threshold';
  }

  ['restbreak-shift-hours', 'restbreak-worker-age-select'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateRestBreaks);
    document.getElementById(id)?.addEventListener('change', calculateRestBreaks);
  });
  calculateRestBreaks();
</script>
