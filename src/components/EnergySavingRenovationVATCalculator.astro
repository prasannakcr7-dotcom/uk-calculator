---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Energy Saving Material Installation Details'}</h2>

      <!-- Installation Cost -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.costLabel || 'Net Installation & Material Cost (£)'}</span>
          <span class="hint" id="costVal">£8,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="8,000" id="costInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="50000" step="500" value="8000" id="costSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0</span><span>£50,000</span></div>
      </div>

      <!-- Applicable VAT Rate -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.vatRateLabel || 'Energy Saving VAT Rate Tier'}</span>
          <span class="hint" id="vatRateVal">0% Relief (Energy Saving Materials)</span>
        </div>
        <select id="vatRateSelect" style="width:100%; padding:10px; border-radius:8px; border:1px solid var(--line); font-size:15px; margin-top:8px;">
          <option value="0" selected>0% Zero Rate (Solar, Heat Pumps, Insulation until March 2027)</option>
          <option value="5">5% Reduced Rate (Qualifying Home Renovations)</option>
          <option value="20">20% Standard Rate (Standard Construction)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Total Cost Including Energy VAT Relief'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£8,000.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.vatSavingLabel || 'Total VAT Saved vs Standard 20% Rate:'}</span>
        <span class="val" id="subResultValue">£1,600.00 Saved</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Energy VAT Relief Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Net Installation Cost</span>
          <span class="val" id="netCostDisplay">£8,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Standard 20% VAT (If Unrelieved)</span>
          <span class="val" id="standardVatDisplay">£1,600.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Actual VAT Paid (Applied Rate)</span>
          <span class="val" id="actualVatDisplay">£0.00 (0% Rate)</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Price Paid Including VAT</span>
          <span class="val" id="totalCostDisplay" style="font-weight: 700; font-size: 18px;">£8,000.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>0% VAT Rate:</strong> Applies to installation of heat pumps, solar panels, insulation, and biomass boilers.<br/>
        • <strong>March 2027 Sunset:</strong> 0% temporary relief rate active until 31 March 2027.<br/>
        • <strong>Installation Requirement:</strong> Materials must be supplied and installed by a registered contractor.<br/>
        • <strong>5% Reduced Rate:</strong> Applies to residential conversions and empty home renovations (empty 2+ yrs).
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const costInput = document.getElementById('costInput') as HTMLInputElement;
  const costSlider = document.getElementById('costSlider') as HTMLInputElement;
  const costVal = document.getElementById('costVal') as HTMLElement;
  const vatRateSelect = document.getElementById('vatRateSelect') as HTMLSelectElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const netCostDisplay = document.getElementById('netCostDisplay') as HTMLElement;
  const standardVatDisplay = document.getElementById('standardVatDisplay') as HTMLElement;
  const actualVatDisplay = document.getElementById('actualVatDisplay') as HTMLElement;
  const totalCostDisplay = document.getElementById('totalCostDisplay') as HTMLElement;

  function calculate() {
    const net = parseInputVal(costInput.value);
    const ratePct = parseFloat(vatRateSelect.value) / 100;

    const standardVat = net * 0.20;
    const actualVat = net * ratePct;
    const totalCost = net + actualVat;
    const vatSaved = standardVat - actualVat;

    costVal.innerText = formatCurrency(net).slice(0, -3);

    mainResultDisplay.innerText = formatCurrency(totalCost);
    subResultValue.innerText = `${formatCurrency(vatSaved)} Saved`;

    netCostDisplay.innerText = formatCurrency(net);
    standardVatDisplay.innerText = formatCurrency(standardVat);
    actualVatDisplay.innerText = `${formatCurrency(actualVat)} (${(ratePct * 100).toFixed(0)}% Rate)`;
    totalCostDisplay.innerText = formatCurrency(totalCost);
  }

  costInput.addEventListener('input', () => {
    const val = parseInputVal(costInput.value);
    costSlider.value = String(val);
    calculate();
  });

  costSlider.addEventListener('input', () => {
    costInput.value = parseInt(costSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  vatRateSelect.addEventListener('change', calculate);

  calculate();
</script>
