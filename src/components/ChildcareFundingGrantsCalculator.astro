---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
  nation?: string;
}

const { labels, nation = 'england' } = Astro.props;
---

<div class="layout calculator-layout family-category" data-labels={JSON.stringify(labels)} data-nation={nation}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Childcare Funding Details'}</h2>

      <!-- Hours Needed -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.hoursNeededLabel || 'Childcare Hours Needed Per Week'}</span>
          <span class="hint" id="hoursVal">30 Hours</span>
        </div>
        <input type="range" min="10" max="50" step="5" value="30" id="hoursNeededSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>10 Hours</span><span>50 Hours</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--family-1), var(--family-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Estimated Annual Childcare Savings'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£7,410.00/yr</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.fundedHoursLabel || 'Funded Hours Per Week:'}</span>
        <span class="val" id="subResultValue">30 Hours</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Funding Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Statutory Free Funded Hours/Wk</span>
          <span class="val" id="fundedHoursDisplay">30 Hours</span>
        </div>
        <div class="breakdown-row section">
          <span>Average UK Hourly Childcare Cost</span>
          <span class="val" id="hourlyCostDisplay">£6.50/hr</span>
        </div>
        <div class="breakdown-row section">
          <span>Term-Time Weeks Covered</span>
          <span class="val" id="weeksCoveredDisplay">38 Weeks</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Estimated Annual Subsidy Savings</span>
          <span class="val" id="annualSavingsDisplay" style="font-weight: 700; font-size: 18px;">£7,410.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • Working parents of children 9 months to 4 years.<br/>
        • Up to <strong>30 free hours/week</strong> term-time (38 weeks/yr).<br/>
        • Tax-Free Childcare provides an extra 20% bonus (up to £2,000/yr).
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const hoursNeededSlider = document.getElementById('hoursNeededSlider') as HTMLInputElement;
  const hoursVal = document.getElementById('hoursVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const fundedHoursDisplay = document.getElementById('fundedHoursDisplay') as HTMLElement;
  const hourlyCostDisplay = document.getElementById('hourlyCostDisplay') as HTMLElement;
  const weeksCoveredDisplay = document.getElementById('weeksCoveredDisplay') as HTMLElement;
  const annualSavingsDisplay = document.getElementById('annualSavingsDisplay') as HTMLElement;

  hoursNeededSlider.addEventListener('input', calculate);

  function calculate() {
    const hrs = parseInt(hoursNeededSlider.value, 10);
    hoursVal.textContent = `${hrs} Hours`;

    const fundedHrs = Math.min(30, hrs);
    const hourlyRate = 6.50;
    const annual = fundedHrs * 38 * hourlyRate;

    mainResultDisplay.textContent = `${formatCurrency(annual)}/yr`;
    subResultValue.textContent = `${fundedHrs} Hours`;
    fundedHoursDisplay.textContent = `${fundedHrs} Hours`;
    hourlyCostDisplay.textContent = '£6.50/hr';
    weeksCoveredDisplay.textContent = '38 Weeks';
    annualSavingsDisplay.textContent = formatCurrency(annual);
  }

  calculate();
</script>
