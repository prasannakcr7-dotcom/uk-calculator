---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Plaster / Render Surface Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Total Wall Surface Area (Square Metres - sq m)</span></div>
        <div class="amount-field">
          <input type="number" id="plaster-wall-area-sqm" value="35" min="5" max="500" step="5" />
          <span class="cur">sq m</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Plaster Product / System Type</span></div>
        <select id="plaster-type-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="finish_skim" selected>Multi-Finish Skim Plaster (2mm Coat - 10 sq m / 25kg bag)</option>
          <option value="undercoat_backing">Thistle Hardwall / Bonding Undercoat (11mm Coat - 3 sq m / 25kg bag)</option>
          <option value="external_render">External Sand & Cement Sand Render (15mm Coat - 1.5 sq m / 25kg bag)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Price Per 25kg Bag (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="plaster-bag-price" value="12.50" min="5" step="0.5" />
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--housing-1), var(--housing-2) 80%);">
      <div class="result-label">Total Plaster Bags Required</div>
      <div class="result-amount"><span id="mainResultDisplay">4 Bags (25kg)</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Total Material Cost:</span>
        <span class="val" id="subResultValue">£50.00 Total</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Material Quantity Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Gross Plaster Surface Coverage</span>
          <span class="val" id="surfaceAreaDisplay">35.00 sq m</span>
        </div>
        <div class="breakdown-row section">
          <span>Coverage Per 25kg Bag</span>
          <span class="val" id="bagCoverageDisplay">10.00 sq m / bag (2mm Skim)</span>
        </div>
        <div class="breakdown-row section">
          <span>Total Weight Required</span>
          <span class="val" id="totalWeightDisplay">100 kg</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total 25kg Bags to Purchase</span>
          <span class="val" id="totalBagsRequiredDisplay" style="font-weight: 700; font-size: 18px;">4 Bags (£50.00 Total)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="vivienda" />
  </div>
</div>

<script>
  function calculatePlaster() {
    const areaEl = document.getElementById('plaster-wall-area-sqm') as HTMLInputElement;
    const typeEl = document.getElementById('plaster-type-select') as HTMLSelectElement;
    const priceEl = document.getElementById('plaster-bag-price') as HTMLInputElement;

    if (!areaEl || !typeEl || !priceEl) return;

    const area = parseFloat(areaEl.value) || 0;
    const type = typeEl.value;
    const bagPrice = parseFloat(priceEl.value) || 12.50;

    let covPerBag = 10.0; // Multi-finish skim
    if (type === 'undercoat_backing') covPerBag = 3.0;
    else if (type === 'external_render') covPerBag = 1.5;

    const bagsNeeded = Math.ceil(area / covPerBag);
    const totalCost = bagsNeeded * bagPrice;
    const totalWeightKg = bagsNeeded * 25;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const areaRes = document.getElementById('surfaceAreaDisplay');
    const covRes = document.getElementById('bagCoverageDisplay');
    const weightRes = document.getElementById('totalWeightDisplay');
    const totalRes = document.getElementById('totalBagsRequiredDisplay');

    if (mainRes) mainRes.textContent = `${bagsNeeded} Bags (25kg)`;
    if (subVal) subVal.textContent = '£' + totalCost.toFixed(2) + ' Total';
    if (areaRes) areaRes.textContent = area.toFixed(2) + ' sq m';
    if (covRes) covRes.textContent = covPerBag.toFixed(2) + ' sq m / bag';
    if (weightRes) weightRes.textContent = totalWeightKg + ' kg';
    if (totalRes) totalRes.textContent = `${bagsNeeded} Bags (£${totalCost.toFixed(2)} Total)`;
  }

  ['plaster-wall-area-sqm', 'plaster-type-select', 'plaster-bag-price'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculatePlaster);
    document.getElementById(id)?.addEventListener('change', calculatePlaster);
  });
  calculatePlaster();
</script>
