---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Capital Gain Details'}</h2>

      <!-- Total Net Capital Gain -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.gainLabel || 'Total Net Capital Gain (£)'}</span>
          <span class="hint" id="gainVal">£15,000</span>
        </div>
        <div class="amount-field" style="margin-top: 0; margin-bottom: 0;">
          <input type="text" value="15,000" id="gainInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="1000" max="100000" step="1000" value="15000" id="gainSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£1,000</span><span>£100,000</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Total Capital Gains Tax (CGT) Liability'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£2,160.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.aeaLabel || 'Annual Exempt Amount (AEA):'}</span>
        <span class="val" id="subResultValue">£3,000.00/yr</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'CGT Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Total Net Capital Gain</span>
          <span class="val" id="totalGainDisplay">£15,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Annual Tax-Free Exemption (AEA)</span>
          <span class="val" id="aeaDisplay">£3,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Taxable Net Capital Gain</span>
          <span class="val" id="taxableGainDisplay">£12,000.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total CGT Due (Basic Rate 18%)</span>
          <span class="val" id="totalCgtDisplay" style="font-weight: 700; font-size: 18px;">£2,160.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • Annual Exemption (AEA): <strong>£3,000</strong><br/>
        • Standard Assets (Basic Rate): <strong>18%</strong><br/>
        • Standard Assets (Higher Rate): <strong>24%</strong><br/>
        • Main Home (PRR): Exempt
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const gainInput = document.getElementById('gainInput') as HTMLInputElement;
  const gainSlider = document.getElementById('gainSlider') as HTMLInputElement;
  const gainVal = document.getElementById('gainVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const totalGainDisplay = document.getElementById('totalGainDisplay') as HTMLElement;
  const aeaDisplay = document.getElementById('aeaDisplay') as HTMLElement;
  const taxableGainDisplay = document.getElementById('taxableGainDisplay') as HTMLElement;
  const totalCgtDisplay = document.getElementById('totalCgtDisplay') as HTMLElement;

  gainInput.addEventListener('input', () => {
    const val = parseInputVal(gainInput.value);
    gainSlider.value = String(Math.min(100000, Math.max(1000, val)));
    calculate();
  });

  gainSlider.addEventListener('input', () => {
    gainInput.value = gainSlider.value;
    calculate();
  });

  function calculate() {
    const gain = parseInputVal(gainInput.value);
    gainVal.textContent = formatCurrency(gain);

    const aea = 3000;
    const taxable = Math.max(0, gain - aea);
    const tax = taxable * 0.18;

    mainResultDisplay.textContent = formatCurrency(tax);
    subResultValue.textContent = formatCurrency(aea);
    totalGainDisplay.textContent = formatCurrency(gain);
    aeaDisplay.textContent = formatCurrency(aea);
    taxableGainDisplay.textContent = formatCurrency(taxable);
    totalCgtDisplay.textContent = formatCurrency(tax);
  }

  calculate();
</script>
