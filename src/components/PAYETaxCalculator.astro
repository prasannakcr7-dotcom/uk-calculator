---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout taxes-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>PAYE Income Tax & NI Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Annual Gross Salary (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="paye-gross-salary" value="38000" min="5000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Tax Code (Default: 1257L)</span></div>
        <input type="text" id="paye-tax-code-input" value="1257L" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);" />
      </div>

      <div class="field-group" style="margin-top: 18px;">
        <div class="field-label"><span>Workplace Pension Salary Sacrifice (%)</span></div>
        <div class="amount-field">
          <input type="number" id="paye-pension-pct" value="5.0" min="0" max="30" step="0.5" />
          <span class="cur">%</span>
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">Net Monthly Take-Home Pay (After PAYE & NI)</div>
      <div class="result-amount"><span id="mainResultDisplay">£2,488.93 / month</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Annual Net Take-Home Salary:</span>
        <span class="val" id="subResultValue">£29,867.20 / year</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 PAYE Payslip Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Gross Annual Salary</span>
          <span class="val" id="grossSalaryDisplay">£38,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>PAYE Income Tax Deductions</span>
          <span class="val" id="payeTaxDeductionsDisplay">-£4,706.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Class 1 National Insurance Deductions (8%)</span>
          <span class="val" id="niDeductionsDisplay">-£2,034.40</span>
        </div>
        <div class="breakdown-row section">
          <span>Workplace Pension Contribution (5%)</span>
          <span class="val" id="pensionDeductionsDisplay">-£1,392.40</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Annual Take-Home Cash</span>
          <span class="val" id="netAnnualTakeHomeDisplay" style="font-weight: 700; font-size: 18px;">£29,867.20 / year (£2,488.93/mo)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="impuestos" />
  </div>
</div>

<script>
  function calculatePaye() {
    const salaryEl = document.getElementById('paye-gross-salary') as HTMLInputElement;
    const pensionEl = document.getElementById('paye-pension-pct') as HTMLInputElement;

    if (!salaryEl || !pensionEl) return;

    const grossSalary = parseFloat(salaryEl.value) || 0;
    const pensionPct = (parseFloat(pensionEl.value) || 5.0) / 100;

    const pensionDeduction = grossSalary * pensionPct;
    const taxableSalary = Math.max(0, grossSalary - pensionDeduction);

    const pa = 12570;
    const taxableIncome = Math.max(0, taxableSalary - pa);

    let tax = 0;
    if (taxableIncome > 37700) {
      tax += 37700 * 0.20 + (taxableIncome - 37700) * 0.40;
    } else {
      tax += taxableIncome * 0.20;
    }

    // Class 1 NI: 8% on earnings between £12,570 & £50,270
    let ni = 0;
    if (taxableSalary > 50270) {
      ni += (50270 - 12570) * 0.08 + (taxableSalary - 50270) * 0.02;
    } else if (taxableSalary > 12570) {
      ni += (taxableSalary - 12570) * 0.08;
    }

    const netAnnual = Math.max(0, grossSalary - tax - ni - pensionDeduction);
    const netMonthly = netAnnual / 12;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const grossRes = document.getElementById('grossSalaryDisplay');
    const taxRes = document.getElementById('payeTaxDeductionsDisplay');
    const niRes = document.getElementById('niDeductionsDisplay');
    const penRes = document.getElementById('pensionDeductionsDisplay');
    const netRes = document.getElementById('netAnnualTakeHomeDisplay');

    if (mainRes) mainRes.textContent = '£' + netMonthly.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (subVal) subVal.textContent = '£' + netAnnual.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (grossRes) grossRes.textContent = '£' + grossSalary.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (taxRes) taxRes.textContent = '-£' + tax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (niRes) niRes.textContent = '-£' + ni.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (penRes) penRes.textContent = '-£' + pensionDeduction.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (netRes) netRes.textContent = '£' + netAnnual.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` / year (£${netMonthly.toFixed(2)}/mo)`;
  }

  ['paye-gross-salary', 'paye-pension-pct'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculatePaye);
    document.getElementById(id)?.addEventListener('change', calculatePaye);
  });
  calculatePaye();
</script>
