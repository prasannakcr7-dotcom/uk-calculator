---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout finance-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Average Annual Pensionable Base Pay (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="afps-pensionable-salary" value="38500" min="15000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Years of Regular Armed Forces Service</span></div>
        <div class="amount-field">
          <input type="number" id="afps-qualifying-years" value="18" min="1" max="40" step="1" />
          <span class="cur">yrs</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Age at Discharge / Exit Date (Years)</span></div>
        <div class="amount-field">
          <input type="number" id="afps-exit-age" value="42" min="20" max="65" step="1" />
          <span class="cur">yrs</span>
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>AFPS 15 Pension & EDP Summary</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Member Pension Contribution Rate</span>
          <strong id="afps-member-contrib-rate">0.00% (Non-Contributory)</strong>
        </div>
        <div class="breakdown-row">
          <span>Early Departure Payment (EDP) Monthly Income (Age 40+ with 20+ Yrs Service)</span>
          <strong id="afps-edp-monthly-val">£0.00 / month</strong>
        </div>
        <div class="breakdown-row">
          <span>Tax-Free EDP Lump Sum (at Exit)</span>
          <strong id="afps-edp-taxfree-lump-sum">£0.00</strong>
        </div>
        <div class="breakdown-row net">
          <span>Estimated Deferred Annual Pension (at State Pension Age)</span>
          <strong id="afps-annual-pension-val">£0.00 / year</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="finanzas" />
  </div>
</div>

<script>
  function calculateAfps() {
    const payEl = document.getElementById('afps-pensionable-salary') as HTMLInputElement;
    const yearsEl = document.getElementById('afps-qualifying-years') as HTMLInputElement;
    const exitAgeEl = document.getElementById('afps-exit-age') as HTMLInputElement;

    if (!payEl || !yearsEl || !exitAgeEl) return;

    const pay = parseFloat(payEl.value) || 0;
    const years = parseInt(yearsEl.value) || 0;
    const exitAge = parseInt(exitAgeEl.value) || 0;

    const accrualRate = 1 / 47;
    const annualPensionAccrued = pay * accrualRate * years;

    let edpIncomeAnnual = 0;
    let edpLumpSum = 0;
    let edpEligible = false;

    if (years >= 20 && exitAge >= 40) {
      edpEligible = true;
      const baseEdpPct = 0.34 + ((years - 20) * 0.0085);
      edpIncomeAnnual = annualPensionAccrued * baseEdpPct;
      edpLumpSum = annualPensionAccrued * 2.25;
    }

    const edpMonthly = edpIncomeAnnual / 12;

    const pensionEl = document.getElementById('afps-annual-pension-val');
    const edpMonthEl = document.getElementById('afps-edp-monthly-val');
    const lumpEl = document.getElementById('afps-edp-taxfree-lump-sum');
    const contribEl = document.getElementById('afps-member-contrib-rate');

    if (pensionEl) pensionEl.textContent = '£' + annualPensionAccrued.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (edpMonthEl) edpMonthEl.textContent = edpEligible ? '£' + edpMonthly.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month' : 'N/A (Requires 20 yrs service & Age 40+ at exit)';
    if (lumpEl) lumpEl.textContent = edpEligible ? '£' + edpLumpSum.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '£0.00';
    if (contribEl) contribEl.textContent = '0.00% (Non-Contributory - Fully funded by Ministry of Defence)';
  }

  ['afps-pensionable-salary', 'afps-qualifying-years', 'afps-exit-age'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateAfps);
    document.getElementById(id)?.addEventListener('change', calculateAfps);
  });
  calculateAfps();
</script>
