---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout work-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Lasting Power of Attorney (LPA) Registration Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Number of LPA Instruments Registering (Property & Financial / Health & Welfare)</span></div>
        <select id="poa-instruments-count" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="2" selected>2 LPA Instruments (Both Property & Financial + Health & Welfare)</option>
          <option value="1">1 LPA Instrument (Property & Financial OR Health & Welfare)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Office of the Public Guardian (OPG) Fee Remission Eligibility</span></div>
        <select id="opg-fee-remission-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="full" selected>Full Standard Application Fee (£82.00 per LPA)</option>
          <option value="remission">50% Fee Remission (Donor Gross Income under £12,000/yr - £41.00 per LPA)</option>
          <option value="exemption">100% Full Exemption (Donor Receives Means-Tested Benefits - £0.00)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">Total OPG Registration Fee Payable</div>
      <div class="result-amount"><span id="mainResultDisplay">£164.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Single LPA Application Fee:</span>
        <span class="val" id="subResultValue">£82.00 per LPA</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 OPG Registration Fee Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Standard OPG Fee Per LPA</span>
          <span class="val" id="opgFeePerLpaDisplay">£82.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Number of Registered LPA Documents</span>
          <span class="val" id="lpaCountDisplay">2 LPA Instruments</span>
        </div>
        <div class="breakdown-row section">
          <span>OPG Remission / Exemption Discount</span>
          <span class="val" id="opgDiscountDisplay">£0.00 (Standard Full Fee)</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total OPG Registration Fee Payable</span>
          <span class="val" id="totalOpgFeeDisplay" style="font-weight: 700; font-size: 18px;">£164.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="trabajo" />
  </div>
</div>

<script>
  function calculateOpgFees() {
    const countEl = document.getElementById('poa-instruments-count') as HTMLSelectElement;
    const remissionEl = document.getElementById('opg-fee-remission-select') as HTMLSelectElement;

    if (!countEl || !remissionEl) return;

    const count = parseInt(countEl.value) || 1;
    const remissionType = remissionEl.value;

    // OPG 2026/27 Fee: £82 per LPA instrument
    let feePerLpa = 82;
    let discountStr = '£0.00 (Standard Full Fee)';

    if (remissionType === 'remission') {
      feePerLpa = 41;
      discountStr = '50% Remission Discount (Income < £12k)';
    } else if (remissionType === 'exemption') {
      feePerLpa = 0;
      discountStr = '100% Exemption Discount (Means-Tested Benefits)';
    }

    const totalFee = feePerLpa * count;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const feeRes = document.getElementById('opgFeePerLpaDisplay');
    const countRes = document.getElementById('lpaCountDisplay');
    const discRes = document.getElementById('opgDiscountDisplay');
    const totalRes = document.getElementById('totalOpgFeeDisplay');

    if (mainRes) mainRes.textContent = '£' + totalFee.toFixed(2);
    if (subVal) subVal.textContent = '£' + feePerLpa.toFixed(2) + ' per LPA';
    if (feeRes) feeRes.textContent = '£' + feePerLpa.toFixed(2);
    if (countRes) countRes.textContent = `${count} LPA Instruments`;
    if (discRes) discRes.textContent = discountStr;
    if (totalRes) totalRes.textContent = '£' + totalFee.toFixed(2);
  }

  ['poa-instruments-count', 'opg-fee-remission-select'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateOpgFees);
    document.getElementById(id)?.addEventListener('change', calculateOpgFees);
  });
  calculateOpgFees();
</script>
