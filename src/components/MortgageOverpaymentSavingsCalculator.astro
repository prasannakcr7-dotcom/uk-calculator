---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Current Outstanding Mortgage Balance (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="overpay-current-balance" value="180000" min="10000" step="5000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Mortgage Interest Rate (% p.a.)</span></div>
        <div class="amount-field">
          <input type="number" id="overpay-interest-rate-pct" value="4.8" min="0.5" max="15" step="0.1" />
          <span class="cur">%</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Remaining Mortgage Term (Years)</span></div>
        <div class="amount-field">
          <input type="number" id="overpay-remaining-term-years" value="20" min="2" max="40" step="1" />
          <span class="cur">yrs</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Regular Monthly Overpayment (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="regular-monthly-overpayment" value="150" min="10" step="25" />
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Overpayment Savings & Term Reduction</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Standard Contractual Monthly Payment</span>
          <strong id="standard-contractual-payment">£1,168.34 / month</strong>
        </div>
        <div class="breakdown-row">
          <span>Total Interest Saved Over Term</span>
          <strong id="total-interest-saved-val">£19,452.18</strong>
        </div>
        <div class="breakdown-row">
          <span>Mortgage Term Reduced By</span>
          <strong id="term-time-saved-str">3 Years 4 Months Shorter</strong>
        </div>
        <div class="breakdown-row net">
          <span>New Mortgage Payoff Timeline</span>
          <strong id="new-mortgage-payoff-years">16 Years 8 Months</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="vivienda" />
  </div>
</div>

<script>
  function calculateMortgageOverpayment() {
    const balEl = document.getElementById('overpay-current-balance') as HTMLInputElement;
    const rateEl = document.getElementById('overpay-interest-rate-pct') as HTMLInputElement;
    const termEl = document.getElementById('overpay-remaining-term-years') as HTMLInputElement;
    const overEl = document.getElementById('regular-monthly-overpayment') as HTMLInputElement;

    if (!balEl || !rateEl || !termEl || !overEl) return;

    const P = parseFloat(balEl.value) || 0;
    const annualRate = (parseFloat(rateEl.value) || 0) / 100;
    const years = parseInt(termEl.value) || 20;
    const overpayment = parseFloat(overEl.value) || 0;

    const r = annualRate / 12;
    const n = years * 12;

    const M = r > 0 ? P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1) : P / n;
    const totalOriginalInterest = (M * n) - P;

    // Simulate month by month with overpayment
    let balance = P;
    let monthsActual = 0;
    let totalInterestOverpaid = 0;

    const M_total = M + overpayment;

    while (balance > 0 && monthsActual < n) {
      monthsActual++;
      const interestMonth = balance * r;
      totalInterestOverpaid += interestMonth;
      const principalMonth = M_total - interestMonth;
      balance -= principalMonth;
    }

    const interestSaved = Math.max(0, totalOriginalInterest - totalInterestOverpaid);
    const monthsSaved = Math.max(0, n - monthsActual);

    const yrsSaved = Math.floor(monthsSaved / 12);
    const remMinsSaved = monthsSaved % 12;

    const newYrs = Math.floor(monthsActual / 12);
    const newRemMins = monthsActual % 12;

    const stdResEl = document.getElementById('standard-contractual-payment');
    const intSavedEl = document.getElementById('total-interest-saved-val');
    const timeSavedEl = document.getElementById('term-time-saved-str');
    const newTermEl = document.getElementById('new-mortgage-payoff-years');

    if (stdResEl) stdResEl.textContent = '£' + M.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (intSavedEl) intSavedEl.textContent = '£' + interestSaved.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (timeSavedEl) timeSavedEl.textContent = `${yrsSaved} Yrs ${remMinsSaved} Mths Shorter`;
    if (newTermEl) newTermEl.textContent = `${newYrs} Years ${newRemMins} Months`;
  }

  ['overpay-current-balance', 'overpay-interest-rate-pct', 'overpay-remaining-term-years', 'regular-monthly-overpayment'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateMortgageOverpayment);
    document.getElementById(id)?.addEventListener('change', calculateMortgageOverpayment);
  });
  calculateMortgageOverpayment();
</script>
