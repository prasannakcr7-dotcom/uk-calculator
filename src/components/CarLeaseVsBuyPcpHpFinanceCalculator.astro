---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout mobility-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Car Price & Finance Terms'}</h2>

      <!-- Car OTR Vehicle Price (£) -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.carPriceLabel || 'Vehicle On-The-Road (OTR) Price (£)'}</span>
          <span class="hint" id="carPriceVal">£30,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="30,000" id="carPriceInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="5000" max="100000" step="1000" value="30000" id="carPriceSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£5,000</span><span>£100,000</span></div>
      </div>

      <!-- Upfront Customer Deposit (£) -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.depositLabel || 'Upfront Customer Deposit (£)'}</span>
          <span class="hint" id="depositVal">£3,000 (10% Deposit)</span>
        </div>
        <div class="amount-field">
          <input type="text" value="3,000" id="depositInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="25000" step="500" value="3000" id="depositSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0</span><span>£25,000</span></div>
      </div>

      <!-- Contract Term (Months) -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.termMonthsLabel || 'Contract Agreement Term (Months)'}</span>
          <span class="hint" id="termMonthsVal">36 Months (3 Years)</span>
        </div>
        <input type="range" min="24" max="60" step="12" value="36" id="termMonthsSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>24 Mos</span><span>60 Mos</span></div>
      </div>

      <!-- Finance APR Interest Rate (%) -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.aprLabel || 'Representative Finance APR (%)'}</span>
          <span class="hint" id="aprVal">6.9% Representative APR</span>
        </div>
        <input type="range" min="0" max="15" step="0.5" value="6.9" id="aprSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>0% (Interest Free)</span><span>15%</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--mobility-1), var(--mobility-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'PCP Monthly Payment vs HP vs Personal Lease (PCH)'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£385.00 / month (PCP)</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.balloonLabel || 'PCP GMFV Balloon Payment / Optional Purchase Fee:'}</span>
        <span class="val" id="subResultValue">£14,500.00 Optional Final Balloon Payment</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Car Finance Options Comparison'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>PCP (Personal Contract Purchase)</span>
          <span class="val" id="pcpDisplay">£385.00 / mo + £14.5k Balloon</span>
        </div>
        <div class="breakdown-row section">
          <span>HP (Hire Purchase — Ownership at End)</span>
          <span class="val" id="hpDisplay">£831.00 / mo (Zero Balloon)</span>
        </div>
        <div class="breakdown-row section">
          <span>PCH (Personal Contract Hire / Lease)</span>
          <span class="val" id="pchDisplay">£350.00 / mo (Hand Back Only)</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Cost to Own via PCP (Incl. Balloon)</span>
          <span class="val" id="pcpTotalDisplay" style="font-weight: 700; font-size: 18px;">£31,360.00 (£4,360 Interest)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>PCP (Personal Contract Purchase):</strong> Lower monthly payments with optional final balloon payment.<br/>
        • <strong>HP (Hire Purchase):</strong> Higher monthly payments, but you own the car 100% at agreement end.<br/>
        • <strong>PCH (Lease):</strong> Rental agreement only (no option to buy/own vehicle at contract end).<br/>
        • <strong>Voluntary Termination (VT):</strong> Right under Consumer Credit Act 1974 to return car after paying 50%.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const carPriceInput = document.getElementById('carPriceInput') as HTMLInputElement;
  const carPriceSlider = document.getElementById('carPriceSlider') as HTMLInputElement;
  const carPriceVal = document.getElementById('carPriceVal') as HTMLElement;

  const depositInput = document.getElementById('depositInput') as HTMLInputElement;
  const depositSlider = document.getElementById('depositSlider') as HTMLInputElement;
  const depositVal = document.getElementById('depositVal') as HTMLElement;

  const termMonthsSlider = document.getElementById('termMonthsSlider') as HTMLInputElement;
  const termMonthsVal = document.getElementById('termMonthsVal') as HTMLElement;

  const aprSlider = document.getElementById('aprSlider') as HTMLInputElement;
  const aprVal = document.getElementById('aprVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const pcpDisplay = document.getElementById('pcpDisplay') as HTMLElement;
  const hpDisplay = document.getElementById('hpDisplay') as HTMLElement;
  const pchDisplay = document.getElementById('pchDisplay') as HTMLElement;
  const pcpTotalDisplay = document.getElementById('pcpTotalDisplay') as HTMLElement;

  function calculate() {
    const price = parseInputVal(carPriceInput.value);
    const deposit = parseInputVal(depositInput.value);
    const months = parseInt(termMonthsSlider.value, 10);
    const apr = parseFloat(aprSlider.value);

    const monthlyInterestRate = (apr / 100) / 12;

    // GMFV / Balloon Payment estimation (~45-50% of original car price for 36 months)
    let gmfvRatio = 0.48;
    if (months === 24) gmfvRatio = 0.58;
    if (months === 48) gmfvRatio = 0.38;
    if (months === 60) gmfvRatio = 0.28;

    const balloonGmfv = price * gmfvRatio;
    const loanAmountPcp = price - deposit - balloonGmfv;
    const loanAmountHp = price - deposit;

    // PCP Monthly Payment Formula
    let pcpMonthly = 0;
    if (monthlyInterestRate > 0) {
      pcpMonthly = (loanAmountPcp * monthlyInterestRate * Math.pow(1 + monthlyInterestRate, months)) / (Math.pow(1 + monthlyInterestRate, months) - 1) + (balloonGmfv * monthlyInterestRate);
    } else {
      pcpMonthly = loanAmountPcp / months;
    }

    // HP Monthly Payment Formula
    let hpMonthly = 0;
    if (monthlyInterestRate > 0) {
      hpMonthly = (loanAmountHp * monthlyInterestRate * Math.pow(1 + monthlyInterestRate, months)) / (Math.pow(1 + monthlyInterestRate, months) - 1);
    } else {
      hpMonthly = loanAmountHp / months;
    }

    // PCH Monthly estimate (~0.90 of PCP rate)
    const pchMonthly = pcpMonthly * 0.91;

    const totalPcpCostToOwn = deposit + (pcpMonthly * months) + balloonGmfv;
    const totalPcpInterest = totalPcpCostToOwn - price;

    carPriceVal.innerText = formatCurrency(price).slice(0, -3);
    depositVal.innerText = `${formatCurrency(deposit).slice(0, -3)} (${price > 0 ? ((deposit / price) * 100).toFixed(0) : 0}% Deposit)`;
    termMonthsVal.innerText = `${months} Months (${(months / 12).toFixed(1)} Years)`;
    aprVal.innerText = `${apr.toFixed(1)}% Representative APR`;

    mainResultDisplay.innerText = `${formatCurrency(pcpMonthly)} / month (PCP)`;
    subResultValue.innerText = `${formatCurrency(balloonGmfv)} Optional Final Balloon Payment (GMFV)`;

    pcpDisplay.innerText = `${formatCurrency(pcpMonthly)} / mo + ${formatCurrency(balloonGmfv).slice(0, -3)} Balloon`;
    hpDisplay.innerText = `${formatCurrency(hpMonthly)} / mo (Zero Balloon)`;
    pchDisplay.innerText = `${formatCurrency(pchMonthly)} / mo (Hand Back Only)`;
    pcpTotalDisplay.innerText = `${formatCurrency(totalPcpCostToOwn)} (${formatCurrency(totalPcpInterest)} Total Interest)`;
  }

  carPriceInput.addEventListener('input', () => {
    const val = parseInputVal(carPriceInput.value);
    carPriceSlider.value = String(val);
    calculate();
  });

  carPriceSlider.addEventListener('input', () => {
    carPriceInput.value = parseInt(carPriceSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  depositInput.addEventListener('input', () => {
    const val = parseInputVal(depositInput.value);
    depositSlider.value = String(val);
    calculate();
  });

  depositSlider.addEventListener('input', () => {
    depositInput.value = parseInt(depositSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  termMonthsSlider.addEventListener('input', calculate);
  aprSlider.addEventListener('input', calculate);

  calculate();
</script>
