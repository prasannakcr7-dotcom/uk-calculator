---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout social-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'State Pension Forecast Details'}</h2>

      <!-- Qualifying Years Accrued -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.yearsLabel || 'National Insurance Qualifying Years Accrued'}</span>
          <span class="hint" id="yearsVal">25 Years</span>
        </div>
        <div class="amount-field">
          <input type="text" value="25" id="yearsInput" inputmode="decimal" />
          <span class="cur">Yrs</span>
        </div>
        <input type="range" min="0" max="35" step="1" value="25" id="yearsSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>0 Years</span><span>35 Years (Max Full Rate)</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--social-1), var(--social-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Estimated Full New State Pension Forecast'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£157.94/wk</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.annualForecastLabel || 'Annual State Pension Forecast Total:'}</span>
        <span class="val" id="subResultValue">£8,213.00/yr (£684.42/mo)</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'State Pension Accrual Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Full Standard New State Pension Rate</span>
          <span class="val">£221.20 / week</span>
        </div>
        <div class="breakdown-row section">
          <span>Qualifying Years Required for Full Rate</span>
          <span class="val">35 Years</span>
        </div>
        <div class="breakdown-row section">
          <span>Qualifying Years Shortfall Remaining</span>
          <span class="val" id="shortfallDisplay">10 Years Shortfall</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Forecast Weekly State Pension Entitlement</span>
          <span class="val" id="netForecastDisplay" style="font-weight: 700; font-size: 18px;">£157.94 / week</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>Full Rate:</strong> £221.20 per week (£11,502.40 per year).<br/>
        • <strong>35 Years:</strong> Required for 100% full New State Pension.<br/>
        • <strong>10-Year Minimum:</strong> Must have at least 10 qualifying years to receive any pension.<br/>
        • <strong>Triple Lock:</strong> Increases annually by highest of inflation, average earnings, or 2.5%.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const yearsInput = document.getElementById('yearsInput') as HTMLInputElement;
  const yearsSlider = document.getElementById('yearsSlider') as HTMLInputElement;
  const yearsVal = document.getElementById('yearsVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const shortfallDisplay = document.getElementById('shortfallDisplay') as HTMLElement;
  const netForecastDisplay = document.getElementById('netForecastDisplay') as HTMLElement;

  const FULL_STATE_PENSION_WEEKLY = 221.20;

  function calculate() {
    const years = parseInputVal(yearsInput.value);

    let weeklyPension = 0;
    if (years >= 10) {
      weeklyPension = (Math.min(35, years) / 35) * FULL_STATE_PENSION_WEEKLY;
    }

    const annualPension = weeklyPension * 52;
    const monthlyPension = annualPension / 12;
    const shortfall = Math.max(0, 35 - years);

    yearsVal.innerText = `${years} Year${years === 1 ? '' : 's'}`;

    if (years < 10) {
      mainResultDisplay.innerText = '£0.00 (Under 10 Yrs)';
      subResultValue.innerText = 'Minimum 10 Qualifying Years Required';
    } else {
      mainResultDisplay.innerText = `${formatCurrency(weeklyPension)}/wk`;
      subResultValue.innerText = `${formatCurrency(annualPension)}/yr (${formatCurrency(monthlyPension)}/mo)`;
    }

    shortfallDisplay.innerText = shortfall > 0 ? `${shortfall} Year${shortfall === 1 ? '' : 's'} Shortfall` : 'None (Full Rate Achieved)';
    netForecastDisplay.innerText = `${formatCurrency(weeklyPension)} / week`;
  }

  yearsInput.addEventListener('input', () => {
    const val = parseInputVal(yearsInput.value);
    yearsSlider.value = String(val);
    calculate();
  });

  yearsSlider.addEventListener('input', () => {
    yearsInput.value = String(parseInt(yearsSlider.value, 10));
    calculate();
  });

  calculate();
</script>
