---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Business Net Profit & Structure Setup'}</h2>

      <!-- Annual Net Profit -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.profitLabel || 'Annual Net Business Profit (£)'}</span>
          <span class="hint" id="profitVal">£50,000</span>
        </div>
        <div class="amount-field">
          <input type="text" value="50,000" id="profitInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="10000" max="200000" step="2500" value="50000" id="profitSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£10,000</span><span>£200,000</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Recommended Business Setup'}</div>
      <div class="result-amount"><span id="mainResultDisplay">Limited Company Recommended</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.takeHomeLabel || 'Estimated Net Annual Take-Home Savings:'}</span>
        <span class="val" id="subResultValue">£1,420.00 Extra Take-Home Pay</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Take-Home Cash Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Sole Trader Net Take-Home (After Tax & Class 4 NI)</span>
          <span class="val" id="soleTakeHomeDisplay">£32,868.20</span>
        </div>
        <div class="breakdown-row section">
          <span>Limited Company Take-Home (Salary + Post-Tax Dividends)</span>
          <span class="val" id="ltdTakeHomeDisplay">£34,288.20</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Annual Cash Advantage</span>
          <span class="val" id="advantageDisplay" style="font-weight: 700; font-size: 18px; color: var(--success, #10b981);">+£1,420.00 Ltd Advantage</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>Sole Trader:</strong> Pay Income Tax (20%/40%) + Class 4 NI (6%/2%).<br/>
        • <strong>Ltd Company:</strong> Pay Corp Tax (19%/25%) + Dividend Tax (8.75%/33.75%).<br/>
        • <strong>Optimal Strategy:</strong> Draw £12,570 salary tax-free; extract remaining profit as dividends.<br/>
        • <strong>Liability:</strong> Ltd company protects personal assets from business liabilities.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const profitInput = document.getElementById('profitInput') as HTMLInputElement;
  const profitSlider = document.getElementById('profitSlider') as HTMLInputElement;
  const profitVal = document.getElementById('profitVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const soleTakeHomeDisplay = document.getElementById('soleTakeHomeDisplay') as HTMLElement;
  const ltdTakeHomeDisplay = document.getElementById('ltdTakeHomeDisplay') as HTMLElement;
  const advantageDisplay = document.getElementById('advantageDisplay') as HTMLElement;

  function calculate() {
    const profit = parseInputVal(profitInput.value);

    // Sole Trader Math
    let soleTax = 0;
    const soleTaxable = Math.max(0, profit - 12570);
    if (soleTaxable <= 37700) {
      soleTax = soleTaxable * 0.20;
    } else {
      soleTax = (37700 * 0.20) + ((soleTaxable - 37700) * 0.40);
    }

    let soleNi = 0;
    if (profit > 12570) {
      const niTaxable = profit - 12570;
      if (niTaxable <= 37700) {
        soleNi = niTaxable * 0.06;
      } else {
        soleNi = (37700 * 0.06) + ((niTaxable - 37700) * 0.02);
      }
    }
    const soleTakeHome = profit - soleTax - soleNi;

    // Ltd Company Math
    const directorSalary = Math.min(profit, 12570);
    const corpTaxable = Math.max(0, profit - directorSalary);
    let corpTax = 0;
    if (corpTaxable <= 50000) {
      corpTax = corpTaxable * 0.19;
    } else {
      corpTax = (corpTaxable * 0.25) - ((3 / 200) * (250000 - corpTaxable));
    }

    const postTaxCorp = Math.max(0, corpTaxable - corpTax);
    let divTax = 0;
    const taxableDivs = Math.max(0, postTaxCorp - 500);
    if (taxableDivs > 0) {
      const basicBandRemaining = Math.max(0, 37700 - Math.max(0, directorSalary - 12570));
      if (taxableDivs <= basicBandRemaining) {
        divTax = taxableDivs * 0.1075;
      } else {
        divTax = (basicBandRemaining * 0.1075) + ((taxableDivs - basicBandRemaining) * 0.3575);
      }
    }

    const ltdTakeHome = directorSalary + postTaxCorp - divTax;
    const advantage = ltdTakeHome - soleTakeHome;

    profitVal.innerText = formatCurrency(profit).slice(0, -3);

    if (advantage > 0) {
      mainResultDisplay.innerText = 'Limited Company Recommended';
      subResultValue.innerText = `${formatCurrency(advantage)} Extra Annual Take-Home`;
      advantageDisplay.innerText = `+${formatCurrency(advantage)} Ltd Advantage`;
      advantageDisplay.style.color = 'var(--success, #10b981)';
    } else {
      mainResultDisplay.innerText = 'Sole Trader Recommended';
      subResultValue.innerText = `${formatCurrency(Math.abs(advantage))} Extra Annual Take-Home`;
      advantageDisplay.innerText = `+${formatCurrency(Math.abs(advantage))} Sole Advantage`;
      advantageDisplay.style.color = 'var(--error, #ef4444)';
    }

    soleTakeHomeDisplay.innerText = formatCurrency(soleTakeHome);
    ltdTakeHomeDisplay.innerText = formatCurrency(ltdTakeHome);
  }

  profitInput.addEventListener('input', () => {
    const val = parseInputVal(profitInput.value);
    profitSlider.value = String(val);
    calculate();
  });

  profitSlider.addEventListener('input', () => {
    profitInput.value = parseInt(profitSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  calculate();
</script>
