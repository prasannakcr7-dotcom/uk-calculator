---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---
<div class="layout calculator-layout work-category">
  <div class="main-col">
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Disposal Value / Sales Proceeds in GBP (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="crypto-disposal-value" value="12000" min="100" step="500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Allowable Cost Basis (Section 104 Pool Cost £)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="crypto-cost-basis" value="5000" min="0" step="500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Exchange Fees & Network Gas Fees (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="crypto-exchange-fees" value="150" min="0" step="25" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Income Tax Band</span></div>
        <select id="user-income-tax-band" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="basic" selected>Basic Rate Taxpayer (18% CGT)</option>
          <option value="higher">Higher / Additional Rate Taxpayer (24% CGT)</option>
        </select>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Calculation Breakdown</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Estimated Crypto CGT Payable:</span>
          <strong id="crypto-cgt-payable">£0.00</strong>
        </div>
        <div class="breakdown-row">
          <span>Gross Realized Capital Gain:</span>
          <strong id="crypto-gross-gain">£0.00</strong>
        </div>
        <div class="breakdown-row">
          <span>CGT Exemption Applied (£3,000 max):</span>
          <strong id="crypto-allowance-used">£0.00</strong>
        </div>
        <div class="breakdown-row">
          <span>Taxable Gain Subject to CGT:</span>
          <strong id="crypto-taxable-gain">£0.00</strong>
        </div>
        <div class="breakdown-row net">
          <span>Applicable Crypto CGT Tax Rate:</span>
          <strong id="crypto-cgt-rate">18% / 24%</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar />
  </div>
</div>

<script>
  function calculateCryptoTax() {
    const proceedsEl = document.getElementById('crypto-disposal-value') as HTMLInputElement;
    const costEl = document.getElementById('crypto-cost-basis') as HTMLInputElement;
    const feesEl = document.getElementById('crypto-exchange-fees') as HTMLInputElement;
    const taxBandEl = document.getElementById('user-income-tax-band') as HTMLSelectElement;

    if (!proceedsEl || !costEl || !feesEl || !taxBandEl) return;

    const proceeds = parseFloat(proceedsEl.value) || 0;
    const cost = parseFloat(costEl.value) || 0;
    const fees = parseFloat(feesEl.value) || 0;
    const taxBand = taxBandEl.value;

    const annualAllowance = 3000; // 2026/27 CGT annual exempt amount
    const grossGain = Math.max(0, proceeds - cost - fees);
    const allowanceUsed = Math.min(annualAllowance, grossGain);
    const taxableGain = Math.max(0, grossGain - allowanceUsed);

    const cgtRate = taxBand === 'basic' ? 0.18 : 0.24;
    const cgtPayable = taxableGain * cgtRate;

    const payableEl = document.getElementById('crypto-cgt-payable');
    const grossEl = document.getElementById('crypto-gross-gain');
    const allowEl = document.getElementById('crypto-allowance-used');
    const taxGainEl = document.getElementById('crypto-taxable-gain');
    const rateEl = document.getElementById('crypto-cgt-rate');

    if (payableEl) payableEl.textContent = '£' + cgtPayable.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (grossEl) grossEl.textContent = '£' + grossGain.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (allowEl) allowEl.textContent = '£' + allowanceUsed.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (taxGainEl) taxGainEl.textContent = '£' + taxableGain.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (rateEl) rateEl.textContent = (cgtRate * 100).toFixed(0) + '%';
  }

  ['crypto-disposal-value', 'crypto-cost-basis', 'crypto-exchange-fees', 'user-income-tax-band'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateCryptoTax);
    document.getElementById(id)?.addEventListener('change', calculateCryptoTax);
  });
  calculateCryptoTax();
</script>
