---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout finance-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Overdraft Amount Used (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="overdraft-amount" value="500" min="10" step="50" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Overdraft Effective Annual Rate (EAR %)</span></div>
        <div class="amount-field">
          <input type="number" id="overdraft-ear-rate" value="39.9" min="0" max="60" step="0.1" />
          <span class="cur">%</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Interest-Free Overdraft Buffer (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="fee-free-buffer" value="50" min="0" step="25" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Number of Days Overdrawn per Month</span></div>
        <div class="amount-field">
          <input type="number" id="days-in-overdraft" value="15" min="1" max="31" step="1" />
          <span class="cur">days</span>
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Overdraft Borrowing Cost Summary</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Interest-Bearing Balance</span>
          <strong id="chargeable-balance">£450.00</strong>
        </div>
        <div class="breakdown-row">
          <span>Daily Interest Charge</span>
          <strong id="daily-overdraft-cost">£0.42</strong>
        </div>
        <div class="breakdown-row">
          <span>Annual Cost if Overdrawn Year-Round</span>
          <strong id="annual-overdraft-cost">£179.55</strong>
        </div>
        <div class="breakdown-row net">
          <span>Estimated Monthly Overdraft Interest</span>
          <strong id="monthly-overdraft-cost">£6.30</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="finanzas" />
  </div>
</div>

<script>
  function calculateOverdraftCost() {
    const amountEl = document.getElementById('overdraft-amount') as HTMLInputElement;
    const earEl = document.getElementById('overdraft-ear-rate') as HTMLInputElement;
    const bufferEl = document.getElementById('fee-free-buffer') as HTMLInputElement;
    const daysEl = document.getElementById('days-in-overdraft') as HTMLInputElement;

    if (!amountEl || !earEl || !bufferEl || !daysEl) return;

    const amount = parseFloat(amountEl.value) || 0;
    const ear = (parseFloat(earEl.value) || 0) / 100;
    const buffer = parseFloat(bufferEl.value) || 0;
    const days = parseInt(daysEl.value) || 1;

    const chargeableBalance = Math.max(0, amount - buffer);
    const dailyRate = Math.pow(1 + ear, 1 / 365) - 1;

    const dailyCharge = chargeableBalance * dailyRate;
    const monthlyCharge = dailyCharge * days;
    const annualCharge = dailyCharge * 365;

    const monthlyEl = document.getElementById('monthly-overdraft-cost');
    const dailyEl = document.getElementById('daily-overdraft-cost');
    const balanceEl = document.getElementById('chargeable-balance');
    const annualEl = document.getElementById('annual-overdraft-cost');

    if (monthlyEl) monthlyEl.textContent = '£' + monthlyCharge.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (dailyEl) dailyEl.textContent = '£' + dailyCharge.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (balanceEl) balanceEl.textContent = '£' + chargeableBalance.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (annualEl) annualEl.textContent = '£' + annualCharge.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['overdraft-amount', 'overdraft-ear-rate', 'fee-free-buffer', 'days-in-overdraft'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateOverdraftCost);
    document.getElementById(id)?.addEventListener('change', calculateOverdraftCost);
  });
  calculateOverdraftCost();
</script>
