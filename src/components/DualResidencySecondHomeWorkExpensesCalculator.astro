---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout taxes-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Dual Residency & Temporary Workplace Details'}</h2>

      <!-- Monthly Second Property Expenses -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.monthlyRentLabel || 'Monthly Accommodation & Rent Cost (£)'}</span>
          <span class="hint" id="monthlyRentVal">£1,200</span>
        </div>
        <div class="amount-field">
          <input type="text" value="1,200" id="monthlyRentInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="5000" step="100" value="1200" id="monthlyRentSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0</span><span>£5,000</span></div>
      </div>

      <!-- Expected Work Duration at Location -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.durationLabel || 'Expected Workplace Assignment Duration (Months)'}</span>
          <span class="hint" id="durationVal">18 Months (Temporary Workplace)</span>
        </div>
        <input type="range" min="1" max="36" step="1" value="18" id="durationSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>1 Month</span><span>36 Months (24-Mo Cap)</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Total Tax-Deductible Temporary Expenses'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£21,600.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.taxRefundLabel || 'Estimated Tax Relief Value (40% Higher Rate):'}</span>
        <span class="val" id="subResultValue">£8,640.00 Refund</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Temporary Workplace Tax Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Monthly Accommodation Outlay</span>
          <span class="val" id="monthlyCostDisplay">£1,200.00 / mo</span>
        </div>
        <div class="breakdown-row section">
          <span>24-Month Rule Qualification</span>
          <span class="val" id="ruleStatusDisplay" style="color: var(--success, #10b981);">Qualifies (&lt; 24 Months)</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Tax Relief Value (40% Rate)</span>
          <span class="val" id="netTaxReliefDisplay" style="font-weight: 700; font-size: 18px;">£8,640.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • <strong>24-Month Rule:</strong> Temporary workplace expenses qualify ONLY if assignment lasts under 24 months.<br/>
        • <strong>Allowable Expenses:</strong> Rent, hotel stays, utilities, travel costs to temporary workplace.<br/>
        • <strong>Permanent Shift:</strong> Once an assignment is expected to pass 24 months, tax relief stops immediately.<br/>
        • <strong>Dual Residency:</strong> Must maintain your main primary residence alongside temporary accommodation.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const monthlyRentInput = document.getElementById('monthlyRentInput') as HTMLInputElement;
  const monthlyRentSlider = document.getElementById('monthlyRentSlider') as HTMLInputElement;
  const monthlyRentVal = document.getElementById('monthlyRentVal') as HTMLElement;
  const durationSlider = document.getElementById('durationSlider') as HTMLInputElement;
  const durationVal = document.getElementById('durationVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const monthlyCostDisplay = document.getElementById('monthlyCostDisplay') as HTMLElement;
  const ruleStatusDisplay = document.getElementById('ruleStatusDisplay') as HTMLElement;
  const netTaxReliefDisplay = document.getElementById('netTaxReliefDisplay') as HTMLElement;

  function calculate() {
    const rent = parseInputVal(monthlyRentInput.value);
    const months = parseInt(durationSlider.value, 10);

    const isQualifying = months <= 24;
    const totalExpense = isQualifying ? rent * months : rent * 24; // Capped at 24 months max
    const taxRelief = isQualifying ? totalExpense * 0.40 : 0; // 40% Higher Rate Tax Relief

    monthlyRentVal.innerText = formatCurrency(rent).slice(0, -3);
    durationVal.innerText = `${months} Month${months === 1 ? '' : 's'} (${isQualifying ? 'Temporary' : 'Disqualified > 24m'})`;

    mainResultDisplay.innerText = formatCurrency(totalExpense);
    subResultValue.innerText = isQualifying ? `${formatCurrency(taxRelief)} Refund` : '£0.00 (Rule Breached)';

    monthlyCostDisplay.innerText = `${formatCurrency(rent)} / mo`;
    
    if (isQualifying) {
      ruleStatusDisplay.innerText = 'Qualifies (< 24 Months)';
      ruleStatusDisplay.style.color = 'var(--success, #10b981)';
    } else {
      ruleStatusDisplay.innerText = 'Disqualified (> 24 Months Limit)';
      ruleStatusDisplay.style.color = 'var(--error, #ef4444)';
    }

    netTaxReliefDisplay.innerText = formatCurrency(taxRelief);
  }

  monthlyRentInput.addEventListener('input', () => {
    const val = parseInputVal(monthlyRentInput.value);
    monthlyRentSlider.value = String(val);
    calculate();
  });

  monthlyRentSlider.addEventListener('input', () => {
    monthlyRentInput.value = parseInt(monthlyRentSlider.value, 10).toLocaleString('en-GB');
    calculate();
  });

  durationSlider.addEventListener('input', calculate);

  calculate();
</script>
