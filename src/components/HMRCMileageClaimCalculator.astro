---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout work-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'HMRC Mileage Claim Details'}</h2>

      <!-- Business Miles -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.milesLabel || 'Annual Business Miles Driven (Car/Van)'}</span>
          <span class="hint" id="milesVal">12,000 Miles</span>
        </div>
        <div class="amount-field" style="margin-top: 0; margin-bottom: 0;">
          <input type="text" value="12,000" id="milesInput" inputmode="decimal" />
          <span class="cur">mi</span>
        </div>
        <input type="range" min="500" max="50000" step="500" value="12000" id="milesSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>500 mi</span><span>50,000 mi</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Total Approved Mileage Allowance'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£5,000.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.rateLabel || 'First 10,000 Miles Rate:'}</span>
        <span class="val" id="subResultValue">45p / mile</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:14px;">📊 {labels.breakdownTitle || 'Allowance Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row">
          <span>First 10,000 Miles (45p/mi)</span>
          <span class="val" id="first10kDisplay">£4,500.00</span>
        </div>
        <div class="breakdown-row">
          <span>Excess Miles Over 10,000 (25p/mi)</span>
          <span class="val" id="excessMilesDisplay">£500.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total HMRC Tax-Free Allowance</span>
          <span class="val" id="totalAllowanceDisplay" style="font-weight: 700; font-size: 18px;">£5,000.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const milesInput = document.getElementById('milesInput') as HTMLInputElement;
  const milesSlider = document.getElementById('milesSlider') as HTMLInputElement;
  const milesVal = document.getElementById('milesVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const first10kDisplay = document.getElementById('first10kDisplay') as HTMLElement;
  const excessMilesDisplay = document.getElementById('excessMilesDisplay') as HTMLElement;
  const totalAllowanceDisplay = document.getElementById('totalAllowanceDisplay') as HTMLElement;

  milesInput?.addEventListener('input', () => {
    const val = parseInputVal(milesInput.value);
    milesSlider.value = String(Math.min(50000, Math.max(500, val)));
    calculate();
  });

  milesSlider?.addEventListener('input', () => {
    milesInput.value = milesSlider.value;
    calculate();
  });

  function calculate() {
    if (!milesInput) return;
    const miles = parseInputVal(milesInput.value);
    if (milesVal) milesVal.textContent = `${miles.toLocaleString('en-GB')} Miles`;

    const first10k = Math.min(10000, miles) * 0.45;
    const excess = Math.max(0, miles - 10000) * 0.25;
    const total = first10k + excess;

    if (mainResultDisplay) mainResultDisplay.textContent = formatCurrency(total);
    if (subResultValue) subResultValue.textContent = '45p / mile';
    if (first10kDisplay) first10kDisplay.textContent = formatCurrency(first10k);
    if (excessMilesDisplay) excessMilesDisplay.textContent = formatCurrency(excess);
    if (totalAllowanceDisplay) totalAllowanceDisplay.textContent = formatCurrency(total);
  }

  calculate();
</script>
