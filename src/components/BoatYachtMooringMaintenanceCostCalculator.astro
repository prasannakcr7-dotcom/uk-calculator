---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout mobility-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Vessel Length Overall (LOA in Metres)</span></div>
        <div class="amount-field">
          <input type="number" id="vessel-length-metres" value="10" min="3" max="30" step="0.5" />
          <span class="cur">metres</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Marina Mooring Location & Tier</span></div>
        <select id="marina-location-tier" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="450" selected>UK South Coast Premium Marina (£450/m/year)</option>
          <option value="300">UK East/West Coast Standard Marina (£300/m/year)</option>
          <option value="180">Inland Canal / River Mooring (£180/m/year)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Annual Marine Insurance Premium (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="boat-annual-insurance" value="450" min="50" step="50" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Annual Servicing, Haul-Out & Antifouling (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="boat-annual-maintenance" value="850" min="100" step="100" />
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Boat Mooring & Maintenance Cost Breakdown</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Annual Marina Mooring Berth Fee</span>
          <strong id="annual-mooring-fee-val">£4,500.00 / year</strong>
        </div>
        <div class="breakdown-row">
          <span>Marine Insurance & Safety License</span>
          <strong id="annual-insurance-val">£450.00 / year</strong>
        </div>
        <div class="breakdown-row">
          <span>Haul-Out, Maintenance & Antifouling</span>
          <strong id="annual-maintenance-val">£850.00 / year</strong>
        </div>
        <div class="breakdown-row net">
          <span>Total Combined Annual Vessel Outlay</span>
          <strong id="total-annual-boat-running-cost">£5,800.00 / year (£483.33/mo)</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="movilidad" />
  </div>
</div>

<script>
  function calculateBoatCosts() {
    const lengthEl = document.getElementById('vessel-length-metres') as HTMLInputElement;
    const marinaEl = document.getElementById('marina-location-tier') as HTMLSelectElement;
    const insEl = document.getElementById('boat-annual-insurance') as HTMLInputElement;
    const maintEl = document.getElementById('boat-annual-maintenance') as HTMLInputElement;

    if (!lengthEl || !marinaEl || !insEl || !maintEl) return;

    const length = parseFloat(lengthEl.value) || 0;
    const ratePerMetre = parseFloat(marinaEl.value) || 450;
    const insurance = parseFloat(insEl.value) || 0;
    const maintenance = parseFloat(maintEl.value) || 0;

    const mooringFee = length * ratePerMetre;
    const totalAnnual = mooringFee + insurance + maintenance;
    const monthlyEquivalent = totalAnnual / 12;

    const mooringResEl = document.getElementById('annual-mooring-fee-val');
    const insResEl = document.getElementById('annual-insurance-val');
    const maintResEl = document.getElementById('annual-maintenance-val');
    const totalResEl = document.getElementById('total-annual-boat-running-cost');

    if (mooringResEl) mooringResEl.textContent = '£' + mooringFee.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (insResEl) insResEl.textContent = '£' + insurance.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (maintResEl) maintResEl.textContent = '£' + maintenance.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (totalResEl) totalResEl.textContent = '£' + totalAnnual.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` / year (£${monthlyEquivalent.toFixed(2)}/mo)`;
  }

  ['vessel-length-metres', 'marina-location-tier', 'boat-annual-insurance', 'boat-annual-maintenance'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateBoatCosts);
    document.getElementById(id)?.addEventListener('change', calculateBoatCosts);
  });
  calculateBoatCosts();
</script>
