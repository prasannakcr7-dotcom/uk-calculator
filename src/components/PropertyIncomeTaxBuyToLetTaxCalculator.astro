---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout taxes-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Buy-to-Let Rental Income Tax Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Annual Gross Rental Income Received (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="prop-rent-income" value="15000" min="2000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Annual Direct Allowable Property Expenses (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="prop-allowable-expenses" value="2500" min="0" step="250" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Property Income Allowance Claim (£1,000 Tax-Free Exemption)</span></div>
        <select id="prop-allowance-claim-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="actual" selected>Deduct Actual Expenses (£2,500 Expenses)</option>
          <option value="allowance">Claim £1,000 Property Allowance Instead</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Landlord Marginal Tax Band</span></div>
        <select id="prop-landlord-tax-band" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="0.20" selected>Basic Rate (20% Income Tax)</option>
          <option value="0.40">Higher Rate (40% Income Tax)</option>
          <option value="0.45">Additional Rate (45% Income Tax)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">Net Income Tax Due on Rental Profit</div>
      <div class="result-amount"><span id="mainResultDisplay">£2,500.00 / year</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Net Rental Cash After Tax:</span>
        <span class="val" id="subResultValue">£10,000.00 / year</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Rental Tax & Profit Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Gross Rental Income Received</span>
          <span class="val" id="grossRentDisplay">£15,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Total Allowable Deductions</span>
          <span class="val" id="totalDeductionsDisplay">-£2,500.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Net Taxable Rental Profit</span>
          <span class="val" id="taxableRentalProfitDisplay">£12,500.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Rental Tax Payable (20%)</span>
          <span class="val" id="netRentalTaxDisplay" style="font-weight: 700; font-size: 18px;">£2,500.00 / year (£208.33/mo)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="impuestos" />
  </div>
</div>

<script>
  function calculateRentalTax() {
    const rentEl = document.getElementById('prop-rent-income') as HTMLInputElement;
    const expEl = document.getElementById('prop-allowable-expenses') as HTMLInputElement;
    const claimEl = document.getElementById('prop-allowance-claim-select') as HTMLSelectElement;
    const bandEl = document.getElementById('prop-landlord-tax-band') as HTMLSelectElement;

    if (!rentEl || !expEl || !claimEl || !bandEl) return;

    const rent = parseFloat(rentEl.value) || 0;
    const actualExp = parseFloat(expEl.value) || 0;
    const claimType = claimEl.value;
    const taxRate = parseFloat(bandEl.value) || 0.20;

    const deductions = claimType === 'allowance' ? 1000 : actualExp;
    const taxableProfit = Math.max(0, rent - deductions);
    const taxDue = taxableProfit * taxRate;
    const netCash = rent - actualExp - taxDue;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const rentRes = document.getElementById('grossRentDisplay');
    const dedRes = document.getElementById('totalDeductionsDisplay');
    const profitRes = document.getElementById('taxableRentalProfitDisplay');
    const taxRes = document.getElementById('netRentalTaxDisplay');

    if (mainRes) mainRes.textContent = '£' + taxDue.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (subVal) subVal.textContent = '£' + netCash.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (rentRes) rentRes.textContent = '£' + rent.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (dedRes) dedRes.textContent = '-£' + deductions.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (profitRes) profitRes.textContent = '£' + taxableProfit.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (taxRes) taxRes.textContent = '£' + taxDue.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` / year (£${(taxDue/12).toFixed(2)}/mo)`;
  }

  ['prop-rent-income', 'prop-allowable-expenses', 'prop-allowance-claim-select', 'prop-landlord-tax-band'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateRentalTax);
    document.getElementById(id)?.addEventListener('change', calculateRentalTax);
  });
  calculateRentalTax();
</script>
