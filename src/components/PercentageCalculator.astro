---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout finance-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Percentage Calculation Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Percentage Rate (%)</span></div>
        <div class="amount-field">
          <input type="number" id="percentage-rate-input" value="17.5" min="0" step="0.5" />
          <span class="cur">%</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Base Base Number Amount</span></div>
        <div class="amount-field">
          <span class="cur">#</span>
          <input type="number" id="percentage-base-amount" value="480" min="0" step="10" />
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--finance-1), var(--finance-2) 80%);">
      <div class="result-label">Calculated Percentage Result Value</div>
      <div class="result-amount"><span id="mainResultDisplay">84.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Base Amount + Percentage Added:</span>
        <span class="val" id="subResultValue">564.00</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Percentage Calculation Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Percentage Value Amount (17.5% of 480)</span>
          <span class="val" id="percentValueDisplay">84.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Amount Reduced by Percentage (-17.5%)</span>
          <span class="val" id="reducedAmountDisplay">396.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Amount Increased by Percentage (+17.5%)</span>
          <span class="val" id="increasedAmountDisplay">564.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Exact Fractional Percentage Equivalent</span>
          <span class="val" id="fractionEquivalentDisplay" style="font-weight: 700; font-size: 18px;">84.00 (7/40 Fraction)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="finanzas" />
  </div>
</div>

<script>
  function calculatePercentage() {
    const rateEl = document.getElementById('percentage-rate-input') as HTMLInputElement;
    const baseEl = document.getElementById('percentage-base-amount') as HTMLInputElement;

    if (!rateEl || !baseEl) return;

    const pct = parseFloat(rateEl.value) || 0;
    const base = parseFloat(baseEl.value) || 0;

    const value = (pct / 100) * base;
    const reduced = base - value;
    const increased = base + value;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const valRes = document.getElementById('percentValueDisplay');
    const redRes = document.getElementById('reducedAmountDisplay');
    const incRes = document.getElementById('increasedAmountDisplay');
    const fracRes = document.getElementById('fractionEquivalentDisplay');

    if (mainRes) mainRes.textContent = value.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (subVal) subVal.textContent = increased.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (valRes) valRes.textContent = value.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (redRes) redRes.textContent = reduced.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (incRes) incRes.textContent = increased.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (fracRes) fracRes.textContent = value.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['percentage-rate-input', 'percentage-base-amount'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculatePercentage);
    document.getElementById(id)?.addEventListener('change', calculatePercentage);
  });
  calculatePercentage();
</script>
