---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---
<div class="layout calculator-layout work-category">
  <div class="main-col">
    <div class="card">
    

    <div class="field-group">
      <div class="field-label"><span>Property Council Tax Band (Scotland)</span></div>
      <select id="scot-council-tax-band">
        <option value="A">Band A (Ratio 240/360 = 0.667)</option>
        <option value="B">Band B (Ratio 280/360 = 0.778)</option>
        <option value="C">Band C (Ratio 320/360 = 0.889)</option>
        <option value="D" selected>Band D (Baseline Ratio 360/360 = 1.000)</option>
        <option value="E">Band E (Higher Ratio 473/360 = 1.314)</option>
        <option value="F">Band F (Higher Ratio 585/360 = 1.625)</option>
        <option value="G">Band G (Higher Ratio 705/360 = 1.958)</option>
        <option value="H">Band H (Higher Ratio 882/360 = 2.450)</option>
      </select>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Scottish Local Authority District</span></div>
      <select id="scot-local-authority">
        <option value="glasgow" selected>Glasgow City Council (Band D ~£1,499)</option>
        <option value="edinburgh">City of Edinburgh Council (Band D ~£1,448)</option>
        <option value="aberdeen">Aberdeen City Council (Band D ~£1,420)</option>
        <option value="dundee">Dundee City Council (Band D ~£1,485)</option>
        <option value="highland">Highland Council (Band D ~£1,395)</option>
      </select>
    </div>

    <div class="field-group">
      <div class="field-label"><span>Single Adult Resident (25% Discount)?</span></div>
      <select id="scot-single-person-discount">
        <option value="no" selected>No (2+ Adult Household)</option>
        <option value="yes">Yes (25% Single Person Discount)</option>
      </select>
    </div>

    

    <div class="card breakdown-card" id="results-card" style="display: none;">
      <div class="breakdown-row net">
        <span>Estimated Total Annual Bill (inc. Water/Sewerage):</span>
        <strong id="scot-total-annual-counciltax">£0.00 / year</strong>
      </div>
      <div class="breakdown-row net">
        <span>Monthly Direct Debit (10 Payments):</span>
        <strong id="scot-monthly-counciltax">£0.00 / month</strong>
      </div>
      <div class="breakdown-row">
        <span>Property Band Ratio Multiplier:</span>
        <strong id="scot-band-ratio-multiplier">1.000 (Band D Baseline)</strong>
      </div>
      <div class="breakdown-row">
        <span>Estimated Scottish Water & Sewerage Charge:</span>
        <strong id="scot-water-sewerage-charge">~£520.00 / year</strong>
      
  </div>
</div>

<script>
  function calculateScotCouncilTax() {
    const band = (document.getElementById('scot-council-tax-band') as HTMLSelectElement).value;
    const council = (document.getElementById('scot-local-authority') as HTMLSelectElement).value;
    const isSingle = (document.getElementById('scot-single-person-discount') as HTMLSelectElement).value === 'yes';

    // Baseline Band D rates in Scotland (2026/27 averages):
    let bandDBase = 1499.0;
    if (council === 'edinburgh') bandDBase = 1448.0;
    else if (council === 'aberdeen') bandDBase = 1420.0;
    else if (council === 'dundee') bandDBase = 1485.0;
    else if (council === 'highland') bandDBase = 1395.0;

    // Scottish Statutory Ratio Multipliers (Re-weighted in 2017 for Bands E-H):
    // Band A: 240/360 = 0.6667
    // Band B: 280/360 = 0.7778
    // Band C: 320/360 = 0.8889
    // Band D: 360/360 = 1.0000
    // Band E: 473/360 = 1.3139
    // Band F: 585/360 = 1.6250
    // Band G: 705/360 = 1.9583
    // Band H: 882/360 = 2.4500

    let ratio = 1.0;
    if (band === 'A') ratio = 240 / 360;
    else if (band === 'B') ratio = 280 / 360;
    else if (band === 'C') ratio = 320 / 360;
    else if (band === 'D') ratio = 360 / 360;
    else if (band === 'E') ratio = 473 / 360;
    else if (band === 'F') ratio = 585 / 360;
    else if (band === 'G') ratio = 705 / 360;
    else if (band === 'H') ratio = 882 / 360;

    let baseCouncilTax = bandDBase * ratio;
    if (isSingle) {
      baseCouncilTax *= 0.75;
    }

    // Scottish Water & Sewerage charges (collected via council tax bill): approx £420 - £650 depending on band
    const waterCharge = 520.0 * ratio;

    const totalAnnual = baseCouncilTax + waterCharge;
    const monthly10 = totalAnnual / 10;

    (document.getElementById('scot-total-annual-counciltax') as HTMLElement).textContent = '£' + totalAnnual.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    (document.getElementById('scot-monthly-counciltax') as HTMLElement).textContent = '£' + monthly10.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month (10 instalments)';
    (document.getElementById('scot-band-ratio-multiplier') as HTMLElement).textContent = ratio.toFixed(3) + ' (Band ' + band + ' ratio)';
    (document.getElementById('scot-water-sewerage-charge') as HTMLElement).textContent = '£' + waterCharge.toFixed(2) + ' / year (Collected by council for Scottish Water)';

    (document.getElementById('results-card') as HTMLElement).style.display = 'block';
  }

  document.getElementById('calc-btn')?.addEventListener('click', calculateScotCouncilTax);
  calculateScotCouncilTax();
</script>


    
    <slot />
  </div>
  <div class="side-col">
    <Sidebar />
  </div>
</div>
