---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout family-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Spousal Maintenance Income Details'}</h2>

      <!-- Payer Income -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.payerLabel || 'Payer Net Monthly Income'}</span>
          <span class="hint" id="payerVal">£3,500.00</span>
        </div>
        <div class="amount-field" style="margin-top: 0; margin-bottom: 0;">
          <input type="text" value="3,500" id="payerIncomeInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="1000" max="10000" step="100" value="3500" id="payerIncomeSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£1,000/mo</span><span>£10,000/mo</span></div>
      </div>

      <!-- Recipient Income -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.recipientLabel || 'Recipient Net Monthly Income'}</span>
          <span class="hint" id="recipientVal">£1,500.00</span>
        </div>
        <div class="amount-field" style="margin-top: 0; margin-bottom: 0;">
          <input type="text" value="1,500" id="recipientIncomeInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="0" max="8000" step="100" value="1500" id="recipientIncomeSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£0/mo</span><span>£8,000/mo</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--family-1), var(--family-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Estimated Monthly Spousal Maintenance'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£600.00/mo</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.annualLabel || 'Annual Equivalent:'}</span>
        <span class="val" id="subResultValue">£7,200.00/yr</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Income Differential Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Payer Net Monthly Income</span>
          <span class="val" id="payerNetDisplay">£3,500.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Recipient Net Monthly Income</span>
          <span class="val" id="recipientNetDisplay">£1,500.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Net Income Gap</span>
          <span class="val" id="incomeGapDisplay">£2,000.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Estimated Monthly Maintenance (30% Gap)</span>
          <span class="val" id="monthlyMaintDisplay" style="font-weight: 700; font-size: 18px;">£600.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • Based on <strong>25%–33%</strong> of net income gap.<br/>
        • Adjusts for duration of marriage and caring responsibilities.<br/>
        • Maintenance is non-taxable income for the recipient.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const payerIncomeInput = document.getElementById('payerIncomeInput') as HTMLInputElement;
  const payerIncomeSlider = document.getElementById('payerIncomeSlider') as HTMLInputElement;
  const payerVal = document.getElementById('payerVal') as HTMLElement;
  const recipientIncomeInput = document.getElementById('recipientIncomeInput') as HTMLInputElement;
  const recipientIncomeSlider = document.getElementById('recipientIncomeSlider') as HTMLInputElement;
  const recipientVal = document.getElementById('recipientVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const payerNetDisplay = document.getElementById('payerNetDisplay') as HTMLElement;
  const recipientNetDisplay = document.getElementById('recipientNetDisplay') as HTMLElement;
  const incomeGapDisplay = document.getElementById('incomeGapDisplay') as HTMLElement;
  const monthlyMaintDisplay = document.getElementById('monthlyMaintDisplay') as HTMLElement;

  payerIncomeInput.addEventListener('input', () => {
    const val = parseInputVal(payerIncomeInput.value);
    payerIncomeSlider.value = String(Math.min(10000, Math.max(1000, val)));
    calculate();
  });

  payerIncomeSlider.addEventListener('input', () => {
    payerIncomeInput.value = payerIncomeSlider.value;
    calculate();
  });

  recipientIncomeInput.addEventListener('input', () => {
    const val = parseInputVal(recipientIncomeInput.value);
    recipientIncomeSlider.value = String(Math.min(8000, Math.max(0, val)));
    calculate();
  });

  recipientIncomeSlider.addEventListener('input', () => {
    recipientIncomeInput.value = recipientIncomeSlider.value;
    calculate();
  });

  function calculate() {
    const payer = parseInputVal(payerIncomeInput.value);
    const recipient = parseInputVal(recipientIncomeInput.value);

    payerVal.textContent = formatCurrency(payer);
    recipientVal.textContent = formatCurrency(recipient);

    const gap = Math.max(0, payer - recipient);
    const monthly = gap * 0.30;
    const annual = monthly * 12;

    mainResultDisplay.textContent = `${formatCurrency(monthly)}/mo`;
    subResultValue.textContent = `${formatCurrency(annual)}/yr`;
    payerNetDisplay.textContent = formatCurrency(payer);
    recipientNetDisplay.textContent = formatCurrency(recipient);
    incomeGapDisplay.textContent = formatCurrency(gap);
    monthlyMaintDisplay.textContent = formatCurrency(monthly);
  }

  calculate();
</script>
