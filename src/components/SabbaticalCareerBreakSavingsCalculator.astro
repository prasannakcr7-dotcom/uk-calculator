---
import Sidebar from './Sidebar.astro';
interface Props {
  labels: Record<string, any>;
  lang?: string;
}

const { labels } = Astro.props;
---

<div class="layout calculator-layout work-category" data-labels={JSON.stringify(labels)}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'Sabbatical & Living Budget Details'}</h2>

      <!-- Sabbatical Months -->
      <div class="field-group">
        <div class="field-label">
          <span>{labels.breakMonthsLabel || 'Sabbatical Duration (Months)'}</span>
          <span class="hint" id="breakMonthsVal">6 Months</span>
        </div>
        <input type="range" min="1" max="24" step="1" value="6" id="breakMonthsSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>1 Month</span><span>24 Months</span></div>
      </div>

      <!-- Monthly Cost -->
      <div class="field-group" style="margin-top: 24px;">
        <div class="field-label">
          <span>{labels.monthlyCostLabel || 'Monthly Expense Budget (£)'}</span>
          <span class="hint" id="monthlyCostVal">£1,800.00</span>
        </div>
        <div class="amount-field" style="margin-top: 0; margin-bottom: 0;">
          <input type="text" value="1,800" id="monthlyCostInput" inputmode="decimal" />
          <span class="cur">£</span>
        </div>
        <input type="range" min="500" max="5000" step="100" value="1800" id="monthlyCostSlider" style="width:100%; margin-top:10px;" />
        <div class="range-labels"><span>£500/mo</span><span>£5,000/mo</span></div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">{labels.resultLabel || 'Required Sabbatical Savings Fund Target'}</div>
      <div class="result-amount"><span id="mainResultDisplay">£10,800.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">{labels.budgetLabel || 'Monthly Living Budget:'}</span>
        <span class="val" id="subResultValue">£1,800.00/mo</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 {labels.breakdownTitle || 'Savings Fund Breakdown'}</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Planned Sabbatical Duration</span>
          <span class="val" id="monthsDisplay">6 Months</span>
        </div>
        <div class="breakdown-row section">
          <span>Monthly Expense Budget</span>
          <span class="val" id="monthlyBudgetDisplay">£1,800.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Emergency & Savings Fund Target</span>
          <span class="val" id="totalTargetDisplay" style="font-weight: 700; font-size: 18px;">£10,800.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="side-col">
    <Sidebar />
</div>
      <p style="font-size:13px; line-height:1.5; color:rgba(26,46,40,0.7); margin-bottom:8px;">
        • Include emergency reserve (+10%–15%).<br/>
        • Check pension contribution pause impacts.<br/>
        • Ensure continuous health and travel insurance coverage.
      </p>
    </div>
  </div>
</div>

<script>
  function parseInputVal(str: string): number {
    const clean = str.replace(/[^\d.-]/g, '');
    if (clean === '') return 0;
    return parseFloat(clean) || 0;
  }

  function formatCurrency(val: number): string {
    return val.toLocaleString('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2 });
  }

  const breakMonthsSlider = document.getElementById('breakMonthsSlider') as HTMLInputElement;
  const breakMonthsVal = document.getElementById('breakMonthsVal') as HTMLElement;
  const monthlyCostInput = document.getElementById('monthlyCostInput') as HTMLInputElement;
  const monthlyCostSlider = document.getElementById('monthlyCostSlider') as HTMLInputElement;
  const monthlyCostVal = document.getElementById('monthlyCostVal') as HTMLElement;

  const mainResultDisplay = document.getElementById('mainResultDisplay') as HTMLElement;
  const subResultValue = document.getElementById('subResultValue') as HTMLElement;
  const monthsDisplay = document.getElementById('monthsDisplay') as HTMLElement;
  const monthlyBudgetDisplay = document.getElementById('monthlyBudgetDisplay') as HTMLElement;
  const totalTargetDisplay = document.getElementById('totalTargetDisplay') as HTMLElement;

  breakMonthsSlider.addEventListener('input', calculate);

  monthlyCostInput.addEventListener('input', () => {
    const val = parseInputVal(monthlyCostInput.value);
    monthlyCostSlider.value = String(Math.min(5000, Math.max(500, val)));
    calculate();
  });

  monthlyCostSlider.addEventListener('input', () => {
    monthlyCostInput.value = monthlyCostSlider.value;
    calculate();
  });

  function calculate() {
    const mos = parseInt(breakMonthsSlider.value, 10);
    const cost = parseInputVal(monthlyCostInput.value);

    breakMonthsVal.textContent = `${mos} Months`;
    monthlyCostVal.textContent = formatCurrency(cost);

    const total = mos * cost;

    mainResultDisplay.textContent = formatCurrency(total);
    subResultValue.textContent = `${formatCurrency(cost)}/mo`;
    monthsDisplay.textContent = `${mos} Months`;
    monthlyBudgetDisplay.textContent = formatCurrency(cost);
    totalTargetDisplay.textContent = formatCurrency(total);
  }

  calculate();
</script>
