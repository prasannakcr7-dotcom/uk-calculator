---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Appliance Power Rating (Watts - W)</span></div>
        <div class="amount-field">
          <input type="number" id="appliance-power-watts" value="2000" min="5" step="50" />
          <span class="cur">Watts</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Hours Used Per Day</span></div>
        <div class="amount-field">
          <input type="number" id="daily-hours-used" value="2.5" min="0.1" max="24" step="0.5" />
          <span class="cur">hrs/day</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Electricity Unit Rate (Pence per kWh)</span></div>
        <div class="amount-field">
          <input type="number" id="kwh-unit-rate-pence" value="24.5" min="5" max="80" step="0.5" />
          <span class="cur">p/kWh</span>
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Appliance Running Cost Breakdown</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Daily Electricity Consumption (kWh)</span>
          <strong id="daily-kwh-consumption">5.00 kWh / day</strong>
        </div>
        <div class="breakdown-row">
          <span>Cost Per Hour of Use</span>
          <strong id="cost-per-hour-pence">49.0p / hour</strong>
        </div>
        <div class="breakdown-row">
          <span>Monthly Running Cost (30 days)</span>
          <strong id="monthly-running-cost">£36.75 / month</strong>
        </div>
        <div class="breakdown-row net">
          <span>Annual Appliance Running Cost</span>
          <strong id="annual-running-cost">£447.13 / year</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="vivienda" />
  </div>
</div>

<script>
  function calculateApplianceElectricityCost() {
    const wattsEl = document.getElementById('appliance-power-watts') as HTMLInputElement;
    const hoursEl = document.getElementById('daily-hours-used') as HTMLInputElement;
    const rateEl = document.getElementById('kwh-unit-rate-pence') as HTMLInputElement;

    if (!wattsEl || !hoursEl || !rateEl) return;

    const watts = parseFloat(wattsEl.value) || 0;
    const hours = parseFloat(hoursEl.value) || 0;
    const unitRatePence = parseFloat(rateEl.value) || 24.5;

    const kw = watts / 1000;
    const dailyKwh = kw * hours;
    const unitRateGbp = unitRatePence / 100;

    const costPerHour = kw * unitRateGbp;
    const dailyCost = dailyKwh * unitRateGbp;
    const monthlyCost = dailyCost * 30.4375;
    const annualCost = dailyCost * 365;

    const kwhEl = document.getElementById('daily-kwh-consumption');
    const hourEl = document.getElementById('cost-per-hour-pence');
    const monthEl = document.getElementById('monthly-running-cost');
    const annualEl = document.getElementById('annual-running-cost');

    if (kwhEl) kwhEl.textContent = dailyKwh.toFixed(2) + ' kWh / day';
    if (hourEl) hourEl.textContent = (costPerHour * 100).toFixed(1) + 'p / hour';
    if (monthEl) monthEl.textContent = '£' + monthlyCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (annualEl) annualEl.textContent = '£' + annualCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
  }

  ['appliance-power-watts', 'daily-hours-used', 'kwh-unit-rate-pence'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateApplianceElectricityCost);
    document.getElementById(id)?.addEventListener('change', calculateApplianceElectricityCost);
  });
  calculateApplianceElectricityCost();
</script>
