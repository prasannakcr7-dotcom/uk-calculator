---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout finance-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Bitcoin Amount (BTC)</span></div>
        <div class="amount-field">
          <input type="number" id="btc-amount" value="0.25" min="0.0001" step="0.01" />
          <span class="cur">BTC</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Current Bitcoin Price in GBP (£ per BTC)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="btc-gbp-price" value="52000" min="1000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Original Acquisition Cost Basis (£ Total)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="original-btc-cost" value="6000" min="0" step="500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Crypto Exchange Trading Fee (%)</span></div>
        <div class="amount-field">
          <input type="number" id="exchange-fee-pct" value="0.5" min="0" max="5" step="0.1" />
          <span class="cur">%</span>
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Conversion & Capital Gains Summary</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Gross Sterling Value (GBP)</span>
          <strong id="gross-gbp-val">£13,000.00</strong>
        </div>
        <div class="breakdown-row">
          <span>Exchange Fee Deduction</span>
          <strong id="exchange-fee-deducted">-£65.00</strong>
        </div>
        <div class="breakdown-row">
          <span>Realized Capital Gain</span>
          <strong id="realized-btc-gain">£6,935.00</strong>
        </div>
        <div class="breakdown-row">
          <span>Estimated CGT Payable (after £3k allowance)</span>
          <strong id="estimated-btc-cgt">£393.50 (10% Basic Rate)</strong>
        </div>
        <div class="breakdown-row net">
          <span>Net GBP Received</span>
          <strong id="net-gbp-received">£12,935.00</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="finanzas" />
  </div>
</div>

<script>
  function calculateBtcGbp() {
    const btcEl = document.getElementById('btc-amount') as HTMLInputElement;
    const priceEl = document.getElementById('btc-gbp-price') as HTMLInputElement;
    const costEl = document.getElementById('original-btc-cost') as HTMLInputElement;
    const feeEl = document.getElementById('exchange-fee-pct') as HTMLInputElement;

    if (!btcEl || !priceEl || !costEl || !feeEl) return;

    const btc = parseFloat(btcEl.value) || 0;
    const price = parseFloat(priceEl.value) || 0;
    const cost = parseFloat(costEl.value) || 0;
    const feePct = parseFloat(feeEl.value) || 0;

    const grossGbp = btc * price;
    const feeVal = grossGbp * (feePct / 100);
    const netGbp = Math.max(0, grossGbp - feeVal);

    const grossGain = Math.max(0, netGbp - cost);
    const annualAllowance = 3000;
    const taxableGain = Math.max(0, grossGain - annualAllowance);
    const estimatedCgt = taxableGain * 0.10;

    const grossEl = document.getElementById('gross-gbp-val');
    const feeDeductEl = document.getElementById('exchange-fee-deducted');
    const netGbpEl = document.getElementById('net-gbp-received');
    const gainEl = document.getElementById('realized-btc-gain');
    const cgtEl = document.getElementById('estimated-btc-cgt');

    if (grossEl) grossEl.textContent = '£' + grossGbp.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (feeDeductEl) feeDeductEl.textContent = '-£' + feeVal.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (netGbpEl) netGbpEl.textContent = '£' + netGbp.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (gainEl) gainEl.textContent = '£' + grossGain.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (cgtEl) cgtEl.textContent = '£' + estimatedCgt.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (10% Basic Rate)';
  }

  ['btc-amount', 'btc-gbp-price', 'original-btc-cost', 'exchange-fee-pct'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateBtcGbp);
    document.getElementById(id)?.addEventListener('change', calculateBtcGbp);
  });
  calculateBtcGbp();
</script>
