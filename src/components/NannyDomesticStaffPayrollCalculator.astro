---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout work-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Nanny & Domestic Staff Payroll Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Agreed Gross Annual Nanny Salary (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="nanny-gross-salary" value="32000" min="5000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Workplace Pension Auto-Enrolment Employer Contribution (% min 3%)</span></div>
        <div class="amount-field">
          <input type="number" id="nanny-pension-contribution-pct" value="3.0" min="0" max="10" step="0.5" />
          <span class="cur">%</span>
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--work-1), var(--work-2) 80%);">
      <div class="result-label">Total Employer Annual Cost of Employing Nanny</div>
      <div class="result-amount"><span id="mainResultDisplay">£34,815.00 / year</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Monthly Total Employer Cost:</span>
        <span class="val" id="subResultValue">£2,901.25 / month</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Employer Nanny Payroll Cost Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Agreed Nanny Gross Salary</span>
          <span class="val" id="agreedGrossSalaryDisplay">£32,000.00 / year</span>
        </div>
        <div class="breakdown-row section">
          <span>Employer Class 1A National Insurance (13.8% above £9,100)</span>
          <span class="val" id="employerNiDisplay">£3,160.20 / year</span>
        </div>
        <div class="breakdown-row section">
          <span>Employer Workplace Pension Contribution (3%)</span>
          <span class="val" id="employerPensionDisplay">£655.00 / year</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Annual Employer Budget Required</span>
          <span class="val" id="totalEmployerCostDisplay" style="font-weight: 700; font-size: 18px;">£35,815.20 / year (£2,984.60/mo)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="trabajo" />
  </div>
</div>

<script>
  function calculateNannyPayroll() {
    const salaryEl = document.getElementById('nanny-gross-salary') as HTMLInputElement;
    const pensionEl = document.getElementById('nanny-pension-contribution-pct') as HTMLInputElement;

    if (!salaryEl || !pensionEl) return;

    const grossSalary = parseFloat(salaryEl.value) || 0;
    const pensionPct = (parseFloat(pensionEl.value) || 3.0) / 100;

    // Employer NI 2026/27: 13.8% on earnings above £9,100 Secondary Threshold
    const employerNi = Math.max(0, (grossSalary - 9100) * 0.138);

    // Pension: 3% on qualifying earnings (£6,240 to £50,270)
    const qualifyingEarnings = Math.min(50270, Math.max(0, grossSalary - 6240));
    const employerPension = qualifyingEarnings * pensionPct;

    const totalEmployerCost = grossSalary + employerNi + employerPension;
    const monthlyCost = totalEmployerCost / 12;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const grossRes = document.getElementById('agreedGrossSalaryDisplay');
    const niRes = document.getElementById('employerNiDisplay');
    const pensionRes = document.getElementById('employerPensionDisplay');
    const totalRes = document.getElementById('totalEmployerCostDisplay');

    if (mainRes) mainRes.textContent = '£' + totalEmployerCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (subVal) subVal.textContent = '£' + monthlyCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (grossRes) grossRes.textContent = '£' + grossSalary.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (niRes) niRes.textContent = '£' + employerNi.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (pensionRes) pensionRes.textContent = '£' + employerPension.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (totalRes) totalRes.textContent = '£' + totalEmployerCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` / year (£${monthlyCost.toFixed(2)}/mo)`;
  }

  ['nanny-gross-salary', 'nanny-pension-contribution-pct'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateNannyPayroll);
    document.getElementById(id)?.addEventListener('change', calculateNannyPayroll);
  });
  calculateNannyPayroll();
</script>
