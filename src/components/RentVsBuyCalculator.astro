---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Rent vs Buy Property Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Current Monthly Rent Payment (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="rentvsbuy-monthly-rent" value="1350" min="200" step="50" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Target Property Purchase Price (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="rentvsbuy-property-price" value="280000" min="50000" step="5000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Deposit Amount (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="rentvsbuy-deposit" value="42000" min="5000" step="2500" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Mortgage Interest Rate (% p.a.)</span></div>
        <div class="amount-field">
          <input type="number" id="rentvsbuy-mortgage-rate" value="4.5" min="0.5" max="15" step="0.1" />
          <span class="cur">%</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Comparison Period (Years)</span></div>
        <div class="amount-field">
          <input type="number" id="rentvsbuy-horizon-years" value="5" min="1" max="25" step="1" />
          <span class="cur">yrs</span>
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--housing-1), var(--housing-2) 80%);">
      <div class="result-label">Net Wealth Advantage Over Comparison Period</div>
      <div class="result-amount"><span id="mainResultDisplay">Buying saves £18,450.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Monthly Payment Difference:</span>
        <span class="val" id="subResultValue">Buying is £27.65/mo cheaper</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Rent vs Buy Cost & Wealth Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Total Rent Paid Over Period</span>
          <span class="val" id="totalRentPaidDisplay">£81,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Total Mortgage Repayments Paid</span>
          <span class="val" id="totalMortgagePaidDisplay">£79,341.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Home Equity Accumulated (Capital Paid Off)</span>
          <span class="val" id="homeEquityGainedDisplay">£26,109.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Financial Advantage of Buying</span>
          <span class="val" id="netBuyingAdvantageDisplay" style="font-weight: 700; font-size: 18px;">+£18,450.00 overall wealth</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="vivienda" />
  </div>
</div>

<script>
  function calculateRentVsBuy() {
    const rentEl = document.getElementById('rentvsbuy-monthly-rent') as HTMLInputElement;
    const priceEl = document.getElementById('rentvsbuy-property-price') as HTMLInputElement;
    const depositEl = document.getElementById('rentvsbuy-deposit') as HTMLInputElement;
    const rateEl = document.getElementById('rentvsbuy-mortgage-rate') as HTMLInputElement;
    const horizonEl = document.getElementById('rentvsbuy-horizon-years') as HTMLInputElement;

    if (!rentEl || !priceEl || !depositEl || !rateEl || !horizonEl) return;

    const rent = parseFloat(rentEl.value) || 0;
    const price = parseFloat(priceEl.value) || 0;
    const deposit = parseFloat(depositEl.value) || 0;
    const rate = (parseFloat(rateEl.value) || 0) / 100;
    const years = parseInt(horizonEl.value) || 5;

    const loan = Math.max(0, price - deposit);
    const r = rate / 12;
    const n = 25 * 12; // 25-year base mortgage term
    const monthlyMortgage = r > 0 ? loan * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1) : loan / n;

    const totalRent = rent * 12 * years;
    const totalMortgage = monthlyMortgage * 12 * years;

    // Simulate capital paid off in 'years'
    let balance = loan;
    for (let m = 1; m <= years * 12; m++) {
      const interestMonth = balance * r;
      const principalMonth = monthlyMortgage - interestMonth;
      balance -= principalMonth;
    }
    const equityGained = Math.max(0, loan - balance);

    // Net buying advantage = Equity gained - (Mortgage total - Rent total)
    const netBuyingAdvantage = equityGained - (totalMortgage - totalRent);
    const monthlyDiff = rent - monthlyMortgage;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const rentRes = document.getElementById('totalRentPaidDisplay');
    const mortRes = document.getElementById('totalMortgagePaidDisplay');
    const eqRes = document.getElementById('homeEquityGainedDisplay');
    const advRes = document.getElementById('netBuyingAdvantageDisplay');

    if (mainRes) mainRes.textContent = netBuyingAdvantage >= 0 ? 'Buying saves £' + netBuyingAdvantage.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : 'Renting saves £' + Math.abs(netBuyingAdvantage).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (subVal) subVal.textContent = monthlyDiff >= 0 ? `Buying is £${monthlyDiff.toFixed(2)}/mo cheaper` : `Renting is £${Math.abs(monthlyDiff).toFixed(2)}/mo cheaper`;
    if (rentRes) rentRes.textContent = '£' + totalRent.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (mortRes) mortRes.textContent = '£' + totalMortgage.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (eqRes) eqRes.textContent = '£' + equityGained.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (advRes) advRes.textContent = netBuyingAdvantage >= 0 ? '+£' + netBuyingAdvantage.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' overall wealth' : '-£' + Math.abs(netBuyingAdvantage).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' overall wealth';
  }

  ['rentvsbuy-monthly-rent', 'rentvsbuy-property-price', 'rentvsbuy-deposit', 'rentvsbuy-mortgage-rate', 'rentvsbuy-horizon-years'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateRentVsBuy);
    document.getElementById(id)?.addEventListener('change', calculateRentVsBuy);
  });
  calculateRentVsBuy();
</script>
