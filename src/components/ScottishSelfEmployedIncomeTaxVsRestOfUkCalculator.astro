---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---
<div class="layout calculator-layout work-category">
  <div class="main-col">
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Annual Taxable Self-Employed Profit / Gross Salary (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="annual-taxable-income-scot" value="48000" min="10000" step="1000" />
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Annual Income Tax Comparison (rUK vs Scotland)</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Scottish Income Tax Liability:</span>
          <strong id="scot-income-tax-total-val">£0.00 / year</strong>
        </div>
        <div class="breakdown-row">
          <span>Rest of UK (rUK) Income Tax Liability:</span>
          <strong id="ruk-income-tax-total-val">£0.00 / year</strong>
        </div>
        <div class="breakdown-row">
          <span>Scottish Marginal Tax Bracket:</span>
          <strong id="scot-marginal-tax-bracket-str">Intermediate Rate (21%)</strong>
        </div>
        <div class="breakdown-row net">
          <span>Annual Tax Difference:</span>
          <strong id="scot-vs-ruk-tax-difference">Loading...</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar />
  </div>
</div>

<script>
  function calculateScottishTaxDiff() {
    const grossEl = document.getElementById('annual-taxable-income-scot') as HTMLInputElement;
    if (!grossEl) return;

    const gross = parseFloat(grossEl.value) || 0;

    // Personal Allowance with £100k tapering:
    let pa = 12570;
    if (gross > 100000) {
      pa = Math.max(0, 12570 - ((gross - 100000) / 2));
    }

    const taxable = Math.max(0, gross - pa);

    // Rest of UK (rUK) Income Tax Rates 2026/27:
    // Basic Rate 20%: £0 - £37,700 (over PA)
    // Higher Rate 40%: £37,701 - £112,570 (since £125,140 upper limit with PA is £112,570 taxable)
    // Additional Rate 45%: Over £112,570 taxable
    let rukTax = 0;
    if (taxable > 112570) {
      rukTax += 37700 * 0.20;
      rukTax += (112570 - 37700) * 0.40;
      rukTax += (taxable - 112570) * 0.45;
    } else if (taxable > 37700) {
      rukTax += 37700 * 0.20;
      rukTax += (taxable - 37700) * 0.40;
    } else {
      rukTax += taxable * 0.20;
    }

    // Scottish Income Tax Bands 2026/27 (6 Tiers):
    // Starter Rate 19%: £12,571 - £16,537 (Taxable £1 - £3,967)
    // Basic Rate 20%: £16,538 - £29,526 (Taxable £3,968 - £16,956)
    // Intermediate Rate 21%: £29,527 - £43,662 (Taxable £16,957 - £31,092)
    // Higher Rate 42%: £43,663 - £75,000 (Taxable £31,093 - £62,430)
    // Advanced Rate 45%: £75,001 - £125,140 (Taxable £62,431 - £112,570)
    // Top Rate 48%: Over £125,140 (Taxable over £112,570)

    let scotTax = 0;
    let scotBracket = '';

    if (gross > 125140) {
      scotBracket = 'Top Rate (48%)';
      scotTax += 3967 * 0.19;
      scotTax += (16956 - 3967) * 0.20;
      scotTax += (31092 - 16956) * 0.21;
      scotTax += (62430 - 31092) * 0.42;
      scotTax += (112570 - 62430) * 0.45;
      scotTax += (taxable - 112570) * 0.48;
    } else if (gross > 75000) {
      scotBracket = 'Advanced Rate (45%)';
      scotTax += 3967 * 0.19;
      scotTax += (16956 - 3967) * 0.20;
      scotTax += (31092 - 16956) * 0.21;
      scotTax += (62430 - 31092) * 0.42;
      scotTax += (taxable - 62430) * 0.45;
    } else if (gross > 43662) {
      scotBracket = 'Higher Rate (42%)';
      scotTax += 3967 * 0.19;
      scotTax += (16956 - 3967) * 0.20;
      scotTax += (31092 - 16956) * 0.21;
      scotTax += (taxable - 31092) * 0.42;
    } else if (gross > 29526) {
      scotBracket = 'Intermediate Rate (21%)';
      scotTax += 3967 * 0.19;
      scotTax += (16956 - 3967) * 0.20;
      scotTax += (taxable - 16956) * 0.21;
    } else if (gross > 16537) {
      scotBracket = 'Basic Rate (20%)';
      scotTax += 3967 * 0.19;
      scotTax += (taxable - 3967) * 0.20;
    } else if (gross > 12570) {
      scotBracket = 'Starter Rate (19%)';
      scotTax += taxable * 0.19;
    } else {
      scotBracket = 'Personal Allowance (0%)';
      scotTax = 0;
    }

    const diff = Math.abs(scotTax - rukTax);
    let diffStr = '';
    if (scotTax > rukTax) {
      diffStr = '🔴 Pay £' + diff.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MORE tax per year in Scotland than Rest of UK';
    } else if (rukTax > scotTax) {
      diffStr = '🟢 Pay £' + diff.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' LESS tax per year in Scotland than Rest of UK';
    } else {
      diffStr = 'Income tax is identical in Scotland and Rest of UK';
    }

    const scotTotalEl = document.getElementById('scot-income-tax-total-val');
    const rukTotalEl = document.getElementById('ruk-income-tax-total-val');
    const diffEl = document.getElementById('scot-vs-ruk-tax-difference');
    const bracketEl = document.getElementById('scot-marginal-tax-bracket-str');

    if (scotTotalEl) scotTotalEl.textContent = '£' + scotTax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (rukTotalEl) rukTotalEl.textContent = '£' + rukTax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (diffEl) diffEl.textContent = diffStr;
    if (bracketEl) bracketEl.textContent = scotBracket;
  }

  ['annual-taxable-income-scot'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateScottishTaxDiff);
    document.getElementById(id)?.addEventListener('change', calculateScottishTaxDiff);
  });
  calculateScottishTaxDiff();
</script>
