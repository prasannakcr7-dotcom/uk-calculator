---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
  nation?: string;
}

const { labels = {}, lang = 'en', nation = 'england' } = Astro.props;
---

<div class="layout calculator-layout finance-category" data-labels={JSON.stringify(labels)} data-nation={nation}>
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>{labels.inputTitle || 'SIPP Tax Relief & Regional Tax Savings Calculator (2026/27)'}</h2>
      <p style="color: rgba(26,46,40,0.7); font-size: 14px; margin-bottom: 20px;">Calculate pension tax relief for UK taxpayers, including Scottish income tax bands (Starter, Basic, Intermediate, Higher, Advanced, Top).</p>

      <div class="field-group">
        <label class="field-label" for="gross-salary">Annual Taxable Earnings (£)</label>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="gross-salary" value="55000" min="10000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <label class="field-label" for="tax-region">Taxation Jurisdiction / Nation</label>
        <select id="tax-region" class="fancy" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="rUK" selected={nation !== 'scotland'}>England, Wales & Northern Ireland (rUK)</option>
          <option value="scotland" selected={nation === 'scotland'}>Scotland (Scottish Tax Bands)</option>
        </select>
      </div>

      <div class="field-group">
        <label class="field-label" for="pension-payment-net">Proposed Net Personal SIPP Payment (£)</label>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="pension-payment-net" value="4000" min="100" step="100" />
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--finance-1), var(--finance-2) 80%); margin-top: 24px;">
      <div class="result-label">Gross Addition to SIPP</div>
      <div class="result-amount"><span id="gross-addition">£5,000.00</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span>True Net Out-of-Pocket Cost:</span>
        <span class="val" id="true-net-cost">£3,000.00</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="margin-top: 24px;">
      <h2 style="margin-bottom:14px;">📊 SIPP Tax Relief Breakdown</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Automatic Basic Provider Relief (20%):</span>
          <span class="val" id="provider-relief">£1,000.00</span>
        </div>
        <div class="breakdown-row">
          <span>Additional Tax Claimable from HMRC:</span>
          <span class="val" id="hmrc-claimable">£1,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Total Government Tax Relief Benefit:</span>
          <span class="val" id="total-tax-benefit">£2,000.00</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="finanzas" currentSlug="sipp-tax-relief-pension-contribution-calculator" />
  </div>
</div>

<script>
  function calculateRegionalSippRelief() {
    const salaryEl = document.getElementById('gross-salary') as HTMLInputElement;
    const regionEl = document.getElementById('tax-region') as HTMLSelectElement;
    const netPaymentEl = document.getElementById('pension-payment-net') as HTMLInputElement;

    if (!salaryEl || !regionEl || !netPaymentEl) return;

    const salary = parseFloat(salaryEl.value) || 0;
    const region = regionEl.value;
    const netPayment = parseFloat(netPaymentEl.value) || 0;

    // Automatic 20% provider relief adds 25% to net payment
    const grossAddition = netPayment / 0.8;
    const providerRelief = grossAddition - netPayment;

    let marginalRate = 20;

    if (region === 'scotland') {
      if (salary > 125140) marginalRate = 48; // Top Rate
      else if (salary > 75000) marginalRate = 45; // Advanced Rate
      else if (salary > 43663) marginalRate = 42; // Higher Rate
      else if (salary > 29526) marginalRate = 21; // Intermediate Rate
      else if (salary > 16537) marginalRate = 20; // Basic Rate
      else marginalRate = 19; // Starter Rate
    } else {
      if (salary > 125140) marginalRate = 45;
      else if (salary > 50270) marginalRate = 40;
      else marginalRate = 20;
    }

    const extraReliefPct = Math.max(0, marginalRate - 20);
    const hmrcClaimable = grossAddition * (extraReliefPct / 100);
    const totalTaxBenefit = providerRelief + hmrcClaimable;
    const trueNetCost = netPayment - hmrcClaimable;

    const grossAddEl = document.getElementById('gross-addition');
    const provReliefEl = document.getElementById('provider-relief');
    const hmrcClaimEl = document.getElementById('hmrc-claimable');
    const totalBenefitEl = document.getElementById('total-tax-benefit');
    const netCostEl = document.getElementById('true-net-cost');

    if (grossAddEl) grossAddEl.textContent = '£' + grossAddition.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (provReliefEl) provReliefEl.textContent = '£' + providerRelief.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (hmrcClaimEl) hmrcClaimEl.textContent = '£' + hmrcClaimable.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (totalBenefitEl) totalBenefitEl.textContent = '£' + totalTaxBenefit.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (netCostEl) netCostEl.textContent = '£' + trueNetCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['gross-salary', 'tax-region', 'pension-payment-net'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateRegionalSippRelief);
    document.getElementById(id)?.addEventListener('change', calculateRegionalSippRelief);
  });
  calculateRegionalSippRelief();
</script>
