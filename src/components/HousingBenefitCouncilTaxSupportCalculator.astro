---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout social-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>Housing Benefit & Council Tax Support Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Eligible Weekly Rent (£/week)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="hb-weekly-rent" value="160" min="20" step="10" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Local Housing Allowance (LHA) Cap Rate (£/week)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="hb-lha-cap" value="180" min="20" step="10" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Weekly Net Income Above Applicable Amount (£/week)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="hb-excess-income" value="30" min="0" step="5" />
        </div>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--social-1), var(--social-2) 80%);">
      <div class="result-label">Estimated Weekly Housing Benefit Entitlement</div>
      <div class="result-amount"><span id="mainResultDisplay">£139.50 / week</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Monthly Equivalent Housing Award:</span>
        <span class="val" id="subResultValue">£604.50 / month</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Housing Benefit Taper Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Max Assessable Rent (Lower of Rent / LHA)</span>
          <span class="val" id="maxAssessableRentDisplay">£160.00 / week</span>
        </div>
        <div class="breakdown-row section">
          <span>65% Income Taper Reduction</span>
          <span class="val" id="incomeTaperReductionDisplay">-£19.50 / week</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Net Weekly Housing Benefit Awarded</span>
          <span class="val" id="netWeeklyHousingBenefitDisplay" style="font-weight: 700; font-size: 18px;">£139.50 / week</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="social" />
  </div>
</div>

<script>
  function calculateHousingBenefit() {
    const rentEl = document.getElementById('hb-weekly-rent') as HTMLInputElement;
    const lhaEl = document.getElementById('hb-lha-cap') as HTMLInputElement;
    const incomeEl = document.getElementById('hb-excess-income') as HTMLInputElement;

    if (!rentEl || !lhaEl || !incomeEl) return;

    const rent = parseFloat(rentEl.value) || 0;
    const lha = parseFloat(lhaEl.value) || 0;
    const excessIncome = parseFloat(incomeEl.value) || 0;

    const eligibleRent = Math.min(rent, lha);
    // Housing Benefit income taper is 65p for every £1 excess income
    const taperDeduction = excessIncome * 0.65;
    const netHb = Math.max(0, eligibleRent - taperDeduction);
    const monthlyHb = (netHb * 52) / 12;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const rentRes = document.getElementById('maxAssessableRentDisplay');
    const taperRes = document.getElementById('incomeTaperReductionDisplay');
    const netRes = document.getElementById('netWeeklyHousingBenefitDisplay');

    if (mainRes) mainRes.textContent = '£' + netHb.toFixed(2) + ' / week';
    if (subVal) subVal.textContent = '£' + monthlyHb.toFixed(2) + ' / month';
    if (rentRes) rentRes.textContent = '£' + eligibleRent.toFixed(2) + ' / week';
    if (taperRes) taperRes.textContent = '-£' + taperDeduction.toFixed(2) + ' / week (65% Taper)';
    if (netRes) netRes.textContent = '£' + netHb.toFixed(2) + ' / week';
  }

  ['hb-weekly-rent', 'hb-lha-cap', 'hb-excess-income'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateHousingBenefit);
    document.getElementById(id)?.addEventListener('change', calculateHousingBenefit);
  });
  calculateHousingBenefit();
</script>
