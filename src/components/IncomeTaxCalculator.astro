---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout taxes-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <h2>UK Income Tax Details</h2>
      <div class="field-group">
        <div class="field-label"><span>Annual Gross Salary / Income (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="incometax-gross-salary" value="45000" min="5000" step="1000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Tax Jurisdiction</span></div>
        <select id="incometax-region-select" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="rUK" selected>England, Wales & Northern Ireland</option>
          <option value="scotland">Scotland (Scottish Tax Bands)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Blind Person Allowance Add-on (£2,870)</span></div>
        <select id="incometax-blind-allowance" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="no" selected>No</option>
          <option value="yes">Yes (+£2,870 Tax-Free Personal Allowance)</option>
        </select>
      </div>
    </div>

    <!-- RESULT HERO -->
    <div class="result-card" style="background: linear-gradient(135deg, var(--taxes-1), var(--taxes-2) 80%);">
      <div class="result-label">Annual Income Tax Payable (HMRC)</div>
      <div class="result-amount"><span id="mainResultDisplay">£6,486.00 / year</span></div>
      <div class="result-year" style="border-top: 1px solid rgba(255,255,255,0.3); margin-top: 20px; padding-top: 14px;">
        <span id="subResultLabel">Monthly Income Tax Deduction:</span>
        <span class="val" id="subResultValue">£540.50 / month</span>
      </div>
    </div>

    <!-- BREAKDOWN CARD -->
    <div class="card" style="padding-bottom:0;">
      <h2 style="margin-bottom:6px;">📊 Income Tax Calculation Breakdown</h2>
      <div style="margin-bottom:18px;">
        <div class="breakdown-row section">
          <span>Gross Annual Income</span>
          <span class="val" id="grossIncomeDisplay">£45,000.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Personal Tax-Free Allowance</span>
          <span class="val" id="personalAllowanceDisplay">£12,570.00</span>
        </div>
        <div class="breakdown-row section">
          <span>Taxable Income (Subject to Tax)</span>
          <span class="val" id="taxableIncomeDisplay">£32,430.00</span>
        </div>
        <div class="breakdown-row net" style="border-top: 2px solid var(--line);">
          <span>Total Income Tax Liability</span>
          <span class="val" id="totalIncomeTaxDisplay" style="font-weight: 700; font-size: 18px;">£6,486.00 / year (£540.50/mo)</span>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="impuestos" />
  </div>
</div>

<script>
  function calculateIncomeTax() {
    const salaryEl = document.getElementById('incometax-gross-salary') as HTMLInputElement;
    const regionEl = document.getElementById('incometax-region-select') as HTMLSelectElement;
    const blindEl = document.getElementById('incometax-blind-allowance') as HTMLSelectElement;

    if (!salaryEl || !regionEl || !blindEl) return;

    const salary = parseFloat(salaryEl.value) || 0;
    const isBlind = blindEl.value === 'yes';

    // Standard PA £12,570 with £1-in-£2 taper over £100,000
    let pa = 12570;
    if (isBlind) pa += 2870;

    if (salary > 100000) {
      const taper = (salary - 100000) / 2;
      pa = Math.max(0, pa - taper);
    }

    const taxableIncome = Math.max(0, salary - pa);
    let tax = 0;

    // Basic Rate 20% (£0 - £37,700 taxable), Higher Rate 40% (£37,701 - £125,140), Additional Rate 45% (> £125,140)
    if (taxableIncome > 112570) {
      tax += (taxableIncome - 112570) * 0.45;
      tax += (112570 - 37700) * 0.40;
      tax += 37700 * 0.20;
    } else if (taxableIncome > 37700) {
      tax += (taxableIncome - 37700) * 0.40;
      tax += 37700 * 0.20;
    } else {
      tax += taxableIncome * 0.20;
    }

    const monthlyTax = tax / 12;

    const mainRes = document.getElementById('mainResultDisplay');
    const subVal = document.getElementById('subResultValue');
    const grossRes = document.getElementById('grossIncomeDisplay');
    const paRes = document.getElementById('personalAllowanceDisplay');
    const taxIncomeRes = document.getElementById('taxableIncomeDisplay');
    const totalRes = document.getElementById('totalIncomeTaxDisplay');

    if (mainRes) mainRes.textContent = '£' + tax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / year';
    if (subVal) subVal.textContent = '£' + monthlyTax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / month';
    if (grossRes) grossRes.textContent = '£' + salary.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (paRes) paRes.textContent = '£' + pa.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (taxIncomeRes) taxIncomeRes.textContent = '£' + taxableIncome.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (totalRes) totalRes.textContent = '£' + tax.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` / year (£${monthlyTax.toFixed(2)}/mo)`;
  }

  ['incometax-gross-salary', 'incometax-region-select', 'incometax-blind-allowance'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateIncomeTax);
    document.getElementById(id)?.addEventListener('change', calculateIncomeTax);
  });
  calculateIncomeTax();
</script>
