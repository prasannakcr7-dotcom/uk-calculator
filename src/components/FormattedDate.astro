---
import Sidebar from './Sidebar.astro';
interface Props {
	date: Date;
}

const { date } = Astro.props;
---
<div class="layout calculator-layout work-category">
  <div class="main-col">
    <time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
    <slot />
  </div>
  <div class="side-col">
    <Sidebar />
  </div>
</div>
