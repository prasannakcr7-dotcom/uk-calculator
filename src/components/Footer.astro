---
import NationFlagIcon from './NationFlagIcon.astro';
const today = new Date();
---

<footer class="footer">
  <div class="footer-grid">
    <div>
      <div class="footer-brand" style="display: flex; align-items: center; gap: 8px;">
        <NationFlagIcon nation="uk" width="22px" height="15px" />
        <span>UK Calculator</span>
      </div>
      <p style="font-size: 13.5px; line-height: 1.6; color: rgba(26, 46, 40, 0.7); max-width: 320px;">
        Free, accurate financial, tax, property, and everyday calculators tailored for England, Scotland, Wales, and Northern Ireland. Updated for the 2026/27 tax year.
      </p>
    </div>

    <div>
      <h4 style="font-size: 14px; font-weight: 700; color: var(--ink); margin: 0 0 14px; text-transform: uppercase; letter-spacing: 0.04em;">Calculators</h4>
      <ul style="list-style: none; padding: 0; margin: 0; font-size: 13.5px; display: flex; flex-direction: column; gap: 8px;">
        <li><a href="/work-and-salary/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Work & Salary</a></li>
        <li><a href="/taxes-and-fees/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Taxes & Duties</a></li>
        <li><a href="/housing-and-rent/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Housing & Rent</a></li>
        <li><a href="/family-and-maternity/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Family & Children</a></li>
      </ul>
    </div>

    <div>
      <h4 style="font-size: 14px; font-weight: 700; color: var(--ink); margin: 0 0 14px; text-transform: uppercase; letter-spacing: 0.04em;">Regional</h4>
      <ul style="list-style: none; padding: 0; margin: 0; font-size: 13.5px; display: flex; flex-direction: column; gap: 8px;">
        <li><a href="/england-calculators/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">England Tools</a></li>
        <li><a href="/scotland-calculators/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Scotland (devolved)</a></li>
        <li><a href="/wales-calculators/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Wales (devolved)</a></li>
        <li><a href="/northern-ireland-calculators/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Northern Ireland</a></li>
      </ul>
    </div>

    <div>
      <h4 style="font-size: 14px; font-weight: 700; color: var(--ink); margin: 0 0 14px; text-transform: uppercase; letter-spacing: 0.04em;">Company & Legal</h4>
      <ul style="list-style: none; padding: 0; margin: 0; font-size: 13.5px; display: flex; flex-direction: column; gap: 8px;">
        <li><a href="/about/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">About Us</a></li>
        <li><a href="/privacy-policy/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Privacy Policy</a></li>
        <li><a href="/terms-and-conditions/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Terms & Conditions</a></li>
        <li><a href="/contact/" style="color: rgba(26, 46, 40, 0.7); text-decoration: none;">Contact Us</a></li>
      </ul>
    </div>
  </div>

  <div style="max-width: 1200px; margin: 30px auto 0; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 13px; color: rgba(26, 46, 40, 0.6);">
    <div>&copy; {today.getFullYear()} UK Calculator. All rights reserved. Calculations are for guidance only.</div>
    <div style="display: flex; gap: 16px;">
      <a href="/privacy-policy/" style="color: inherit; text-decoration: none;">Privacy</a>
      <a href="/terms-and-conditions/" style="color: inherit; text-decoration: none;">Terms</a>
      <a href="/contact/" style="color: inherit; text-decoration: none;">Contact</a>
    </div>
  </div>
</footer>
