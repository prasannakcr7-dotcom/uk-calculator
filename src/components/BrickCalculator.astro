---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label"><span>Wall Length (Metres - m)</span></div>
        <div class="amount-field">
          <input type="number" id="brick-wall-length" value="6.0" min="0.5" step="0.5" />
          <span class="cur">m</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Wall Height (Metres - m)</span></div>
        <div class="amount-field">
          <input type="number" id="brick-wall-height" value="2.4" min="0.5" step="0.1" />
          <span class="cur">m</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Wall Construction Thickness</span></div>
        <select id="brick-wall-skin-type" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; background: #fff; color: var(--ink);">
          <option value="60" selected>Single Skin / Half-Brick Wall (60 bricks / sq m)</option>
          <option value="120">Double Skin / One-Brick Thick Solid Wall (120 bricks / sq m)</option>
        </select>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Wastage & Damage Allowance (%)</span></div>
        <div class="amount-field">
          <input type="number" id="brick-wastage-pct" value="10" min="5" max="20" step="1" />
          <span class="cur">%</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label"><span>Cost Per 1,000 Facing Bricks (£)</span></div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="price-per-thousand-bricks" value="750" min="200" step="50" />
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Brick & Mortar Quantity Summary</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Gross Wall Surface Area</span>
          <strong id="brick-wall-area-sqm">14.40 sq m</strong>
        </div>
        <div class="breakdown-row">
          <span>Total Facing Bricks Needed (inc. Wastage)</span>
          <strong id="total-bricks-required-count">951 Bricks</strong>
        </div>
        <div class="breakdown-row">
          <span>Mortgage Sand & Cement Mortar Bags Needed</span>
          <strong id="mortar-sand-bags-needed">10 Bags (25kg)</strong>
        </div>
        <div class="breakdown-row net">
          <span>Estimated Total Brick Materials Outlay</span>
          <strong id="total-brick-materials-cost">£713.25</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar category="vivienda" />
  </div>
</div>

<script>
  function calculateBricks() {
    const lenEl = document.getElementById('brick-wall-length') as HTMLInputElement;
    const heightEl = document.getElementById('brick-wall-height') as HTMLInputElement;
    const skinEl = document.getElementById('brick-wall-skin-type') as HTMLSelectElement;
    const wasteEl = document.getElementById('brick-wastage-pct') as HTMLInputElement;
    const priceEl = document.getElementById('price-per-thousand-bricks') as HTMLInputElement;

    if (!lenEl || !heightEl || !skinEl || !wasteEl || !priceEl) return;

    const len = parseFloat(lenEl.value) || 0;
    const height = parseFloat(heightEl.value) || 0;
    const bricksPerSqm = parseInt(skinEl.value) || 60;
    const wastage = (parseFloat(wasteEl.value) || 10) / 100;
    const pricePer1000 = parseFloat(priceEl.value) || 750;

    const area = len * height;
    const rawBricks = area * bricksPerSqm;
    const totalBricks = Math.ceil(rawBricks * (1 + wastage));

    // Mortar estimation: ~0.05 tonnes sand per sq m single skin
    const sandBags = Math.ceil((area * (bricksPerSqm / 60) * 0.05 * 1000) / 25);
    const brickCost = (totalBricks / 1000) * pricePer1000;

    const areaResEl = document.getElementById('brick-wall-area-sqm');
    const bricksResEl = document.getElementById('total-bricks-required-count');
    const mortarResEl = document.getElementById('mortar-sand-bags-needed');
    const costResEl = document.getElementById('total-brick-materials-cost');

    if (areaResEl) areaResEl.textContent = area.toFixed(2) + ' sq m';
    if (bricksResEl) bricksResEl.textContent = totalBricks.toLocaleString('en-GB') + ' Bricks';
    if (mortarResEl) mortarResEl.textContent = sandBags + ' Bags (25kg)';
    if (costResEl) costResEl.textContent = '£' + brickCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  ['brick-wall-length', 'brick-wall-height', 'brick-wall-skin-type', 'brick-wastage-pct', 'price-per-thousand-bricks'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateBricks);
    document.getElementById(id)?.addEventListener('change', calculateBricks);
  });
  calculateBricks();
</script>
