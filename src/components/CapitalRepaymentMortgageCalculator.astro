---
import Sidebar from './Sidebar.astro';
interface Props {
  labels?: Record<string, string>;
  lang?: string;
}

const { labels = {}, lang = 'en' } = Astro.props;
---

<div class="layout calculator-layout housing-category">
  <div class="main-col">
    <!-- INPUT CARD -->
    <div class="card">
      <div class="field-group">
        <div class="field-label">
          <span>Mortgage Loan Amount (£)</span>
        </div>
        <div class="amount-field">
          <span class="cur">£</span>
          <input type="number" id="mortgage-amount" value="250000" min="10000" step="5000" />
        </div>
      </div>

      <div class="field-group">
        <div class="field-label">
          <span>Mortgage Interest Rate (% p.a.)</span>
        </div>
        <div class="amount-field">
          <input type="number" id="mortgage-rate" value="4.5" min="0.1" max="15" step="0.1" />
          <span class="cur">%</span>
        </div>
      </div>

      <div class="field-group">
        <div class="field-label">
          <span>Mortgage Repayment Term (Years)</span>
        </div>
        <div class="amount-field">
          <input type="number" id="mortgage-term" value="25" min="1" max="40" step="1" />
          <span class="cur">yrs</span>
        </div>
      </div>
    </div>

    <!-- RESULT BREAKDOWN CARD -->
    <div class="card breakdown-card" id="results-card">
      <h2>Mortgage Repayment Breakdown</h2>
      <div class="breakdown-list">
        <div class="breakdown-row">
          <span>Total Overall Amount Payable (Principal + Interest)</span>
          <strong id="total-repay-amount-val">£416,874.36</strong>
        </div>
        <div class="breakdown-row">
          <span>Total Lifetime Interest Payable</span>
          <strong id="lifetime-interest-val">£166,874.36</strong>
        </div>
        <div class="breakdown-row">
          <span>Interest Share of First Monthly Payment</span>
          <strong id="first-month-interest-val">£937.50</strong>
        </div>
        <div class="breakdown-row net">
          <span>Monthly Mortgage Repayment</span>
          <strong id="monthly-repayment-val">£1,389.58</strong>
        </div>
      </div>
    </div>

    <slot />
  </div>

  <div class="sidebar">
    <Sidebar />
  </div>
</div>

<script>
  function calculateMortgage() {
    const amountEl = document.getElementById('mortgage-amount') as HTMLInputElement;
    const rateEl = document.getElementById('mortgage-rate') as HTMLInputElement;
    const termEl = document.getElementById('mortgage-term') as HTMLInputElement;

    if (!amountEl || !rateEl || !termEl) return;

    const P = parseFloat(amountEl.value) || 0;
    const annualRate = parseFloat(rateEl.value) || 0;
    const years = parseInt(termEl.value) || 25;

    const r = annualRate / 100 / 12;
    const n = years * 12;

    let M = 0;
    if (r > 0) {
      M = P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    } else {
      M = P / n;
    }

    const totalPayable = M * n;
    const totalInterest = totalPayable - P;
    const firstMonthInterest = P * r;

    const monthlyEl = document.getElementById('monthly-repayment-val');
    const totalEl = document.getElementById('total-repay-amount-val');
    const interestEl = document.getElementById('lifetime-interest-val');
    const firstIntEl = document.getElementById('first-month-interest-val');
    const resultsCard = document.getElementById('results-card');

    if (monthlyEl) monthlyEl.textContent = '£' + M.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (totalEl) totalEl.textContent = '£' + totalPayable.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (interestEl) interestEl.textContent = '£' + totalInterest.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (firstIntEl) firstIntEl.textContent = '£' + firstMonthInterest.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (resultsCard) resultsCard.style.display = 'block';
  }

  ['mortgage-amount', 'mortgage-rate', 'mortgage-term'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateMortgage);
    document.getElementById(id)?.addEventListener('change', calculateMortgage);
  });
  calculateMortgage();
</script>
