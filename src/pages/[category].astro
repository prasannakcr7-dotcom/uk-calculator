  function updateLinksAndBanners(selectedNation) {
    regionTabs.forEach(btn => {
      if (btn.getAttribute('data-nation') === selectedNation) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    calcRows.forEach(row => {
      const isDevolved = row.getAttribute('data-devolved') === 'true';
      if (!isDevolved) return;

      const slug = row.getAttribute('data-slug');
      const isCompleted = !row.classList.contains('disabled');
      if (!isCompleted) return;

      const targetNation = (selectedNation === 'all') ? 'england' : selectedNation;
      row.setAttribute('href', `/${slug}/${targetNation}/`);
    });

    if (selectedNation === 'all') {
      if (alertBanner) {
        alertBanner.classList.add('hidden');
        alertBanner.style.display = 'none';
      }
    } else {
      const info = countries[selectedNation];
      if (info && alertText && alertBanner) {
        alertText.innerHTML = `Showing calculators for ${info.flagHtml} <strong>${info.name}</strong>. Regional tools will automatically use ${info.name} rates and rules.`;
        alertBanner.classList.remove('hidden');
        alertBanner.style.display = 'block';
      }
    }

    const url = new URL(window.location);
    if (selectedNation === 'all') {
      url.searchParams.delete('nation');
    } else {
      url.searchParams.set('nation', selectedNation);
    }
    window.history.replaceState({}, '', url);
  }

  // Bind clicks
  regionTabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const nation = btn.getAttribute('data-nation');
      updateLinksAndBanners(nation);
    });
  });

  // Load initial query state
  const params = new URLSearchParams(window.location.search);
  const initialNation = params.get('nation') || 'all';
  updateLinksAndBanners(initialNation);

  // TOC scroll highlights
  document.addEventListener('DOMContentLoaded', () => {
    const links = document.querySelectorAll('.ch-side-section:not(.ch-side-other) .ch-side-link');
    const sections = Array.from(links).map(link => {
      const id = link.getAttribute('href').substring(1);
      return document.getElementById(id);
    });

    function updateActiveLink() {
      let activeIndex = 0;
      const scrollPos = window.scrollY + 120;

      sections.forEach((sec, idx) => {
        if (!sec) return;
        if (scrollPos >= sec.offsetTop) {
          activeIndex = idx;
        }
      });

      links.forEach((link, idx) => {
        if (idx === activeIndex) {
          link.classList.add('ch-side-active');
        } else {
          link.classList.remove('ch-side-active');
        }
      });
    }

    window.addEventListener('scroll', updateActiveLink);
    updateActiveLink();
  });
</script>
