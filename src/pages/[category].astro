---
import Layout from '../layouts/Layout.astro';
import { categoryHubContent } from '../data/categoryHubContent';
import NationFlagIcon from '../components/NationFlagIcon.astro';

type CategoryKey = 'work' | 'taxes' | 'family' | 'housing' | 'mobility' | 'health' | 'social' | 'finance' | 'alltag';

export async function getStaticPaths() {
  return [
    { params: { category: 'work-and-salary' }, props: { key: 'work' as CategoryKey, title: 'Work & Salary', icon: '💼', dotClass: 'work', desc: 'Manage your pay, income tax, NI contributions, overtime, and work benefits.' } },
    { params: { category: 'taxes-and-fees' }, props: { key: 'taxes' as CategoryKey, title: 'Taxes & Duties', icon: '🧾', dotClass: 'taxes', desc: 'Calculate VAT, Stamp Duty, capital gains, and self-assessment tax obligations.' } },
    { params: { category: 'family-and-maternity' }, props: { key: 'family' as CategoryKey, title: 'Family & Children', icon: '👶', dotClass: 'family', desc: 'Plan maternity pay, child maintenance, and statutory family allowances.' } },
    { params: { category: 'housing-and-rent' }, props: { key: 'housing' as CategoryKey, title: 'Housing & Property', icon: '🏠', dotClass: 'housing', desc: 'Estimate mortgage payments, landlord tax, rental yields, and property values.' } },
    { params: { category: 'mobility-and-vehicles' }, props: { key: 'mobility' as CategoryKey, title: 'Car & Mobility', icon: '🚗', dotClass: 'mobility', desc: 'Calculate vehicle taxation, company car tax, fuel usage, and business mileage.' } },
    { params: { category: 'health-and-wellbeing' }, props: { key: 'health' as CategoryKey, title: 'Health & Fitness', icon: '❤️', dotClass: 'health', desc: 'Assess body mass index, daily calorie requirements, and healthy lifestyles.' } },
    { params: { category: 'social-and-benefits' }, props: { key: 'social' as CategoryKey, title: 'Benefits & Pensions', icon: '🛡️', dotClass: 'social', desc: 'Estimate universal credit eligibility, state pension forecasts, and redundancy relief.' } },
    { params: { category: 'finance-and-credit' }, props: { key: 'finance' as CategoryKey, title: 'Finance & Savings', icon: '📈', dotClass: 'finance', desc: 'Compare credit costs, loan options, compound interest returns, and savings schemes.' } },
    { params: { category: 'daily-life' }, props: { key: 'alltag' as CategoryKey, title: 'Everyday & School/College', icon: '☀️', dotClass: 'reside', desc: 'Calculate everyday units, tuition costs, student budgets, and lifestyle metrics.' } },
  ];
}

const { category } = Astro.params;
const { key, title, icon, dotClass, desc } = Astro.props;

interface CalculatorItem {
  name: string;
  slug: string;
  urlPath: string;
  category: CategoryKey;
  emoji: string;
  desc: string;
  isDevolved: boolean;
  isCompleted: boolean;
}

const fallbackEmojis: Record<CategoryKey, string[]> = {
  work: ['💶', '⏱️', '📦', '🧾', '📅', '🏛️', '🌙', '🧮'],
  taxes: ['📊', '🧾', '🏛️', '🎁', '🏘️', '🚘', '💼', '📈'],
  family: ['🤱', '👶', '👪', '🎒', '🧸', '📅', '⚖️', '🏫'],
  housing: ['🏦', '🏠', '🔑', '📐', '🧱', '☀️', '🎨', '🧰'],
  mobility: ['🚗', '⛽', '🔌', '🚲', '🚨', '🛞', '🅿️', '⚡'],
  health: ['⚖️', '❤️', '🔥', '🩺', '💧', '🏃', '😴', '🧬'],
  social: ['🛡️', '💶', '👵', '📋', '🎓', '🏡', '🌾', '📆'],
  finance: ['💳', '📈', '🏦', '🪙', '📉', '🎯', '💱', '🧾'],
  alltag: ['🧮', '🏷️', '🎓', '📅', '📏', '🎁', '🔐', '✈️'],
};

function describeUK(title: string) {
  const lower = title.toLowerCase();
  if (lower.includes('tax') || lower.includes('vat')) return 'Estimate the tax amount, filing impact, and taxable thresholds.';
  if (lower.includes('salary') || lower.includes('wage')) return 'Break down pay figures, national insurance, and take-home pay.';
  if (lower.includes('mortgage') || lower.includes('loan')) return 'Compare monthly payments, interest rates, and loan terms.';
  if (lower.includes('rent') || lower.includes('property') || lower.includes('housing')) return 'Calculate property tax, landlord yields, and housing costs.';
  if (lower.includes('car') || lower.includes('vehicle') || lower.includes('mileage')) return 'Estimate vehicle costs, fuel consumption, or mileage allowance.';
  if (lower.includes('child') || lower.includes('maternity') || lower.includes('parental')) return 'Calculate benefits, statutory pay, or maintenance obligations.';
  if (lower.includes('bmi') || lower.includes('calorie') || lower.includes('health')) return 'Assess fitness metrics with standard health calculators.';
  if (lower.includes('interest') || lower.includes('savings')) return 'Model compound growth, returns, and financial planning.';
  return 'Get a quick, focused estimate with the relevant UK inputs and parameters.';
}

import { getCollection } from 'astro:content';

function normalizeCategoryKey(rawCat: string): CategoryKey {
  const cat = (rawCat || '').toLowerCase().trim();
  if (cat === 'trabajo' || cat === 'work') return 'work';
  if (cat === 'impuestos' || cat === 'taxes') return 'taxes';
  if (cat === 'familia' || cat === 'family') return 'family';
  if (cat === 'vivienda' || cat === 'housing') return 'housing';
  if (cat === 'movilidad' || cat === 'mobility') return 'mobility';
  if (cat === 'salud' || cat === 'health') return 'health';
  if (cat === 'social' || cat === 'benefits') return 'social';
  if (cat === 'finanzas' || cat === 'finance') return 'finance';
  if (cat === 'alltag' || cat === 'everyday' || cat === 'reside') return 'alltag';
  return 'work';
}

const allCalcEntries = await getCollection('calculators');

const calculators: CalculatorItem[] = allCalcEntries
  .filter(entry => normalizeCategoryKey(entry.data.category) === key)
  .map((entry, idx) => {
    const slug = entry.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || entry.id;
    let displayName = entry.data.title;
    displayName = displayName.replace(/\s*UK\s*2026\/27.*$/i, '');
    displayName = displayName.replace(/\s*—.*$/, '');
    displayName = displayName.trim();

    return {
      name: displayName,
      slug,
      urlPath: `/${slug}`,
      category: key,
      emoji: fallbackEmojis[key][idx % fallbackEmojis[key].length],
      desc: entry.data.description,
      isDevolved: !!entry.data.isDevolved,
      isCompleted: true
    };
  });
const content = categoryHubContent[key]?.default || categoryHubContent['work'].default;

// Map categories for dynamic colors matching global.css variables
const categoryMeta: Record<CategoryKey, { color1: string; color2: string; soft: string }> = {
  work:    { color1: 'var(--work-1)', color2: 'var(--work-2)', soft: 'var(--work-soft)' },
  taxes:   { color1: 'var(--taxes-1)', color2: 'var(--taxes-2)', soft: 'var(--taxes-soft)' },
  family:  { color1: 'var(--family-1)', color2: 'var(--family-2)', soft: 'var(--family-soft)' },
  housing: { color1: 'var(--housing-1)', color2: 'var(--housing-2)', soft: 'var(--housing-soft)' },
  social:  { color1: 'var(--social-1)', color2: 'var(--social-2)', soft: 'var(--social-soft)' },
  health:  { color1: 'var(--health-1)', color2: 'var(--health-2)', soft: 'var(--health-soft)' },
  mobility:{ color1: 'var(--mobility-1)', color2: 'var(--mobility-2)', soft: 'var(--mobility-soft)' },
  finance: { color1: 'var(--finance-1)', color2: 'var(--finance-2)', soft: 'var(--finance-soft)' },
  alltag:  { color1: 'var(--reside-1)', color2: 'var(--reside-2)', soft: 'var(--reside-soft)' },
};

const meta = categoryMeta[key];
const cssVars = [
  `--cat-1:${meta.color1}`,
  `--cat-2:${meta.color2}`,
  `--cat-soft:${meta.soft}`,
].join(';');

const allCategoryLinks = [
  { key: 'work',    emoji: '💼', label: 'Work & Salary',        slug: '/work-and-salary/' },
  { key: 'taxes',   emoji: '🧾', label: 'Taxes & Duties',       slug: '/taxes-and-fees/' },
  { key: 'family',  emoji: '👶', label: 'Family & Children',     slug: '/family-and-maternity/' },
  { key: 'housing', emoji: '🏠', label: 'Housing & Property',     slug: '/housing-and-rent/' },
  { key: 'mobility',emoji: '🚗', label: 'Car & Mobility',        slug: '/mobility-and-vehicles/' },
  { key: 'health',  emoji: '❤️', label: 'Health & Wellbeing',     slug: '/health-and-wellbeing/' },
  { key: 'social',  emoji: '🛡️', label: 'Benefits & Pensions',   slug: '/social-and-benefits/' },
  { key: 'finance', emoji: '📈', label: 'Finance & Savings',     slug: '/finance-and-credit/' },
  { key: 'alltag',  emoji: '☀️', label: 'Everyday & College',      slug: '/daily-life/' },
];

const otherCategories = allCategoryLinks.filter(c => c.key !== key);
---

<Layout 
  title={`${title} Calculators UK — 2026/27`} 
  description={`${desc} Accurate, free calculators tailored for UK regions.`}
>
  <div style={cssVars}>
    <!-- BREADCRUMBS -->
    <div class="ch-crumb">
      <a href="/">Home</a>
      <span class="ch-sep">›</span>
      <span class="ch-cur">{title}</span>
    </div>

    <!-- HERO BANNER -->
    <div class="ch-hero">
      <div class="ch-hero-inner">
        <a href="/calculators/" class="ch-hero-back">‹ All calculators</a>
        <span class="ch-hero-emoji">{icon}</span>
        <h1>{title}</h1>
        <p class="ch-sub">{desc}</p>

        <!-- REGION SELECTOR TABS EMBEDDED IN HERO GRADIENT -->
        <div style="margin-top: 24px; display: flex; gap: 8px; flex-wrap: wrap;" id="categoryRegionTabs">
          <button class="tab-btn active" data-nation="all"><NationFlagIcon nation="uk" width="18px" height="12px" /> UK Wide</button>
          <button class="tab-btn" data-nation="england"><NationFlagIcon nation="england" width="18px" height="12px" /> England</button>
          <button class="tab-btn" data-nation="scotland"><NationFlagIcon nation="scotland" width="18px" height="12px" /> Scotland</button>
          <button class="tab-btn" data-nation="wales"><NationFlagIcon nation="wales" width="18px" height="12px" /> Wales</button>
          <button class="tab-btn" data-nation="northern-ireland"><NationFlagIcon nation="northern-ireland" width="18px" height="12px" /> N. Ireland</button>
        </div>
      </div>
    </div>

    <!-- LOCALIZATION ALERT BANNER -->
    <div id="localizationAlert" class="hidden" style="max-width: 1400px; margin: 16px auto 0; padding: 0 48px; box-sizing: border-box;">
      <div style="background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; border-radius: 12px; padding: 12px 16px; font-size: 13.5px; font-weight: 500; display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 18px;">ℹ️</span>
        <span id="localizationAlertText">Showing calculators for Scotland. Regional tools will automatically use Scottish rates and rules.</span>
      </div>
    </div>

    <!-- DUAL COLUMN BODY -->
    <div class="ch-body">
      <!-- LEFT SIDEBAR -->
      <aside class="ch-sidebar">
        <div class="ch-sidebar-sticky">
          <div class="ch-side-section">
            <div class="ch-side-label">On this page</div>
            <a href="#intro" class="ch-side-link ch-side-active">
              <span class="ch-dot"></span> Overview
            </a>
            <a href="#calculators" class="ch-side-link">
              <span class="ch-dot"></span> Calculators
            </a>
            <a href="#tips" class="ch-side-link">
              <span class="ch-dot"></span> Tips & Mistakes
            </a>
            <a href="#figures" class="ch-side-link">
              <span class="ch-dot"></span> Key Figures
            </a>
            <a href="#faq" class="ch-side-link">
              <span class="ch-dot"></span> FAQ
            </a>
            <a href="#sources" class="ch-side-link">
              <span class="ch-dot"></span> Sources
            </a>
          </div>

          {otherCategories.length > 0 && (
            <div class="ch-side-section ch-side-other">
              <div class="ch-side-label">Other categories</div>
              {otherCategories.map(c => (
                <a href={c.slug} class="ch-side-link">
                  <span class="ch-cat-ico">{c.emoji}</span>
                  {c.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </aside>

      <!-- RIGHT MAIN CONTENT -->
      <main class="ch-main">
        <!-- 1. INTRO CARD -->
        <section id="intro" class="ch-card ch-intro-card">
          <h2>{content.introTitle}</h2>
          <Fragment set:html={content.introHtml} />
        </section>

        <!-- 2. CALCULATORS GRID -->
        <div id="calculators" class="ch-sec-head">
          <h2>All {title} Calculators</h2>
          <span class="ch-count">{calculators.length} calculators</span>
        </div>
        
        <div class="ch-calc-grid">
          {calculators.map(c => {
            const targetUrl = c.isDevolved ? `/${c.slug}/england/` : `/${c.slug}/`;
            return (
              <a 
                href={c.isCompleted ? targetUrl : '#'} 
                class={`ch-calc-card ${c.isCompleted ? '' : 'disabled'}`} 
                data-devolved={c.isDevolved ? "true" : "false"} 
                data-slug={c.slug}
                style={c.isCompleted ? '' : 'opacity: 0.65; pointer-events: none; cursor: default;'}
              >
                <span class="ch-calc-ico">{c.emoji}</span>
                <div class="ch-calc-body">
                  <h3>{c.name} {!c.isCompleted && <span class="badge" style="margin-left: 6px;">Soon</span>}</h3>
                  <p>{c.desc}</p>
                </div>
                <span class="ch-arr">→</span>
              </a>
            );
          })}
        </div>

        <!-- 3. TIPS CARD -->
        <section id="tips" class="ch-card ch-tips-card">
          <h2>{content.tipsTitle}</h2>
          {content.tips.map(t => (
            <div class="ch-tip">
              <div class="ch-tip-ico">{t.icon}</div>
              <div>
                <h4>{t.title}</h4>
                <p set:html={t.body}></p>
              </div>
            </div>
          ))}
        </section>

        <!-- 4. KEY FIGURES CARD -->
        <section id="figures" class="ch-card ch-figures-card">
          <h2>{content.figuresTitle}</h2>
          <div class="ch-changes-grid">
            {content.figureGroups.map(fg => (
              <div class={`ch-change-block ${fg.isHighlighted ? 'ch-block-good' : ''}`}>
                <h4 class={fg.isHighlighted ? 'ch-label-cat' : ''}>{fg.label}</h4>
                {fg.items.map(item => (
                  <div class="ch-change-item">
                    <span>{item.term}:</span>
                    <span class="ch-bl">{item.value}</span>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </section>

        <!-- 5. FAQ CARD -->
        <section id="faq" class="ch-card ch-faq-card">
          <h2>{content.faqTitle}</h2>
          {content.faq.map(item => (
            <div class="ch-faq-item">
              <h4>{item.question}</h4>
              <p set:html={item.answer}></p>
            </div>
          ))}
        </section>

        <!-- 6. SOURCES CARD -->
        <section id="sources" class="ch-sources-card">
          <div class="ch-sources-lbl">{content.sourcesTitle}</div>
          {content.sources.map(s => (
            <a href={s.url} class="ch-src-link" target="_blank" rel="noopener noreferrer">
              ↗ {s.label}
            </a>
          ))}
        </section>
      </main>
    </div>
  </div>
</Layout>

<script is:inline>
  // Client-side Nation Filter Logic & Scroll Highlight
  const regionTabs = document.querySelectorAll('#categoryRegionTabs button');
  const calcRows = document.querySelectorAll('.ch-calc-card');
  const alertBanner = document.getElementById('localizationAlert');
  const alertText = document.getElementById('localizationAlertText');

  const countries = {
    england: { name: 'England', flagHtml: '<svg width="18" height="12" viewBox="0 0 36 36" style="border-radius:2px; vertical-align:middle; display:inline-block; margin-right:4px;"><path fill="#EEE" d="M32 5H4a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h28a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4z"/><path fill="#CE1124" d="M21 5h-6v10H0v6h15v10h6V21h15v-6H21z"/></svg>' },
    scotland: { name: 'Scotland', flagHtml: '<svg width="18" height="12" viewBox="0 0 36 36" style="border-radius:2px; vertical-align:middle; display:inline-block; margin-right:4px;"><path fill="#EEE" d="M32 5H4a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h28a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4z"/><path d="M13 18S0 8.586 0 8.895v18.21C0 27.414 13 18 13 18zm5 3S3.697 31 4.07 31h27.859C32.303 31 18 21 18 21zm5-3s13 9.414 13 9.105V8.895C36 8.586 23 18 23 18zm-5-3S3.697 5 4.07 5h27.859C32.303 5 18 15 18 15z" fill="#0065BD"/></svg>' },
