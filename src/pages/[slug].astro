const categoryKey = entry.data.category || 'trabajo';
const cat = categoriesInfo[categoryKey] || categoriesInfo.trabajo;
const CalcComponent = slug ? componentMap[slug] : null;
---

{entry.data.isDevolved ? (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="refresh" content={`0;url=/${slug}/england/`} />
      <title>Redirecting...</title>
    </head>
    <body>
      <p>Redirecting to default region... <a href={`/${slug}/england/`}>click here</a>.</p>
    </body>
  </html>
) : (
  <Layout title={entry.data.title} description={entry.data.description} keywords={entry.data.keywords}>
    <div class="crumb">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href={cat.url}>{cat.title}</a>
      <span class="sep">›</span>
      <span class="current">{entry.data.title}</span>
    </div>
    <BreadcrumbSchema items={[
      { name: cat.title, url: cat.url },
      { name: entry.data.title, url: `/${slug}/` }
    ]} />
    
    <div class={`hero ${cat.class}`}>
      <a href={cat.url} class="hero-back">{cat.backText}</a>
      <a href={cat.url} class="hero-eyebrow">{cat.icon} {cat.title}</a>
      <h1>{entry.data.title}</h1>
      <p class="sub">{entry.data.description}</p>
    </div>

    <WebAppSchema
      title={entry.data.title}
      description={entry.data.description}
      url={`/${slug}/`}
      category={categoryKey}
    />

    <div class={cat.class}>
      {CalcComponent ? (
        <CalcComponent labels={entry.data.labels} lang="en">
          <div class="card writeup">
            <Content />
          </div>
        </CalcComponent>
      ) : (
        <div class="layout calculator-layout">
          <div class="main-col">
            <div class="card writeup">
              <Content />
            </div>
          </div>
          <Sidebar category={categoryKey} currentSlug={slug} />
        </div>
      )}
    </div>
    <FaqSchema content={entry.body} />
  </Layout>
)}
