---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us — UK Calculator" 
  description="Get in touch with the UK Calculator team for support, feedback, or statutory policy updates."
>
  <div class="crumb" style="padding: 16px 48px 0; font-size: 13px; color: #64748b;">
    <a href="/" style="color: #64748b; text-decoration: none;">Home</a>
    <span style="margin: 0 6px;">›</span>
    <span style="color: #0f172a; font-weight: 600;">Contact Us</span>
  </div>

  <div style="max-width: 900px; margin: 32px auto 80px; padding: 0 24px;">
    <div style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 20px; padding: 48px; box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);">
      <h1 style="font-family: 'Inter', sans-serif; font-size: 32px; font-weight: 800; color: #0f172a; margin-top: 0; margin-bottom: 16px;">Contact Us</h1>
      <p style="font-size: 15.5px; line-height: 1.7; color: #334155; margin-bottom: 32px;">
        We welcome your questions, feedback, bug reports, and suggestions for new calculators. Please use the contact options below to reach our team.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 36px;">
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 24px;">
          <div style="font-size: 24px; margin-bottom: 8px;">📧</div>
          <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 6px;">General Enquiries & Support</h3>
          <p style="font-size: 14px; color: #475569; margin: 0 0 12px;">Questions about calculation formulas or tax rules?</p>
          <a href="mailto:support@ukcalculators.org.uk" style="color: #2563eb; font-weight: 600; font-size: 14px; text-decoration: none;">support@ukcalculators.org.uk</a>
        </div>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 24px;">
          <div style="font-size: 24px; margin-bottom: 8px;">💡</div>
          <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 6px;">Feature & Tool Requests</h3>
          <p style="font-size: 14px; color: #475569; margin: 0 0 12px;">Need a new UK financial or everyday tool built?</p>
          <a href="mailto:feedback@ukcalculators.org.uk" style="color: #2563eb; font-weight: 600; font-size: 14px; text-decoration: none;">feedback@ukcalculators.org.uk</a>
        </div>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 24px;">
          <div style="font-size: 24px; margin-bottom: 8px;">⚖️</div>
          <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 6px;">Statutory Updates & Rules</h3>
          <p style="font-size: 14px; color: #475569; margin: 0 0 12px;">Spotted a change in HMRC rates or devolved legislation?</p>
          <a href="mailto:updates@ukcalculators.org.uk" style="color: #2563eb; font-weight: 600; font-size: 14px; text-decoration: none;">updates@ukcalculators.org.uk</a>
        </div>
      </div>

      <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 14px; padding: 24px;">
        <h3 style="font-size: 16px; font-weight: 700; color: #1e40af; margin: 0 0 8px;">Response Times & Support Commitment</h3>
        <p style="font-size: 14px; color: #1e3a8a; margin: 0; line-height: 1.6;">
          Our editorial team reviews all incoming enquiries and aims to respond within 1 to 2 business days. Statutory rate updates and bug fixes reported via email are prioritized and typically updated on the site within 24 hours.
        </p>
      </div>
    </div>
  </div>
</Layout>
