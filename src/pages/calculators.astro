---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NationFlagIcon from '../components/NationFlagIcon.astro';

type CategoryKey = 'work' | 'taxes' | 'family' | 'housing' | 'mobility' | 'health' | 'social' | 'finance' | 'alltag';

interface CategoryInfo {
  key: CategoryKey;
  taskTitle: string;
  title: string;
  pillTitle: string;
  icon: string;
  dotClass: string;
  url: string;
}

interface CalculatorItem {
  name: string;
  slug: string;
  urlPath: string;
  category: CategoryKey;
  emoji: string;
  desc: string;
  isDevolved: boolean;
  isCompleted: boolean;
}

const categories: CategoryInfo[] = [
  { key: 'work', taskTitle: 'Work & Salary', title: 'Work & Salary', pillTitle: 'Work', icon: '💼', dotClass: 'work', url: '/work-and-salary/' },
  { key: 'taxes', taskTitle: 'Taxes & Duties', title: 'Taxes & Duties', pillTitle: 'Taxes', icon: '🧾', dotClass: 'taxes', url: '/taxes-and-fees/' },
  { key: 'family', taskTitle: 'Family & Children', title: 'Family & Children', pillTitle: 'Family', icon: '👶', dotClass: 'family', url: '/family-and-maternity/' },
  { key: 'housing', taskTitle: 'Housing & Property', title: 'Housing & Property', pillTitle: 'Housing', icon: '🏠', dotClass: 'housing', url: '/housing-and-rent/' },
  { key: 'mobility', taskTitle: 'Car & Mobility', title: 'Car & Mobility', pillTitle: 'Mobility', icon: '🚗', dotClass: 'mobility', url: '/mobility-and-vehicles/' },
  { key: 'health', taskTitle: 'Health & Fitness', title: 'Health & Fitness', pillTitle: 'Health', icon: '❤️', dotClass: 'health', url: '/health-and-wellbeing/' },
  { key: 'social', taskTitle: 'Benefits & Pensions', title: 'Benefits & Pensions', pillTitle: 'Benefits', icon: '🛡️', dotClass: 'social', url: '/social-and-benefits/' },
  { key: 'finance', taskTitle: 'Finance & Savings', title: 'Finance & Savings', pillTitle: 'Finance', icon: '📈', dotClass: 'finance', url: '/finance-and-credit/' },
  { key: 'alltag', taskTitle: 'Everyday & School/College', title: 'Everyday & School/College', pillTitle: 'Everyday', icon: '☀️', dotClass: 'reside', url: '/daily-life/' },
];

const fallbackEmojis: Record<CategoryKey, string[]> = {
  work: ['💶', '⏱️', '📦', '🧾', '📅', '🏛️', '🌙', '🧮'],
  taxes: ['📊', '🧾', '🏛️', '🎁', '🏘️', '🚘', '💼', '📈'],
  family: ['🤱', '👶', '👪', '🎒', '🧸', '📅', '⚖️', '🏫'],
  housing: ['🏦', '🏠', '🔑', '📐', '🧱', '☀️', '🎨', '🧰'],
  mobility: ['🚗', '⛽', '🔌', '🚲', '🚨', '🛞', '🅿️', '⚡'],
  health: ['⚖️', '❤️', '🔥', '🩺', '💧', '🏃', '😴', '🧬'],
  social: ['🛡️', '💶', '👵', '📋', '🎓', '🏡', '🌾', '📆'],
  finance: ['💳', '📈', '🏦', '🪙', '📉', '🎯', '💱', '🧾'],
  alltag: ['🧮', '🏷️', '🎓', '📅', '📏', '🎁', '🔐', '✈️'],
};

function normalizeCategoryKey(rawCat: string): CategoryKey {
  const cat = (rawCat || '').toLowerCase().trim();
  if (cat === 'trabajo' || cat === 'work') return 'work';
  if (cat === 'impuestos' || cat === 'taxes') return 'taxes';
  if (cat === 'familia' || cat === 'family') return 'family';
  if (cat === 'vivienda' || cat === 'housing') return 'housing';
  if (cat === 'movilidad' || cat === 'mobility') return 'mobility';
  if (cat === 'salud' || cat === 'health') return 'health';
  if (cat === 'social' || cat === 'benefits') return 'social';
  if (cat === 'finanzas' || cat === 'finance') return 'finance';
  if (cat === 'alltag' || cat === 'everyday' || cat === 'reside') return 'alltag';
  return 'work';
}

const allCalcEntries = await getCollection('calculators');

const calculators: CalculatorItem[] = allCalcEntries.map((entry, idx) => {
  const slug = entry.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || entry.id;
  const categoryKey = normalizeCategoryKey(entry.data.category);
  let displayName = entry.data.title;
  displayName = displayName.replace(/\s*UK\s*2026\/27.*$/i, '');
  displayName = displayName.replace(/\s*—.*$/, '');
  displayName = displayName.trim();

  return {
    name: displayName,
    slug,
    urlPath: `/${slug}`,
    category: categoryKey,
    emoji: fallbackEmojis[categoryKey][idx % fallbackEmojis[categoryKey].length],
    desc: entry.data.description,
    isDevolved: !!entry.data.isDevolved,
    isCompleted: true
  };
});
---

<Layout 
  title="All UK Calculator Tools — Directory of Free Financial & Tax Tools" 
  description="Browse and search all free calculators for tax, payroll, property, loans, and health across England, Scotland, Wales, and Northern Ireland."
>
  <!-- CRUMB AT TOP LEVEL (MATCHING NATIONAL PORTAL) -->
  <div class="crumb" style="margin: 18px 48px 0; font-size: 13px; color: #64748b;">
    <a href="/" style="color: #64748b; text-decoration: none;">Home</a>
    <span style="margin: 0 6px;">›</span>
    <span style="color: #0f172a; font-weight: 600;">All Calculators</span>
  </div>

  <!-- HERO BANNER BOX (VIBRANT TEAL TO INDIGO GRADIENT) -->
  <div class="dir-hero" style="background: linear-gradient(135deg, #0d9488 0%, #0284c7 45%, #6366f1 100%); color: #ffffff; margin: 18px 48px 0; border-radius: 20px; padding: 48px 52px 50px; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);">
    <div class="dir-hero-inner">
      <div class="dir-pill-badge" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.35); color: #ffffff; border-radius: 20px; padding: 6px 14px; font-size: 12.5px; font-weight: 700; margin-bottom: 16px;">
        <NationFlagIcon nation="uk" width="18px" height="12px" />
        <span>2026/27 Tax Year Directory</span>
      </div>

      <h1 style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 36px; font-weight: 800; margin: 0 0 12px; line-height: 1.15; color: #ffffff; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);">All UK Calculator Tools</h1>
      <p style="margin: 0; max-width: 760px; font-size: 15.5px; line-height: 1.6; color: rgba(255, 255, 255, 0.95); font-weight: 500;">Explore our complete suite of interactive UK calculator tools. Select your region below to automatically apply localized Scottish, Welsh, or Northern Irish tax bands and rules.</p>
    </div>
  </div>

  <!-- REGION SELECTOR BUTTONS OUTSIDE HERO GRADIENT (NO BACKGROUND BOX) -->
  <div style="margin: 24px 48px 0; text-align: center;">
    <div style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #64748b; margin-bottom: 14px;">Explore Regional Calculators & Rules</div>
    <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;" id="directoryRegionTabs">
      <button class="region-pill active" data-nation="all"><NationFlagIcon nation="uk" width="18px" height="12px" /> UK Wide</button>
      <button class="region-pill" data-nation="england"><NationFlagIcon nation="england" width="18px" height="12px" /> England</button>
      <button class="region-pill" data-nation="scotland"><NationFlagIcon nation="scotland" width="18px" height="12px" /> Scotland</button>
      <button class="region-pill" data-nation="wales"><NationFlagIcon nation="wales" width="18px" height="12px" /> Wales</button>
      <button class="region-pill" data-nation="northern-ireland"><NationFlagIcon nation="northern-ireland" width="18px" height="12px" /> N. Ireland</button>
    </div>
  </div>

  <div class="dir-page-wrapper">
    <!-- UNIFIED TOOLBAR CARD -->
    <div class="dir-toolbar-card">
      <!-- TOOLBAR TOP ROW: SEARCH -->
      <div class="toolbar-top-row">
        <!-- SEARCH BAR -->
        <div class="search-field-wrap">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="dirSearchInput" placeholder="Search calculators by name, keyword, or tax rule..." />
          <span class="search-count-badge" id="searchCountBadge">{calculators.length} Tools</span>
        </div>
      </div>

      <!-- LOCALIZATION ALERT BANNER -->
      <div id="localizationAlert" class="localization-alert-inline hidden">
        <span class="alert-icon">ℹ️</span>
        <span id="localizationAlertText">Showing results customized for Scotland. Devolved tools will open regional variants.</span>
      </div>

      <!-- CATEGORY TABS ROW -->
      <div class="category-tabs-scroll" id="categoryFiltersContainer">
        <button class="cat-tab-btn active" data-category="all">
          <span class="cat-name">All Categories</span>
          <span class="cat-count">{calculators.length}</span>
        </button>
        {categories.map((c) => {
          const count = calculators.filter(item => item.category === c.key).length;
          return (
            <button class="cat-tab-btn" data-category={c.key}>
              <span class="cat-icon">{c.icon}</span>
              <span class="cat-name">{c.title}</span>
              <span class="cat-count">{count}</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- DIRECTORY GRID INDEX LIST -->
    <div class="dir-content-sec" id="allCalculatorsSec">
      {categories.map((cat) => {
        const catCalcs = calculators.filter(c => c.category === cat.key);
        if (catCalcs.length === 0) return null;
        return (
          <div class="category-block" data-cat={cat.key}>
            <div class="category-header">
              <h2><span class="cat-head-icon">{cat.icon}</span> {cat.title}</h2>
              <span class="cat-head-count">{catCalcs.length} Calculators</span>
            </div>
            <div class="category-calcs-grid">
              {catCalcs.map((calc) => {
                const itemUrl = calc.isDevolved ? `/${calc.slug}/england/` : `/${calc.slug}/`;
                return (
                  <a href={itemUrl} class="dir-calc-card" data-devolved={calc.isDevolved ? "true" : "false"} data-slug={calc.slug} data-name={calc.name.toLowerCase()} data-desc={calc.desc.toLowerCase()}>
                    <div class="card-top">
                      <span class="calc-emoji">{calc.emoji}</span>
                      {calc.isDevolved && <span class="devolved-badge">Devolved</span>}
                    </div>
                    <div class="card-body">
                      <h3 class="calc-name">{calc.name}</h3>
                      <p class="calc-desc">{calc.desc}</p>
                    </div>
                    <div class="card-arrow">
                      <span>Open Calculator</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>

<script is:inline>
  const regionTabs = document.querySelectorAll('#directoryRegionTabs button');
  const categoryChips = document.querySelectorAll('#categoryFiltersContainer button');
  const dirCalcCards = document.querySelectorAll('.dir-calc-card');
  const catBlocks = document.querySelectorAll('.category-block');
  const searchInput = document.getElementById('dirSearchInput');
  const searchCountBadge = document.getElementById('searchCountBadge');
  const alertBanner = document.getElementById('localizationAlert');
  const alertText = document.getElementById('localizationAlertText');

  const countries = {
    england: { name: 'England', flagHtml: '<svg width="18" height="12" viewBox="0 0 36 36" style="border-radius:2px; vertical-align:middle; display:inline-block; margin-right:4px;"><path fill="#EEE" d="M32 5H4a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h28a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4z"/><path fill="#CE1124" d="M21 5h-6v10H0v6h15v10h6V21h15v-6H21z"/></svg>' },
    scotland: { name: 'Scotland', flagHtml: '<svg width="18" height="12" viewBox="0 0 36 36" style="border-radius:2px; vertical-align:middle; display:inline-block; margin-right:4px;"><path fill="#EEE" d="M32 5H4a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h28a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4z"/><path d="M13 18S0 8.586 0 8.895v18.21C0 27.414 13 18 13 18zm5 3S3.697 31 4.07 31h27.859C32.303 31 18 21 18 21zm5-3s13 9.414 13 9.105V8.895C36 8.586 23 18 23 18zm-5-3S3.697 5 4.07 5h27.859C32.303 5 18 15 18 15z" fill="#0065BD"/></svg>' },
    wales: { name: 'Wales', flagHtml: '<svg width="18" height="12" viewBox="0 0 36 36" style="border-radius:2px; vertical-align:middle; display:inline-block; margin-right:4px;"><path fill="#EEE" d="M36 27a4 4 0 0 1-4 4H4a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4h28a4 4 0 0 1 4 4v18z"/><path fill="#3E9A00" d="M0 27a4 4 0 0 0 4 4h28a4 4 0 0 0 4-4v-9H0v9z"/><path fill="#DD2E44" d="M31.719 12.812c.031-1.125.081-1.993.081-2.087c0-.094-.956 1.087-1.581 1.743a93.954 93.954 0 0 1-1.791 1.794c.713.165 1.572-.043 1.572-.043l-.406.875s-.531-.375-1.469-.375s-1.594.594-1.781 1.25c-.188.656.688 1.469 1.344 1.5c.656.031 1.375-.219 1.375-.219c-.938 1.438-2.906.438-3.906.375s-2.086-.005-2.086-.005c.875-1.125 2.242-.933 2.367-.933s-.822-1.436-.061-2.409c.659-.842 2.092-1.466 2.092-1.466s-1-.312-.938-.938s2.241-2.412 2.241-2.412s-5.212 2.494-5.443 1.6c-.282-1.09.329-2.055.329-2.055c-1.938.812-5.846 3.68-6.565 4.367c-.719.688-.562 1.812-.562 2.344c0 .531-.438.906-.844 1.125c-.406.219-1.687.345-1.687.345s-.223-.338-.067-.682c.156-.344.723-.1.723-.1c-.062-.625-.525-.821-.781-.844c-.153-.014-.168-.625.082-.657c.25-.031.949.375.949.375s.047-.736-.377-.869c-.283-.089-.65-.44-.494-.722c.156-.281 1.043.094 1.043.094c.102-.878-.91-.911-.91-1.161s.832-.124.832-.124c-.094-.658-.869-.807-.869-.807s-.034-.049-.159-.205c-.125-.156-.171-.793.11-.886c.281-.094.839-.526.839-.526l-.361-.032l.064-.949c-.156.188-.938.531-1.375.562s-.728.418-.728.418c-.438.094-2.053-.168-2.647-.012c-.594.156-.53.6-.53.6s-.72.025-1.595.15s-1.503.849-1.425.901c.118.078.865-.078 1.428-.109c.435-.024.811.255.833.432c-.013.155.037.156.069.211c.031.055.235.008.235.008l.173.165l.078-.235l.212.141l-.03-.276l.258.175l-.031-.298l.282.204l.023-.302c.969-.016 1.052.392 1.052.392c-1.469.406-4.75.25-4.75.25l.71-.332c-.875.031-2.585-.981-2.585-.981s.469 1.125.875 1.594c.406.469 1.281.844 1.281.844l-.25-.562s1.75.156 2.25.156c.073 0 .167-.002.271-.006c-.011.382.339.865.339.865c-.203.328.109.703.109.703s.094-.141.146-.312c.053-.172.239-.63.239-.63l.2