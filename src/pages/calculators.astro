    'northern-ireland': { name: 'Northern Ireland', flagHtml: '<svg width="18" height="12" viewBox="0 0 512 512" style="border-radius:2px; vertical-align:middle; display:inline-block; margin-right:4px;"><path fill="#41479B" d="M473.655 88.276H38.345C17.167 88.276 0 105.443 0 126.621V385.38c0 21.177 17.167 38.345 38.345 38.345h435.31c21.177 0 38.345-17.167 38.345-38.345V126.621C512 105.443 494.833 88.276 473.655 88.276z"/><path fill="#F5F5F5" d="M511.469 120.282c-3.022-18.159-18.797-32.007-37.814-32.007h-9.977l-163.54 107.147V88.276h-88.276v107.147L48.322 88.276h-9.977c-19.017 0-34.792 13.847-37.814 32.007l139.778 91.58H0v88.276h140.309L0.531 391.717c3.022 18.159 18.797 32.007 37.814 32.007h9.977l163.54-107.147v107.147h88.276V316.577l163.54 107.147h9.977c19.017 0 34.792-13.847 37.814-32.007l-139.778-91.58H512v-88.276H371.691L511.469 120.282z"/><polygon fill="#FF4B55" points="282.483,88.276 229.517,88.276 229.517,229.517 0,229.517 0,282.483 229.517,282.483 229.517,423.724 282.483,423.724 282.483,282.483 512,282.483 512,229.517 282.483,229.517"/></svg>' }
  };

  let activeNation = 'all';
  let activeCategory = 'all';

  function filterAndLocalize() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

    // 1. Highlight region tab button
    regionTabs.forEach(btn => {
      if (btn.getAttribute('data-nation') === activeNation) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // 2. Highlight category chip button
    categoryChips.forEach(btn => {
      if (btn.getAttribute('data-category') === activeCategory) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // 3. Alert Banner
    if (activeNation === 'all') {
      if (alertBanner) {
        alertBanner.classList.add('hidden');
        alertBanner.style.display = 'none';
      }
    } else {
      const info = countries[activeNation];
      if (info && alertText && alertBanner) {
        alertText.innerHTML = `Showing results customized for ${info.flagHtml} <strong>${info.name}</strong>. Devolved tools will open regional variants.`;
        alertBanner.classList.remove('hidden');
        alertBanner.style.display = 'block';
      }
    }

    // 4. Search, Category, and Region updates
    let totalVisible = 0;

    catBlocks.forEach(block => {
      const catKey = block.getAttribute('data-cat');
      const matchesCategory = activeCategory === 'all' || activeCategory === catKey;

      if (!matchesCategory) {
        block.style.display = 'none';
        return;
      }

      let visibleInBlock = 0;
      const cards = block.querySelectorAll('.dir-calc-card');

      cards.forEach(card => {
        const isDevolved = card.getAttribute('data-devolved') === 'true';
        const name = card.getAttribute('data-name');
        const desc = card.getAttribute('data-desc');
        const matchesQuery = !query || name.includes(query) || desc.includes(query);

        if (matchesQuery) {
          card.style.display = 'flex';
          visibleInBlock++;
          totalVisible++;
          
          // Rewrite href if devolved
          if (isDevolved) {
            const slug = card.getAttribute('data-slug');
            const targetNation = (activeNation === 'all') ? 'england' : activeNation;
            card.setAttribute('href', `/${slug}/${targetNation}/`);
          }
        } else {
          card.style.display = 'none';
        }
      });

      block.style.display = (visibleInBlock > 0) ? 'block' : 'none';
    });

    if (searchCountBadge) {
      searchCountBadge.textContent = `${totalVisible} Tools`;
    }

    const url = new URL(window.location);
    if (activeNation === 'all') {
      url.searchParams.delete('nation');
    } else {
      url.searchParams.set('nation', activeNation);
    }
    window.history.replaceState({}, '', url);
  }

  const params = new URLSearchParams(window.location.search);
  activeNation = params.get('nation') || 'all';
  filterAndLocalize();

  if (searchInput) {
    searchInput.addEventListener('input', filterAndLocalize);
  }

  regionTabs.forEach(btn => {
    btn.addEventListener('click', () => {
      activeNation = btn.getAttribute('data-nation') || 'all';
      filterAndLocalize();
    });
  });

  categoryChips.forEach(btn => {
    btn.addEventListener('click', () => {
      activeCategory = btn.getAttribute('data-category') || 'all';
      filterAndLocalize();
    });
  });
</script>

<style is:global>
